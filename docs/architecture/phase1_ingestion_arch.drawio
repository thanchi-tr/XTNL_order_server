          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HARD_HALTED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;all outbound actions denied&lt;/font&gt;" tooltip="Kill switch: ActionGate denies every outbound action until an operator resets it. clear() must release the HARD latch; it refuses while the latest sweep pass still shows an active HARD state, unless forced (with a reason) for a HARD state whose latest results are capped or UNKNOWN." id="sm-h_hard">
