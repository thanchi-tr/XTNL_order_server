        <mxCell id="sm-h6" value="[no SOFT state for cool_down] / system clear()" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.6818;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-h_soft" target="sm-h_run">
