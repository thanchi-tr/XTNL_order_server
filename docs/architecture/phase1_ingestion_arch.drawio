          </mxGeometry>
        </mxCell>
        <mxCell id="sm-i_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Non-blocking asyncio task every INTEGRITY_CHECK_INTERVAL_SEC (5.0 s). Step 1 looks only at rows committed in [last check &amp;minus; MAX_TXN_MS, now &amp;minus; 500 ms] plus a rotating sweep, so it stays cheap and a commit still being copied is not a false mismatch; the full XOR digest is compared only when writes are quiet. A missing or foreign redis:boot_id hands over to SM8. Redis is a disposable duplicate: on mismatch the drifted keys are healed in place with the same version compare-and-set script the live writers use, so neither side can overwrite newer state and nothing is paused (a pause would fill the bounded queues and flood the DLQ). Heals also append to oversee:feed, waking the RiskSweep. Step 2 (real DB corruption) halts ingestion and pages. The engine never restores PostgreSQL itself: primary-only damage is handled by a Patroni switchover to the checked sync standby; damage on both members needs an operator-run Tier 3 restore through Patroni. Either way RECONCILING then re-reads the broker, flushes Redis and waits for SM8 READY. The seq_id check is timeline- and epoch-aware." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S3">
          <mxGeometry x="20" y="640" width="1060" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sm-S4" value="SM4 &amp;middot; Broker adapter stream connection" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#FFE6CC;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="1180" y="800" width="1080" height="780" as="geometry" />
        </mxCell>
        <mxCell id="sm-a_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S4">
          <mxGeometry x="20" y="153" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sm-a_disc" value="&lt;b&gt;DISCONNECTED&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S4">
          <mxGeometry x="70" y="135" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm-a_auth" value="&lt;b&gt;AUTHENTICATING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / skip if known bad; StoneX&lt;br&gt;LogOn v2 or cTrader app + account auth&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S4">
          <mxGeometry x="370" y="130" width="210" height="70" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;SNAPSHOTTING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / fetch_instruments() &amp;rarr; adapter map;&lt;br&gt;fetch_open_orders(), fetch_positions(),&lt;br&gt;fetch_account_snapshot(), fetch_cash_flows();&lt;br&gt;subscribe each stream not SUBSCRIBED&lt;/font&gt;" tooltip="REST snapshot back-fills anything missed while disconnected, including the account image. Locally open orders and positions missing from the lists are re-read by id (all of them in a process's first snapshot, which has no stream watermark yet)." id="sm-a_snap">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S4">
            <mxGeometry x="710" y="125" width="230" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-a_str" value="&lt;b&gt;STREAMING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;do / always drain the socket;&lt;br&gt;ticks, orders, positions, account&lt;br&gt;heartbeat per adapter; no inbound 30 s&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S4">
          <mxGeometry x="710" y="340" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sm-a_bo" value="&lt;b&gt;BACKOFF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / sleep min(60, 2&lt;sup&gt;n&lt;/sup&gt; + U(0, 0.5)) s&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S4">
