        <UserObject label="[HARD_HALT] or&lt;br&gt;escalate_after&lt;br&gt;/ trip(HARD)" tooltip="The RiskSweep trips HARD when a SOFT state's accumulated uncapped time (uncapped_ms) reaches escalate_after_ms; capped spells and FLAG lowerings pause the clock, never reset it. Capped states never escalate." id="sm-h3">
          <mxCell style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#CC0000;fontColor=#CC0000;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-h_soft" target="sm-h_hard">
