        <UserObject label="LEADER_INIT fails, passes 120 s or finds SAFE_HOLD due / hard exit" tooltip="Finding SAFE_HOLD due in step 1 sets it in the epoch-bump transaction before the exit; on restart STANDBY sees it and enters SAFE_HOLD." id="sm-s13">
          <mxCell style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#CC0000;fontColor=#CC0000;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.6667;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2333;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-s_init" target="sm-s_fence">
            <mxGeometry x="0.4" relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1135" y="2910" />
                <mxPoint x="1135" y="3185" />
                <mxPoint x="165" y="3185" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="sm-s12" value="systemd restart&lt;br&gt;(back-off if own&lt;br&gt;term ended)" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-s_fence" target="sm-s_start">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-s_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;One engine LEADER at a time. Its epoch = (etcd cluster_id, lease revision), committed to PostgreSQL engine_epoch before anything else; every engine write checks it in the same statement, so a stale leader's writes fail. The lease keeper runs off the event loop: watchdog 3 s &amp;lt; fence 12 s &amp;lt; lease TTL 15 s, and the fence is a hard kill, so sockets are reset rather than flushed. A node campaigns only while it passes the hard checks (PostgreSQL writable, etcd reachable, Redis writable, chrony within 50 ms); broker reach and a tight clock offset are preferences, and once the lease has been free for 15 s any node passing the hard checks campaigns. The leader judges brokers by its own SM4 state; it abdicates only to an eligible peer (hard checks, no back-off, no SAFE_HOLD; preferences ignored), after a hard check has failed for 30 s or its own network path to an OPEN broker has failed while the peer's works. AUTH_FAILED is recorded per adapter and credential generation in PostgreSQL and is never a health input. &lt;b&gt;[flapping]&lt;/b&gt; = 3 abnormal term ends (lost, init_failed) in 15 min, or more than 6 epoch changes in 30 min, from the leader_terms rows each epoch bump writes; SAFE_HOLD is a durable cluster_state row: no node campaigns until an operator resumes." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S9">
          <mxGeometry x="20" y="480" width="1060" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sm-S10" value="SM10 &amp;middot; Market session per (adapter, symbol) (calendar)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#FFE6CC;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="1180" y="2730" width="1080" height="600" as="geometry" />
        </mxCell>
        <mxCell id="sm-m_ini" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S10">
          <mxGeometry x="20" y="60" width="24" height="24" as="geometry" />
        </mxCell>
        <UserObject label="" tooltip="Computed at LEADER_INIT from the versioned schedule (plus any maintenance overlay), so a mid-week takeover starts in the scheduled state, never blindly in CLOSED." id="sm-m_choice">
          <mxCell style="rhombus;html=1;fillColor=#FFFFFF;strokeColor=#1A1A1A;" vertex="1" parent="sm-S10">
            <mxGeometry x="100" y="57" width="30" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;CLOSED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;weekend / holiday&lt;/font&gt;" tooltip="Only price staleness is muted here. Only symbol-specific evidence (a post-close tick with a new price, or an execution on the symbol) overrides the calendar, into OPEN_BY_EVIDENCE." id="sm-m_closed">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S10">
            <mxGeometry x="70" y="130" width="180" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-m_pre" value="&lt;b&gt;PRE_OPEN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;readiness check&lt;br&gt;(open &amp;minus; 10 min)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S10">
          <mxGeometry x="330" y="125" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sm-m_open" value="&lt;b&gt;OPEN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;normal rules&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S10">
          <mxGeometry x="600" y="130" width="260" height="60" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;ROLLOVER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;daily break; price&lt;br&gt;staleness muted&lt;/font&gt;" tooltip="At the 17:00 New York roll the RiskSweep's first pass writes each account's new sod_marks row from the pre-roll last_clean_marks forced at this transition." id="sm-m_roll">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S10">
            <mxGeometry x="700" y="330" width="200" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;BROKER_MAINTENANCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;expected adapter outage&lt;/font&gt;" tooltip="A per-adapter overlay, entered from any session state (drawn once from OPEN): an expected adapter outage with normal backoff, one pre-acknowledged notice and liveness alerts suppressed. When the window ends each symbol returns to its scheduled state, through PRE_OPEN if an open passed, and FENCE is at full severity again." id="sm-m_maint">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S10">
            <mxGeometry x="330" y="330" width="190" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;OPEN_BY_EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;FLAG calendar_mismatch&lt;/font&gt;" tooltip="Opened by symbol-specific evidence against the calendar (FLAG calendar_mismatch). Returns to CLOSED after 30 min without evidence; the scheduled PRE_OPEN runs from here too." id="sm-m_evid">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S10">
            <mxGeometry x="70" y="330" width="180" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-m1" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_ini" target="sm-m_choice">
