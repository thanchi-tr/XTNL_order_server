        <mxCell id="pat-F14" value="P13 &amp;middot; Health-gated election + anti-flap brake" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#E6F2F8;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;dashed=1;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="pat-1">
          <mxGeometry x="800" y="3330" width="720" height="520" as="geometry" />
        </mxCell>
        <mxCell id="pat-hr" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;published under the node's lease&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;HealthRecord&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;&lt;b&gt;hard:&lt;/b&gt; pg_writable, etcd_ok,&lt;br&gt;&amp;nbsp;&amp;nbsp;redis_writable, chrony &amp;le; 50 ms&lt;br&gt;&lt;b&gt;prefer:&lt;/b&gt; broker_tls_ok (open markets),&lt;br&gt;&amp;nbsp;&amp;nbsp;chrony &amp;lt; 1 ms, hosts PG primary&lt;br&gt;&lt;b&gt;leader:&lt;/b&gt; RiskSweep circuit &amp;lt; 5 min&lt;br&gt;&lt;b&gt;also:&lt;/b&gt; spill size; stale after 5 s" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F14">
          <mxGeometry x="20" y="46" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat-cp" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;SM9&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Campaigner&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;+ eligible(): hard checks, no back-off,&lt;br&gt;&amp;nbsp;&amp;nbsp;no SAFE_HOLD (ignores preferences)&lt;br&gt;+ may_campaign(): eligible, lease free,&lt;br&gt;&amp;nbsp;&amp;nbsp;and (prefers or free &amp;ge; 15 s)&lt;br&gt;+ abdicate(): to an eligible peer;&lt;br&gt;&amp;nbsp;&amp;nbsp;hard check failing 30 s, or own net&lt;br&gt;&amp;nbsp;&amp;nbsp;path to an OPEN broker down 20 s" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F14">
          <mxGeometry x="400" y="46" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat-lt" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;audit&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;leader_terms&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;epoch, node, started_at, reached_leader_at,&lt;br&gt;ended_at, end_reason: switchover |&lt;br&gt;&amp;nbsp;&amp;nbsp;abdicate | lost | init_failed&lt;br&gt;written at epoch bump, LEADER, DRAINING" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F14">
          <mxGeometry x="20" y="266" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pat-sh" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Circuit Breaker&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;SafeHold&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;3 abnormal ends / 15 min, or&lt;br&gt;&amp;gt; 6 epoch changes / 30 min&lt;br&gt;durable row in cluster_state&lt;hr size='1'&gt;+ resume(operator)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F14">
          <mxGeometry x="400" y="266" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pat-n13" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Winning an etcd election only proves the node can reach etcd. The &lt;b&gt;health gate&lt;/b&gt; keeps a node that fails a hard check (PostgreSQL, etcd, Redis, clock) from becoming leader; broker reach is only a preference, judged for the leader by its own SM4 state, and the &lt;b&gt;anti-flap brake&lt;/b&gt; turns a crash loop into one page instead of a stream of failovers." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="pat-F14">
          <mxGeometry x="20" y="426" width="680" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pat-f14a" value="reads" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;dashed=1;endArrow=open;endFill=0;" edge="1" parent="pat-1" source="pat-cp" target="pat-hr">
