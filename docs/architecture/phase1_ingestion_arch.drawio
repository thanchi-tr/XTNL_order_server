          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S6">
