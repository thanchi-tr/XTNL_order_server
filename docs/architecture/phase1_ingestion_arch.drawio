          </mxGeometry>
        </mxCell>
        <mxCell id="sm-p5" value="absent from a snapshot / re-read by id" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.2308;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7692;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-p_open" target="sm-p_open">
