        <mxCell id="pat-tr" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2B5797;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;INTERFACE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Transport&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;+ request(method, path, body)  &lt;i&gt;(REST)&lt;/i&gt;&lt;br&gt;+ send(payload_type, msg)  &lt;i&gt;(ProtoOA)&lt;/i&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F2">
          <mxGeometry x="200" y="46" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pat-rot" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Protection Proxy&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ReadOnlyTransport&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;- inner: Transport&lt;br&gt;- deny_paths = {/newtradeorder, /newstoplimitorder,&lt;br&gt;&amp;nbsp;&amp;nbsp;/updatetradeorder, /updatestoplimitorder, /cancel}&lt;br&gt;- allow_payload_types (ProtoOA): the&lt;br&gt;&amp;nbsp;&amp;nbsp;canonical list, adapter-isolation.md &amp;sect;4&lt;hr size='1'&gt;+ request() / send(): raise ExecutionLockedError&lt;br&gt;&amp;nbsp;&amp;nbsp;if path in deny_paths, payloadType not&lt;br&gt;&amp;nbsp;&amp;nbsp;allowed, or BROKER_ENV not in&lt;br&gt;&amp;nbsp;&amp;nbsp;{sandbox, live_readonly}" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F2">
          <mxGeometry x="20" y="206" width="340" height="180" as="geometry" />
        </mxCell>
        <mxCell id="pat-http" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Real Subject&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;HttpTransport&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;- httpx / Lightstreamer client&lt;hr size='1'&gt;+ request(method, path, body)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F2">
          <mxGeometry x="440" y="206" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pat-hook" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B71C1C;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;SECURITY GUARD&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Guard (tooling)&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PreToolUse hook&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;.claude/hooks/pre_tool_guard.py&lt;br&gt;denies agent tool calls to&lt;br&gt;place_order / modify_order / cancel_order" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F2">
          <mxGeometry x="20" y="426" width="340" height="100" as="geometry" />
