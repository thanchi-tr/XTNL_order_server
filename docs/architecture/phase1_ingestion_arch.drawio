        </mxCell>
        <UserObject label="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Spooler&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DlqSpooler&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;- ring: deque(maxlen=N)&lt;hr size='1'&gt;+ offer(event, reason)  &lt;i&gt;append only, no I/O&lt;/i&gt;&lt;br&gt;- flush(): batch INSERT&lt;br&gt;- spill(): asyncio.to_thread(write + fsync),&lt;br&gt;&amp;nbsp;&amp;nbsp;framed records (length + CRC)" tooltip="The orchestrator only appends to the ring; the spooler's own task does the database write, and disk writes run in a worker thread." id="pat-spool">
          <mxCell style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;align=left;spacingTop=2;" vertex="1" parent="pat-F5">
            <mxGeometry x="20" y="46" width="330" height="140" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="pat-spill" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;local file&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;var/dlq_spill.jsonl&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;used only when PostgreSQL is down&lt;br&gt;written off the event loop&lt;br&gt;drained into events_dlq when PostgreSQL&lt;br&gt;&amp;nbsp;&amp;nbsp;accepts writes, and at start-up,&lt;br&gt;&amp;nbsp;&amp;nbsp;by any node (idempotent insert)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F5">
          <mxGeometry x="400" y="46" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pat-f5s" value="DB down" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=open;endFill=0;" edge="1" parent="pat-1" source="pat-spool" target="pat-spill">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pat-dlc" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Dead Letter Channel&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;events_dlq&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;dlq_id, &lt;b&gt;event_type: ORDER | POSITION | ACCOUNT | CASH_FLOW&lt;/b&gt;&lt;br&gt;client_order_id | position_id | account_id |&lt;br&gt;&amp;nbsp;&amp;nbsp;transaction_id, adapter_id&lt;br&gt;raw_payload, error_reason&lt;br&gt;retry_count, status, next_retry_at_ms&lt;hr size='1'&gt;park(event, reason) &amp;middot; due(now)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F5">
          <mxGeometry x="20" y="246" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat-rw" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Idempotent Retry&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DlqRecoveryWorker&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;+ run()&lt;br&gt;- check_before_retry(row):&lt;br&gt;&amp;nbsp;&amp;nbsp;ORDER: fetch_order_status()&lt;br&gt;&amp;nbsp;&amp;nbsp;POSITION: fetch_position_status()&lt;br&gt;&amp;nbsp;&amp;nbsp;ACCOUNT: fetch_account_snapshot()&lt;br&gt;&amp;nbsp;&amp;nbsp;CASH_FLOW: fetch_cash_flows()&lt;br&gt;&amp;nbsp;&amp;nbsp;then re-submit via orchestrator" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;align=left;spacingTop=2;" vertex="1" parent="pat-F5">
          <mxGeometry x="400" y="246" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat-rtp" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Retry&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;RetryPolicy&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;MAX_DLQ_RETRIES = 5&lt;br&gt;backoff min(60, 2&lt;sup&gt;n&lt;/sup&gt; + U(0, 0.5)) s" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F5">
          <mxGeometry x="20" y="466" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pat-qs" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Poison Message&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;events_quarantine&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;manual review" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F5">
          <mxGeometry x="400" y="466" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pat-n5" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Dead Letter Channel&lt;/b&gt;: failed order, position and account events are parked, never lost. &lt;b&gt;Spooler&lt;/b&gt;: parking is an in-memory append, so the publisher never waits on PostgreSQL. &lt;b&gt;Check-before-retry&lt;/b&gt; (Idempotent Receiver): the broker is asked for the real state (order status, or a position by id, account snapshot or cash flow by transaction_id; that fresh row replaces the parked one) before re-submitting, so a retry can't duplicate or reorder state." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="pat-F5">
          <mxGeometry x="20" y="596" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pat-f5t" value="batch INSERT" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=open;endFill=0;" edge="1" parent="pat-1" source="pat-spool" target="pat-dlc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pat-f5a" value="polls" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=open;endFill=0;" edge="1" parent="pat-1" source="pat-rw" target="pat-dlc">
