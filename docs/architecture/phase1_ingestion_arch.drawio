        <mxCell id="pat-F15" value="P14 &amp;middot; Market calendar (session schedule)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#E6F2F8;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;dashed=1;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="pat-1">
