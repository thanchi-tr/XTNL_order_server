        <mxCell id="pat-rp" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Retry &amp;middot; Heartbeat&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ReconnectPolicy&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;- base 1 s &amp;middot; cap 60 s &amp;middot; jitter U(0, 0.5)&lt;br&gt;- heartbeat per adapter: cTrader 10 s,&lt;br&gt;&amp;nbsp;&amp;nbsp;StoneX Lightstreamer keepalive;&lt;br&gt;&amp;nbsp;&amp;nbsp;no inbound 30 s &amp;rarr; drop&lt;hr size='1'&gt;+ next_delay(n) = min(60, 2&lt;sup&gt;n&lt;/sup&gt; + jitter)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F1">
          <mxGeometry x="20" y="486" width="360" height="140" as="geometry" />
        </mxCell>
        <mxCell id="pat-n1" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Adapter&lt;/b&gt; translates one broker protocol into BrokerAdapter. &lt;b&gt;Strategy&lt;/b&gt;: callers depend only on BrokerAdapter. &lt;b&gt;Factory&lt;/b&gt;: a new broker is one registered class." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="pat-F1">
