        <mxCell id="pat-pdto" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;frozen dataclass&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PriceDTO&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;adapter_id, symbol: str&lt;br&gt;bid, ask, spread_pips: Decimal&lt;br&gt;timestamp_ms, seq_id: int" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
