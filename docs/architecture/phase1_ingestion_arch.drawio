            <mxGeometry x="380" y="46" width="320" height="200" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="pat-ostat" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#6E6E00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ENUM&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;OrderStatus&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;PENDING &amp;middot; WORKING &amp;middot; PARTIALLY_FILLED&lt;br&gt;FILLED &amp;middot; CANCELLED &amp;middot; REJECTED" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F4F4C8;strokeColor=#A6A62B;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
