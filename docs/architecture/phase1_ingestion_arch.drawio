        </mxCell>
        <mxCell id="pat-ms" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;State (SM10)&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MarketSession&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;key (adapter_id, symbol)&lt;br&gt;CLOSED &amp;middot; PRE_OPEN &amp;middot; OPEN&lt;br&gt;OPEN_BY_EVIDENCE &amp;middot; ROLLOVER&lt;br&gt;BROKER_MAINTENANCE (per adapter)&lt;hr size='1'&gt;+ on_evidence(tick | execution):&lt;br&gt;&amp;nbsp;&amp;nbsp;CLOSED &amp;rarr; OPEN_BY_EVIDENCE" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F15">
          <mxGeometry x="400" y="46" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pat-rc" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;PRE_OPEN&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ReadinessCheck&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;+ run(): reconnect, account + cash flows,&lt;br&gt;&amp;nbsp;&amp;nbsp;tokens &amp;gt; 24 h, chrony, all STREAMING" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;align=left;spacingTop=2;" vertex="1" parent="pat-F15">
