        <mxCell id="pat-mapper" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Message Translator&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;StatusMapper&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;NEW / ACCEPTED &amp;rarr; WORKING&lt;br&gt;PARTIALLY_FILLED &amp;rarr; PARTIALLY_FILLED&lt;br&gt;FILLED / EXECUTED &amp;rarr; FILLED&lt;br&gt;CANCELLED / EXPIRED &amp;rarr; CANCELLED&lt;br&gt;REJECTED &amp;rarr; REJECTED&lt;hr size='1'&gt;+ to_order_status(raw): OrderStatus" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
