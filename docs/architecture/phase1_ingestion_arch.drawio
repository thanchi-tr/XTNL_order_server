        <mxCell id="pat-orch" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Publisher&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;IngestionOrchestrator&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;+ run()&lt;br&gt;- stamp(dto): seq_id = HLC&lt;br&gt;- publish(dto): put_nowait&lt;br&gt;- QueueFull &amp;rarr; spool.offer()" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;align=left;spacingTop=2;" vertex="1" parent="pat-F4">
