          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-m4" value="[daily&lt;br&gt;break]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5385;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_open" target="sm-m_roll">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-m5" value="[ends] /&lt;br&gt;readiness" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.6000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8462;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_roll" target="sm-m_open">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-m6" value="[weekly close or holiday]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.3846;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_open" target="sm-m_closed">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1880" y="2825" />
              <mxPoint x="1340" y="2825" />
            </Array>
          </mxGeometry>
        </mxCell>
        <UserObject label="[evidence]" tooltip="A post-close tick on that symbol with a new price, or an execution on it." id="sm-m9">
          <mxCell style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.1667;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1667;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_closed" target="sm-m_evid">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-m10" value="[30 min quiet]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.6389;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6389;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_evid" target="sm-m_closed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-m11" value="[open &amp;minus; 10 min]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.2500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.7857;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_evid" target="sm-m_pre">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1470" y="3075" />
              <mxPoint x="1470" y="2910" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm-m7" value="[maintenance window]&lt;br&gt;(from any state)" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.1923;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_open" target="sm-m_maint">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1830" y="3090" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm-m8" value="[window ends] / scheduled state&lt;br&gt;(PRE_OPEN if an open passed)" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.7895;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0385;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-m_maint" target="sm-m_open">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1660" y="2980" />
              <mxPoint x="1790" y="2980" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm-m_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Per &lt;b&gt;(adapter, symbol)&lt;/b&gt;, from broker schedules (cTrader symbol schedule and holidays; StoneX market information or a reviewed config), versioned in PostgreSQL; BROKER_MAINTENANCE is per adapter, and an adapter's market is OPEN when any of its symbols is. &lt;b&gt;Evidence beats the calendar&lt;/b&gt; only when it is symbol-specific (all guards are level conditions, so a takeover just before an open still runs PRE_OPEN): a tick after the scheduled close with a price that differs from the last pre-close quote, or an execution on that symbol (snapshots and account or cash-flow events don't count). It leads to OPEN_BY_EVIDENCE, which returns to CLOSED after 30 min without evidence; a scheduled-OPEN symbol with no ticks pages for stale prices instead. While CLOSED or in ROLLOVER only &lt;b&gt;price&lt;/b&gt; staleness is muted. &lt;b&gt;PRE_OPEN&lt;/b&gt;: reset backoff and reconnect, fresh account snapshot + fetch_cash_flows, tokens valid &amp;gt; 24 h, chrony synced; page if any adapter is not STREAMING. At the open, STREAMING adapters run RESYNCING with jitter (open + 30&amp;ndash;60 s); others go through SNAPSHOTTING. Phase 2: no risk-increasing action until the account is reconciled after the latest open." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S10">
          <mxGeometry x="20" y="430" width="1040" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sm-legend" value="Legend &amp;mdash; state categories" style="swimlane;startSize=26;html=1;fontSize=12;fontStyle=1;collapsible=0;fillColor=#F5F5F5;strokeColor=#999999;swimlaneFillColor=#FFFFFF;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="40" y="3370" width="2220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_normal" value="&lt;b&gt;normal / waiting&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="20" y="36" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_transient" value="&lt;b&gt;transient / working&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="250" y="36" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_success" value="&lt;b&gt;success / healthy&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="480" y="36" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_failure" value="&lt;b&gt;failure / blocked&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="710" y="36" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_terminal" value="&lt;b&gt;neutral terminal&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="940" y="36" width="200" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="1170" y="41" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_init_t" value="initial" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="sm-legend">
          <mxGeometry x="1200" y="41" width="60" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-legend">
          <mxGeometry x="1270" y="41" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sm-lg_fin_t" value="final" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;" vertex="1" parent="sm-legend">
          <mxGeometry x="1300" y="41" width="60" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uc" name="4 · Use Cases">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="2319" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="uc-0" />
        <mxCell id="uc-1" parent="uc-0" />
        <mxCell id="uc-title" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;Use Case Diagram&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#555555'&gt;Who interacts with the Phase 1 engine. Colour = use-case role (legend at bottom). Hover a use case for trigger, flow and outcome.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="uc-1">
          <mxGeometry x="40" y="16" width="2220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="uc-sys" value="XTNL Phase 1 &amp;mdash; Read-Only Ingestion Engine + Oversee (system boundary)" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;collapsible=0;rounded=0;fillColor=#E6F2F8;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="uc-1">
          <mxGeometry x="360" y="90" width="1500" height="1949" as="geometry" />
        </mxCell>
        <mxCell id="uc-b1" value="Ingestion" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=3;fontColor=#0B6E99;" vertex="1" parent="uc-sys">
          <mxGeometry x="1210" y="45" width="270" height="20" as="geometry" />
        </mxCell>
        <UserObject label="Authenticate broker session" tooltip="StoneX LogOn v2 / cTrader ProtoOA application + account auth (OAuth token pair, refreshed only by the leader)." id="uc-u_auth">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="75" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Normalize payload to canonical DTO" tooltip="Order / Position / Price / Account DTOs with checksum; the orchestrator labels the version and stamps seq_id." id="uc-u_norm">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="75" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Publish to isolated topic (non-blocking)" tooltip="put_nowait() into one of four topics." id="uc-u_pub">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="1040" y="75" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Ingest broker data&lt;/b&gt;" tooltip="Abstract parent of the five ingestion use cases." id="uc-u_ing">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;fontStyle=2;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="195" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Ingest price ticks" tooltip="Streams -&gt; PriceDTO -&gt; Redis price:{adapter_id}:{symbol}." id="uc-u_price">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="315" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Ingest order updates" tooltip="Streams -&gt; OrderDTO -&gt; PostgreSQL then Redis. A stale (lower-version) update is dropped and logged." id="uc-u_ord">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="315" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Snapshot orders, positions &amp;amp; instruments" tooltip="REST snapshot at start-up and after reconnect, incl. InstrumentSpec to convert broker quantities to canonical units, and the FX crosses to subscribe." id="uc-u_snap">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="1040" y="315" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Route failed event to DLQ" tooltip="Order, position or account event: nack / timeout / invalid / QueueFull / future_timestamp." id="uc-u_dlq">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="435" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Ingest open positions (stop, take-profit, units)" tooltip="cTrader execution events; StoneX: the first ORDERS item with filled units &gt; 0 (and later items for that OrderId) -&gt; PositionDTO -&gt; positions_state then Redis." id="uc-u_pos">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="435" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Track account image (balance, equity, margin)" tooltip="ClientAccountMargin stream + REST -&gt; AccountDTO -&gt; account_state (history: account_snapshots) then Redis account:{id}; deposits and withdrawals as CashFlowDTO -&gt; cash_flows." id="uc-u_acct">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="1040" y="435" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="uc-b2" value="Recovery &amp;amp; Integrity" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=3;fontColor=#0B6E99;" vertex="1" parent="uc-sys">
          <mxGeometry x="1210" y="545" width="270" height="20" as="geometry" />
        </mxCell>
        <UserObject label="Recover DLQ event (check-before-retry)" tooltip="SM2 on page 3. Only for adapters already STREAMING (start-up barrier)." id="uc-u_rec">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="575" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Query broker order / position / account" tooltip="ORDER: fetch_order_status(). POSITION: fetch_position_status(). ACCOUNT: fetch_account_snapshot(). CASH_FLOW: fetch_cash_flows()." id="uc-u_qry">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="575" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Quarantine poison event" tooltip="After 5 failed retries." id="uc-u_quar">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="685" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Verify tiers (Redis &amp;gt; DB &amp;gt; Image)" tooltip="SM3 on page 3." id="uc-u_ver">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="795" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Heal or rebuild Redis from DB" tooltip="Step 1 mismatch: version compare-and-set via apply_state.lua; ingestion keeps running (no symbol pause). Redis data lost: SM8 bootstrap rebuilds it while ActionGate fails closed." id="uc-u_hyd">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="745" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Switch over or operator restore" tooltip="Step 2 corruption: Patroni switchover to the checked standby, or an operator-run Tier 3 restore." id="uc-u_rest">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="845" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Reconcile with broker" tooltip="After a switchover or restore: fetch_open_orders(), fetch_positions(), fetch_account_snapshot(), fetch_cash_flows() since the last committed broker_ts (or the restore target); anything open locally but absent is re-read by id." id="uc-u_recon">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="1040" y="845" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="uc-b3" value="Oversight &amp;amp; Alerts (Oversee)" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=3;fontColor=#0B6E99;" vertex="1" parent="uc-sys">
          <mxGeometry x="1210" y="955" width="270" height="20" as="geometry" />
        </mxCell>
        <UserObject label="Read snapshot + prices" tooltip="The RiskSweep reads entity state from one PostgreSQL REPEATABLE READ snapshot per account (current rows, sod_marks, cash_flows) and prices / live fields from Redis with their timestamps." id="uc-u_img">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="985" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Evaluate risk rules (RiskSweep)&lt;/b&gt;" tooltip="Every second, and at once when a committed OrderDTO / PositionDTO / AccountDTO or cash flow wakes it through oversee:feed, the RiskSweep evaluates every rule on every account and live entity. Deadlines (stop grace, confirm, escalation, cool-down) are durable timestamps. Orders and open positions are both checked; risk is directional and converted to the account currency. The most severe level wins." id="uc-u_eval">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1145" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Flag violation (log)" tooltip="Rule state FLAG, e.g. risk between 1.0 % (1R) and 1.5 % of equity, or a stale account image: halt_breaches + oversee_events row + one alert per episode." id="uc-u_flag">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="1065" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Soft-halt risk-increasing actions" tooltip="Rule state SOFT_HALT, e.g. risk &gt; 1.5 % of equity, no stop-loss after the grace window, or a capped SOFT from stale or unknown inputs; escalates to HARD after T of uncapped time." id="uc-u_soft">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="1145" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Hard-halt all actions (kill switch)" tooltip="Rule state HARD_HALT or escalation: sets the HARD latch; only an operator clear() releases it, refused while the condition is still HARD." id="uc-u_hard">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="1225" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Notify via email / mobile push" tooltip="NotificationDispatcher; SM6 on page 3." id="uc-u_notify">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="1040" y="1145" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Configure rule plugins &amp;amp; thresholds" tooltip="Enable rules; set the FLAG / halt bands (1.0 % / 1.5 %), grace_ms and on_breach." id="uc-u_cfg">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1255" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Acknowledge / clear halt" tooltip="acknowledge(operator, why, breach_id) silences re-pages of a state; clear(operator, why, reviewed_event_id, force?) releases the HARD latch and is refused while the latest sweep pass still shows an active HARD state, unless forced with a reason for a HARD state whose results are capped or UNKNOWN (it is then resolved); all logged." id="uc-u_ack">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1335" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="uc-b4" value="Observation &amp;amp; Assurance" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=3;fontColor=#0B6E99;" vertex="1" parent="uc-sys">
          <mxGeometry x="1210" y="1435" width="270" height="20" as="geometry" />
        </mxCell>
        <UserObject label="Monitor orders, positions &amp;amp; account" tooltip="Read-only views: entity data from PostgreSQL; live Redis values only when their epoch matches the leader heartbeat, else marked stale." id="uc-u_mon">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1465" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Review quarantined events &amp;amp; flags" tooltip="events_quarantine + oversee_events." id="uc-u_rev">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1545" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Audit event log, halts (114-trade baseline)" tooltip="Append-only history + halt_events." id="uc-u_aud">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1625" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Run deterministic replay &amp;amp; rule tests" tooltip="verify_execution.py + pytest with the mock broker." id="uc-u_rep">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="1585" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="uc-b5" value="Operations (24/7)" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;fontStyle=3;fontColor=#0B6E99;" vertex="1" parent="uc-sys">
          <mxGeometry x="1210" y="1725" width="270" height="20" as="geometry" />
        </mxCell>
        <UserObject label="Planned switchover / rolling upgrade" tooltip="Upgrade the standby, switch over to it (named target), upgrade the old leader. Migrations run first, by an operator." id="uc-u_sw">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1755" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Release SAFE_HOLD after flapping" tooltip="After 3 abnormal term ends in 15 min no node campaigns; an operator investigates and resumes." id="uc-u_safe">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="120" y="1855" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Fail over to the standby node" tooltip="Lease expires or the leader abdicates; the standby wins, bumps the epoch and runs LEADER_INIT (SM9)." id="uc-u_fo">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="1040" y="1755" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Fence the old leader" tooltip="Lease keeper hard-kills a leader that can't renew; every PostgreSQL write checks the epoch." id="uc-u_fence">
          <mxCell style="ellipse;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="uc-sys">
            <mxGeometry x="580" y="1805" width="300" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Market-open readiness check" tooltip="PRE_OPEN (SM10): reconnect, fresh account and cash flows, tokens, chrony; page if any adapter isn't STREAMING." id="uc-u_rdy">
