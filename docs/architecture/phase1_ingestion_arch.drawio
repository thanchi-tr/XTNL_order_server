  <diagram id="dep" name="5 · Deployment">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1550" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="dep-0" />
        <mxCell id="dep-1" parent="dep-0" />
        <mxCell id="dep-title" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;Deployment &amp;mdash; 24/7, single writer, two zones&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#555555'&gt;Two engine nodes in London (one LEADER, one hot STANDBY) plus a witness, so a node or zone can fail without a split brain; disaster image, dashboard, dead-man's switch and on-call in Melbourne. Broker server locations and round-trip times are estimates: confirm with each broker and measure before go-live. Tag colour = element kind (legend at bottom).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="dep-1">
          <mxGeometry x="40" y="16" width="2220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dep-EXT" value="External services" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=0;fillColor=#F2F2F2;strokeColor=#7A7A7A;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="dep-1">
          <mxGeometry x="40" y="130" width="250" height="740.0" as="geometry" />
        </mxCell>
        <UserObject label="London &amp;mdash; AWS eu-west-2 (live engine, two zones + witness)" tooltip="Everything on the hot path lives here, a few milliseconds from the brokers' FX servers." id="dep-LON">
          <mxCell style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;collapsible=0;rounded=0;fillColor=#DAE8FC;strokeColor=#2B5797;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="dep-1">
            <mxGeometry x="320" y="130" width="1400" height="740.0" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="dep-MEL" value="Melbourne &amp;mdash; disaster copy, oversight, people" style="swimlane;startSize=30;html=1;fontSize=14;fontStyle=1;collapsible=0;rounded=0;fillColor=#D5E8D4;strokeColor=#2E7D32;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="dep-1">
          <mxGeometry x="1760" y="130" width="500" height="740.0" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;AZ eu-west-2a&lt;/b&gt; &amp;middot; node A (c7i.2xlarge-class)" tooltip="Each engine node: 8 vCPUs = 4 physical cores, 16 GB ECC, EBS volumes, Ubuntu 24.04 LTS; socket readers pinned to a whole physical core. The witness is a small non-burstable instance that only runs etcd." id="dep-azA">
          <mxCell style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#2B5797;dashed=1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#2B5797;" vertex="1" parent="dep-LON">
            <mxGeometry x="10" y="190" width="450" height="460" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AZ eu-west-2b&lt;/b&gt; &amp;middot; node B (same spec)" tooltip="Each engine node: 8 vCPUs = 4 physical cores, 16 GB ECC, EBS volumes, Ubuntu 24.04 LTS; socket readers pinned to a whole physical core. The witness is a small non-burstable instance that only runs etcd." id="dep-azB">
          <mxCell style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#2B5797;dashed=1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#2B5797;" vertex="1" parent="dep-LON">
            <mxGeometry x="470" y="190" width="450" height="460" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AZ eu-west-2c&lt;/b&gt; &amp;middot; witness" tooltip="Third etcd member so either engine node can lose its zone and the other still has quorum." id="dep-azC">
          <mxCell style="rounded=1;arcSize=2;html=1;fillColor=none;strokeColor=#2B5797;dashed=1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#2B5797;" vertex="1" parent="dep-LON">
            <mxGeometry x="930" y="190" width="220" height="460" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="dep-stonex" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;StoneX FX servers&lt;/b&gt;&lt;br&gt;London area (confirm) &amp;middot; est. RTT 1&amp;ndash;3 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-LON">
          <mxGeometry x="20" y="70" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dep-pepper" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Pepperstone cTrader&lt;/b&gt;&lt;br&gt;London area (confirm) &amp;middot; est. RTT 1&amp;ndash;3 ms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-LON">
          <mxGeometry x="240" y="70" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dep-engA" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;LEADER (holds the lease)&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Engine&lt;/b&gt;: orchestrator + adapters (core 0), consumers, Oversee, integrity worker, DLQ recovery, notification dispatcher&lt;br&gt;the only node with broker sessions; every PostgreSQL transaction checks its epoch; pushes a heartbeat to Melbourne every 15 s" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;strokeWidth=2.5;" vertex="1" parent="dep-LON">
          <mxGeometry x="20" y="225" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dep-engB" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;STANDBY&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Engine&lt;/b&gt; (same build, idle)&lt;br&gt;no broker sessions, no Oversee; publishes its health record; campaigns only when healthy, the lease is free, it is not in back-off and the cluster is not in SAFE_HOLD (SM9)" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="dep-LON">
          <mxGeometry x="480" y="225" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dep-keepA" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;own thread / sidecar&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Lease keeper&lt;/b&gt;&lt;br&gt;etcd lease TTL 15 s, renewed every 1 s; hard-exits the engine (SIGKILL) at 12 s without renewal; systemd watchdog 3 s" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="dep-LON">
          <mxGeometry x="20" y="325" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dep-keepB" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;own thread / sidecar&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Lease keeper&lt;/b&gt;&lt;br&gt;etcd lease TTL 15 s, renewed every 1 s; hard-exits the engine (SIGKILL) at 12 s without renewal; systemd watchdog 3 s" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="dep-LON">
          <mxGeometry x="480" y="325" width="430" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dep-etcdA" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;etcd member&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;etcd&lt;/b&gt; (own gp3 volume)&lt;br&gt;auto-compaction 1 h, rolling defrag" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-LON">
          <mxGeometry x="20" y="415" width="430" height="50" as="geometry" />
        </mxCell>
