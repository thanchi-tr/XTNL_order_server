        <mxCell id="sm-h4" value="[HARD_HALT] / trip, alert (high priority)" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#CC0000;fontColor=#CC0000;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.3500;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6364;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-h_run" target="sm-h_hard">
