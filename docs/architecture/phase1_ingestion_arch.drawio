        <mxCell id="dep-redisA" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;core 1&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Redis 7&lt;/b&gt; (leader's copy)&lt;br&gt;FLUSHDB at every LEADER_INIT; boot_id = run_id:epoch" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-LON">
