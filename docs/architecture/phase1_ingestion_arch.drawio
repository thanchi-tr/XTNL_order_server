            <Array as="points">
              <mxPoint x="1230" y="1431" />
              <mxPoint x="985" y="1431" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pat-f5c" value="retries &amp;ge; 5" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.6667;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6667;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=open;endFill=0;" edge="1" parent="pat-1" source="pat-rw" target="pat-qs">
