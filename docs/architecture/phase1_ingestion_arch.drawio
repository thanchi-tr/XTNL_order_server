        <mxCell id="pat-F5" value="P5 &amp;middot; Dead Letter Channel + Idempotent Retry" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#E6F2F8;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;dashed=1;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="pat-1">
