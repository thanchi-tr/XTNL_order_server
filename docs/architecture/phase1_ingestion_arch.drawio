        <mxCell id="sm-p_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Created only from a &lt;b&gt;PositionDTO&lt;/b&gt;: a cTrader execution event, or, on StoneX, the first ORDERS item that reports filled units &amp;gt; 0 (position_id = OrderId; later items for that OrderId update both the order and the position until the order is terminal, then only the position). Reducing fills reduce or close a position; they never open one. The RiskSweep checks needs_stop() and effective_stop() every second: an OPEN position with no effective stop gets effective_stop_missing_since_ms and, after the grace, a SOFT_HALT state; cancelling a linked StoneX stop child wakes the sweep for the account, so a lost stop is seen at once. A position is never closed just because a snapshot doesn't list it: it is re-read by id (fetch_position_status)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S7">
          <mxGeometry x="20" y="290" width="1060" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sm-S8" value="SM8 &amp;middot; Bootstrap after Redis data loss (fail-closed)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#FCE4EC;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="1180" y="2170" width="1080" height="520" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S8">
          <mxGeometry x="20" y="143" width="24" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;DETECTED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;boot_lock taken (NX); gate&lt;br&gt;denies all until READY&lt;/font&gt;" tooltip="Either signal (apply_state.lua answered NO_BOOT, or the integrity tick saw redis:boot_id differ from INFO run_id:epoch) asks the integrity worker; it starts only if SET redis:boot_lock NX PX succeeds, so only one bootstrap runs." id="sm-b_det">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
            <mxGeometry x="70" y="120" width="180" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-b_halt" value="&lt;b&gt;RESTORE_HALT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;halt:state &amp;larr; latest&lt;br&gt;halt_events (CAS)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
          <mxGeometry x="310" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_grp" value="&lt;b&gt;CREATE_GROUP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;XGROUP CREATE oversee:feed&lt;br&gt;0 MKSTREAM (BUSYGROUP = ok)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
          <mxGeometry x="550" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;PRICE_BARRIER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;seed price: / clean_mid: / account_live:&lt;br&gt;where absent or older; wait (bounded)&lt;/font&gt;" tooltip="Seeded prices keep their original timestamps, so the sweep caps results at SOFT until live ticks arrive; a seed never overwrites a fresher value. The wait is bounded: on timeout a missing price is a real outage and is handled as one." id="sm-b_bar">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
            <mxGeometry x="790" y="120" width="180" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-b_seed" value="&lt;b&gt;HEAL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;re-apply every key from PostgreSQL&lt;br&gt;(lock holder only; XADDs wake the sweep)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
          <mxGeometry x="790" y="260" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_heal" value="&lt;b&gt;REPLAY_NO_BOOT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;re-apply the queued NO_BOOT&lt;br&gt;writes (lock holder)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
          <mxGeometry x="550" y="260" width="180" height="70" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;READY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;write redis:boot_id last; release&lt;br&gt;lock; snapshot if in place&lt;/font&gt;" tooltip="Written last, after the queued NO_BOOT writes, so a crash anywhere earlier simply restarts the bootstrap and the gate never opens over an incomplete Redis. In place (no leader change) a fresh fetch_account_snapshot() follows, so live fields stop being sampled." id="sm-b_rdy">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S8">
            <mxGeometry x="310" y="260" width="180" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-b_fin" value="" style="ellipse;html=1;shape=endState;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S8">
          <mxGeometry x="388" y="380" width="24" height="24" as="geometry" />
