        <mxCell id="pat-F2" value="P2 &amp;middot; Protection Proxy (Execution Lockout)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#FBE3E3;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;dashed=1;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="pat-1">
