              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="sm-a8" value="net / timeout&lt;br&gt;error" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.2857;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2857;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-a_auth" target="sm-a_bo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-a9" value="timer /&lt;br&gt;attempt + 1" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.7143;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7143;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-a_bo" target="sm-a_auth">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <UserObject label="auth lost (also from RESYNCING)" tooltip="Drawn once from STREAMING; RESYNCING takes the same transition. Session expired (StoneX) or AccountDisconnect / TokenInvalidated / ClientDisconnect (cTrader)." id="sm-a10">
          <mxCell style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-a_str" target="sm-a_auth">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="2180" y="1180" />
                <mxPoint x="2180" y="890" />
                <mxPoint x="1655" y="890" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="sm-a_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Every reconnect passes through &lt;b&gt;SNAPSHOTTING&lt;/b&gt;, which also refreshes the account image, so Oversee never evaluates rules against a stale equity figure. The adapter's instrument map is filled before any stream starts, and the FX crosses needed for risk conversion are subscribed with the traded symbols. In STREAMING the socket is always drained (control frames are never stuck behind ticks); each subscription keeps its own TTL health key alive only while SUBSCRIBED. After a gap (overflow, or a subscription lost while the socket is up) and at each market open, &lt;b&gt;RESYNCING&lt;/b&gt; first re-subscribes only the streams that are not SUBSCRIBED, then re-reads orders, positions, the account and cash flows over REST; SUBSCRIBED streams and their consumer tasks are untouched, so no duplicate consumer is started. Its REST rows are versioned against the stream watermark, so they never overwrite a newer stream update; anything still open locally but absent from the lists is re-read by id, never closed on absence; it loops with a new watermark if frames were dropped again, and returns to STREAMING only when every stream is SUBSCRIBED and nothing was dropped after the watermark. While a gap is open, that stream's conn: key is deleted and its stream_health.conn_lost_at is set in PostgreSQL, which Oversee's fence reads. Positions share the orders health key. SNAPSHOTTING subscribes each stream that isn't SUBSCRIBED, so a re-authenticated socket gets its subscriptions back, and any SNAPSHOTTING error leads to BACKOFF or AUTHENTICATING. Credential errors go to AUTH_FAILED (page, no loop), left only when the credential generation token_generation changes or an operator re-arms it. Only the leader node opens sessions, after a lease check; the cTrader token pair is refreshed only by the leader and saved before use. No state can reach an order-changing endpoint or message (ReadOnlyTransport, P2)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S4">
          <mxGeometry x="20" y="620" width="1040" height="140" as="geometry" />
        </mxCell>
        <mxCell id="sm-S5" value="SM5 &amp;middot; Oversee HaltSwitch (kill switch)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#FCE4EC;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
