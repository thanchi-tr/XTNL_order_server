          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-o_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Guards on every transition:&lt;/b&gt; [newer version] and [checksum valid]. Key = (broker_seq, broker_updated_at_ms, observed_seq): at a tie the later observation wins (a stream frame's arrival, or the send time of a REST read); the broker's own revision or time decides, so a slow REST read can't undo a newer stop-loss. The same checksum is a no-op that only advances the stored version (in PostgreSQL and Redis; no feed entry, no history row); seq_id breaks a tie only when the keys are equal and the content differs. A &lt;b&gt;lower&lt;/b&gt; version is dropped and logged in event_log, not parked. &lt;b&gt;Violations&lt;/b&gt; (illegal transition such as FILLED &amp;rarr; WORKING, missing client_order_id, future_timestamp) &amp;rarr; events_dlq. A stop-loss or take-profit change with the same status and a higher version is a legal &lt;b&gt;amend&lt;/b&gt;. Every accepted transition is evaluated by Oversee after it is committed. &lt;b&gt;Initial&lt;/b&gt;: an order is created in whatever status it is first observed in (PENDING from a stream; any status from a snapshot or resync), so a first observation is never a violation. A partial fill seen while PENDING is applied as an implied ack (PENDING &amp;rarr; WORKING &amp;rarr; PARTIALLY_FILLED). Opening fills open or grow the position (SM7); reducing fills (closing trades, filled reduce-only children) reduce or close it and never open a new one." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S1">
          <mxGeometry x="20" y="540" width="1060" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sm-S2" value="SM2 &amp;middot; events_dlq row lifecycle (check-before-retry)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#E1D5E7;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="1180" y="100" width="1080" height="660" as="geometry" />
        </mxCell>
        <mxCell id="sm-d_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S2">
          <mxGeometry x="20" y="148" width="24" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;QUEUED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;parked with error_reason&lt;/font&gt;" tooltip="Row in events_dlq waiting for next_retry_at_ms and for its adapter to reach STREAMING." id="sm-d_q">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S2">
            <mxGeometry x="70" y="130" width="160" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;CHECKING_BROKER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / ORDER: fetch_order_status(id)&lt;br&gt;POSITION: fetch_position_status(id)&lt;br&gt;ACCOUNT: fetch_account_snapshot()&lt;br&gt;CASH_FLOW: fetch_cash_flows()&lt;/font&gt;" tooltip="Asks the broker for the real state before deciding anything: order status for ORDER rows, the position by id for POSITION rows, a fresh account snapshot for ACCOUNT rows, and fetch_cash_flows() for CASH_FLOW rows, which converge only if the transaction_id is found (otherwise back off; after 5 tries quarantine and mark the day transfers_unverified)." id="sm-d_chk">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S2">
            <mxGeometry x="370" y="125" width="230" height="90" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-d_rep" value="&lt;b&gt;RESUBMITTED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / publish the broker's fresh&lt;br&gt;row (parked payload dropped)&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S2">
