          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F1">
