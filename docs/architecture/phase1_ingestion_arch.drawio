        <UserObject label="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;frozen dataclass &amp;middot; new&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AccountDTO&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;account_id, adapter_id, currency: str&lt;br&gt;balance, realised_pnl_today: Decimal&lt;br&gt;&lt;i&gt;live, unversioned:&lt;/i&gt; equity?, margin_used,&lt;br&gt;&amp;nbsp;&amp;nbsp;free_margin, unrealised_pnl&lt;br&gt;broker_updated_at_ms, broker_seq?, source, seq_id&lt;br&gt;checksum: str" tooltip="Event form of the account image." id="pat-adto">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
            <mxGeometry x="380" y="406" width="320" height="140" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;frozen dataclass &amp;middot; new&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PositionDTO&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;position_id, account_id, adapter_id: str&lt;br&gt;symbol, side, entry_price&lt;br&gt;units: Decimal | None, raw_qty?&lt;br&gt;instrument_unknown: bool&lt;br&gt;stop_loss, take_profit: Decimal | None&lt;br&gt;status: OPEN | CLOSED&lt;br&gt;accrued_swap, commission: Decimal&lt;br&gt;opened_by_client_order_id?&lt;br&gt;broker_updated_at_ms, broker_seq?, source, seq_id&lt;br&gt;checksum: str" tooltip="No unrealised P&amp;L: positions are marked from their adapter's price: keys, so a position's version changes only on units, stop, take-profit or status." id="pat-posdto">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
            <mxGeometry x="380" y="576" width="320" height="190" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;frozen dataclass &amp;middot; new&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;InstrumentSpec&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;adapter_id, symbol, base_ccy, quote_ccy,&lt;br&gt;pnl_ccy, contract_size, point_size, min_qty&lt;br&gt;unit_kind: UNITS | CENTI_UNITS | LOTS |&lt;br&gt;&amp;nbsp;&amp;nbsp;CONTRACTS | STAKE&lt;br&gt;swap_booked_to_balance: bool&lt;hr size='1'&gt;+ to_notional(broker_qty): Decimal" tooltip="Fetched by fetch_instruments() at start-up and reconnect. Each adapter keeps its own read-only copy (no db / cache import) to normalise quantity; the orchestrator also stores it in PostgreSQL instruments and Redis instrument:{adapter_id}:{symbol}." id="pat-ispec">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
            <mxGeometry x="20" y="356" width="300" height="150" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;frozen dataclass &amp;middot; new&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;CashFlowDTO&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;transaction_id &lt;i&gt;(dedupe key)&lt;/i&gt;&lt;br&gt;account_id, kind: DEPOSIT | WITHDRAWAL |&lt;br&gt;&amp;nbsp;&amp;nbsp;TRADE_PNL | FINANCING | COMMISSION |&lt;br&gt;&amp;nbsp;&amp;nbsp;ADJUSTMENT&lt;br&gt;amount, currency, broker_ts&lt;br&gt;adapter_id, seq_id, checksum" tooltip="Only DEPOSIT / WITHDRAWAL count toward net_transfers_today; the other kinds explain balance moves as P&amp;L. cTrader DepositWithdraw; StoneX cash history where one exists." id="pat-cfdto">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F3">
            <mxGeometry x="20" y="536" width="300" height="140" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="pat-n3" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Every adapter emits the same DTOs, so everything downstream is broker-agnostic. &lt;b&gt;frozen=True&lt;/b&gt; + checksum: safe to share across async tasks, tampering is detectable. &lt;b&gt;Version&lt;/b&gt;: the broker's own revision or time decides which copy is newer, then observed_seq (the later observation wins a tie); a same-checksum write is a no-op. &lt;b&gt;Units&lt;/b&gt; are one canonical unit for every broker; ordered vs remaining keeps partial fills from being counted twice." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="pat-F3">
          <mxGeometry x="20" y="706" width="300" height="130" as="geometry" />
        </mxCell>
