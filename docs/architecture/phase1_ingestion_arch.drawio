        </mxCell>
        <mxCell id="sm-b_b_grp" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-b_grp" target="sm-b_bar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_b_bar" value="[prices live&lt;br&gt;or timeout]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-b_bar" target="sm-b_seed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_b_seed" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-b_seed" target="sm-b_heal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_b_heal" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-b_heal" target="sm-b_rdy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_b_rdy" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-b_rdy" target="sm-b_fin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-b_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;Run single-flight by the &lt;b&gt;integrity worker&lt;/b&gt; (src/integrity) under redis:boot_lock when Redis has lost or replaced its data; NO_BOOT elsewhere only signals it. The &lt;b&gt;order&lt;/b&gt; matters: the halt level is restored first; the consumer group exists before the feed is refilled; seeded prices never overwrite fresher ones; queued NO_BOOT writes are re-applied before boot_id, which is written last, so a crash at any step simply starts the bootstrap again. ActionGate denies everything until READY and the feed observer waits, while the RiskSweep keeps running from PostgreSQL. A failed step retries; the gate stays closed." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S8">
          <mxGeometry x="20" y="430" width="1040" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sm-S9" value="SM9 &amp;middot; Engine node role (lease, fencing, failover)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#D5E8D4;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="40" y="2730" width="1100" height="600" as="geometry" />
        </mxCell>
        <mxCell id="sm-s_ini" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S9">
          <mxGeometry x="20" y="148" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sm-s_start" value="&lt;b&gt;STARTING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;chrony synced,&lt;br&gt;PG reachable&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
          <mxGeometry x="90" y="130" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm-s_stby" value="&lt;b&gt;STANDBY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;health record&lt;br&gt;published&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
          <mxGeometry x="320" y="130" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sm-s_cand" value="&lt;b&gt;CANDIDATE&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;campaign for&lt;br&gt;the etcd lease&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
          <mxGeometry x="580" y="130" width="180" height="60" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;LEADER_INIT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;epoch + term row &amp;rarr; HLC &amp;rarr; FLUSHDB&lt;br&gt;&amp;rarr; sod catch-up &amp;rarr; SM10 init &amp;rarr;&lt;br&gt;SM4 &amp;#8741; SM8 (boot_id last) &amp;rarr; DLQ barrier&lt;/font&gt;" tooltip="Strict order. The epoch commit comes first so a stale leader is fenced in PostgreSQL before this node does anything else; SM4 runs in parallel with all SM8 steps (its writes queue as NO_BOOT; SM8 writes boot_id last). The lease keeper enforces a 120 s deadline: past it the lease is revoked and the node hard-exits (init_failed); reaching LEADER sets leader_terms.reached_leader_at." id="sm-s_init">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
            <mxGeometry x="840" y="120" width="240" height="90" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-s_lead" value="&lt;b&gt;LEADER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;serving; lease renewed&lt;br&gt;by the keeper thread&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
          <mxGeometry x="840" y="330" width="240" height="70" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;DRAINING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;stop intake, flush spooler,&lt;br&gt;close sockets, release lease&lt;/font&gt;" tooltip="10 s deadline enforced by the lease keeper; the spooler goes to the local spill file if PostgreSQL doesn't answer within 2 s; writes this term's end_reason." id="sm-s_drain">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
            <mxGeometry x="580" y="330" width="180" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SAFE_HOLD&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;cluster-wide; gate&lt;br&gt;closed; one page&lt;/font&gt;" tooltip="Cluster-wide brake, kept as a durable cluster_state row: after 3 abnormal term ends within 15 minutes, or more than 6 epoch changes in 30 minutes, no node campaigns, the gate stays closed and one off-node page goes out. Only an operator command resumes." id="sm-s_hold">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S9">
