        <UserObject label="&lt;b&gt;WORKING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;resting at broker&lt;/font&gt;" tooltip="Order is resting at the broker; Oversee evaluates risk once this state is committed (oversee:feed). SL / TP amendments keep the status and arrive with a higher version." id="sm-o_work">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S1">
