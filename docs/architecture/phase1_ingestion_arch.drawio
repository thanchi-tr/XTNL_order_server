        </mxCell>
        <mxCell id="sm-o_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S1">
          <mxGeometry x="20" y="148" width="24" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;first event seen, no broker ack&lt;/font&gt;" tooltip="Created when the first event for a client_order_id arrives before the broker acknowledges it." id="sm-o_pend">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S1">
