        <mxCell id="dep-alerting" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;managed, off-node&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Off-node alerting&lt;/b&gt;&lt;br&gt;CloudWatch / managed Prometheus + Alertmanager &amp;rarr; SNS&lt;br&gt;no LEADER &amp;gt; 30 s, two LEADERs, etcd / Patroni unhealthy, sync standby lost, standby not ready, epoch-change rate, non-empty spill file on any node; epoch change inhibits dependent alerts for RTO + 30 s" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-LON">
          <mxGeometry x="1170" y="225" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dep-timesrc" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Time source&lt;/b&gt;&lt;br&gt;Amazon Time Sync (leap smear) &amp;rarr; chrony on every node; engine starts only after sync" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-EXT">
          <mxGeometry x="15" y="70" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dep-providers" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Alert providers&lt;/b&gt;&lt;br&gt;Email: SES / SMTP&lt;br&gt;Push: FCM / APNs" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-EXT">
          <mxGeometry x="15" y="230.0" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dep-dash" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;read-only&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Operator dashboard&lt;/b&gt; + &lt;b&gt;dead-man's switch&lt;/b&gt;&lt;br&gt;read-only over a WireGuard VPN (entity views from PostgreSQL; Redis values only for the current epoch); receives the leader's push heartbeat every 15 s and pages, through a channel outside eu-west-2 (SNS in ap-southeast-4 or a third-party pager), after 60 s of silence, when any adapter is not STREAMING for 2 min while OPEN, or when a payload age passes its threshold (oldest un-acked feed entry, oldest per-account RiskSweep pass, per-adapter market_open and maintenance, oldest undelivered alert, SM8 not READY or SM5 UNKNOWN, spill file non-empty, an open task circuit); daily test page" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-MEL">
          <mxGeometry x="20" y="70" width="460" height="130" as="geometry" />
        </mxCell>
        <mxCell id="dep-phone" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;people&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Risk manager / on-call&lt;/b&gt;&lt;br&gt;email, push and SNS pages" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-MEL">
          <mxGeometry x="20" y="265.0" width="460" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dep-s3" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Tier 3 &amp;middot; Memento&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Immutable image&lt;/b&gt; &amp;mdash; ap-southeast-4 S3, Object Lock&lt;br&gt;pgBackRest WAL + daily incremental; restores are operator-run only" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-MEL">
          <mxGeometry x="20" y="645.0" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dep-ha_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Single writer &amp;amp; failover&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Lease + epoch&lt;/b&gt;: the leader holds an etcd lease; epoch = (etcd cluster_id, lease revision), written to PostgreSQL engine_epoch (fencing token = the revision). Every engine write carries the token in the same statement (no lock), so a stale leader's writes affect 0 rows and fail. The HLC is re-seeded after the bump.&lt;br&gt;&amp;bull; &lt;b&gt;Self-fence off the event loop&lt;/b&gt;: the lease keeper thread hard-kills the engine at 12 s without renewal (TTL 15 s, renewed every 1 s); the kernel resets its sockets (SO_LINGER 0). Watchdog 3 s &amp;lt; fence 12 s &amp;lt; TTL 15 s, which leaves room for an etcd leader election.&lt;br&gt;&amp;bull; &lt;b&gt;Health-gated election&lt;/b&gt;: hard checks (PostgreSQL writable, etcd, Redis writable, chrony within 50 ms) gate any campaign; broker reach is only a preference, and once the lease has been free for 15 s any node passing the hard checks campaigns; the node hosting the Patroni primary is preferred. The leader judges brokers by its own SM4 state (STREAMING is healthy whatever a probe says) and abdicates only to an eligible peer (hard checks, no back-off, no SAFE_HOLD): on a hard check only after 30 s (for the leader this includes a RiskSweep circuit open &amp;gt; 5 min, once per incident), on broker grounds only when its own network path fails and the peer's works. AUTH_FAILED is a cluster-wide fact, never a reason to abdicate. 60 s back-off after a term ends (waived after a fence when no peer is alive); 3 abnormal term ends in 15 min or more than 6 epoch changes in 30 min &amp;rarr; SAFE_HOLD, a durable row (gate closed, one page, operator resume).&lt;br&gt;&amp;bull; &lt;b&gt;Phase 2 contract&lt;/b&gt;: two senders are excluded only within lease timing. Every send first commits an outbound_intent (epoch); a lease check with no await precedes the socket write; a new leader keeps the gate shut for TTL + TCP_USER_TIMEOUT + ack timeout and marks earlier-epoch SENDING intents UNKNOWN (resolved by a broker read or an operator, never re-sent)." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="dep-1">
          <mxGeometry x="40" y="940.0" width="726" height="240" as="geometry" />
        </mxCell>
        <mxCell id="dep-rto_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Failure cases&lt;/b&gt; (targets; measure in drills)&lt;table style='border-collapse:collapse;font-size:9px;margin-top:3px'&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Failure&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;What happens&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Ingestion back&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Engine crash / hang&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;watchdog or fence kills it; standby wins the lease; LEADER_INIT&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~30&amp;ndash;60 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Node or zone A lost&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Patroni promotes B (~15&amp;ndash;25 s) and the lease moves to B&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~45&amp;ndash;90 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Standby or zone B lost&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;commits stall until Patroni drops sync (&amp;le; ~20 s), then async + critical alert; no failover while the leader is on the primary's node&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&amp;le; ~20 s stall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Witness or etcd leader's zone lost&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;etcd re-elects inside the fence budget; alert&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;none&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;PostgreSQL process fails on primary&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Patroni promotes the sync standby at once (primary_start_timeout 0)&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~15&amp;ndash;25 s commit stall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Redis lost on leader&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;gate closed; SM8 rebuild in place, no abdication&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~10&amp;ndash;30 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Broker outage&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;SM4 backoff; FENCE flags; per-adapter page after 2 min not STREAMING while OPEN&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;when broker returns&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;PostgreSQL corruption&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;HALTED + page; switchover to a checked standby or operator restore&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;minutes&amp;ndash;hours&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Region lost&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;manual DR: isolate London, revoke its broker tokens, restore Tier 3 elsewhere&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;2&amp;ndash;4 h&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;RPO 0 for committed data while the sync standby is healthy; ActionGate stays closed throughout." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="dep-1">
          <mxGeometry x="786" y="940.0" width="726" height="240" as="geometry" />
        </mxCell>
        <mxCell id="dep-ops_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;24/7 operations&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;Supervision&lt;/b&gt;: systemd Restart=always, MemoryMax; WatchdogSec=3 (SIGKILL) only for event-loop lag and lease expiry. Every task is restarted with backoff and stamps its liveness against a per-task max age; waits on PostgreSQL, BACKOFF and AUTH_FAILED count as alive. A stale stamp pages and restarts that task; N deaths open a per-task circuit (input quarantined, page, 'degraded' in the dead-man payload) that half-opens every 10 min or closes on an audited reset_task. Blocking SDK / DNS calls run in threads with timeouts.&lt;br&gt;&amp;bull; &lt;b&gt;Metrics&lt;/b&gt;: ingest rate, queue / spool / spill / DLQ depth, feed lag + PEL, sweep pass age, loop lag, clock offset, replication and WAL-archive lag, Redis memory, disk, REST budget, lease-renew p99, token age, certificate expiry; JSON logs with ids + epoch, shipped off-node.&lt;br&gt;&amp;bull; &lt;b&gt;Data&lt;/b&gt;: partitions by seq_id range (~monthly; oversee_events by sweep_id, outbox by created_at), verified export (gzip JSONL + sha256, copied to S3) before detach, 90 days hot, audit tables per compliance; outbox rows deleted after relay; disk alerts 70 / 85 %.&lt;br&gt;&amp;bull; &lt;b&gt;Change&lt;/b&gt;: rolling upgrade by switchover; migrations run by an operator before the switch (lock_timeout 2 s); rule thresholds versioned and hot-reloaded (sweep_now() for every account); a reload resolves the states of removed or disabled rules.&lt;br&gt;&amp;bull; &lt;b&gt;Secrets&lt;/b&gt;: Secrets Manager (notification channel credentials too, re-read on auth error); the cTrader token pair is refreshed only by the leader with lease margin, after a 'refresh in flight' row, and saved with a token_generation compare-and-set; AUTH_FAILED pages instead of looping and is re-armed by a new credential generation (Secrets Manager version or token_generation) or an audited operator command.&lt;br&gt;&amp;bull; &lt;b&gt;DR&lt;/b&gt;: archive_mode=always on both members, daily incremental backups, quarterly timed drill." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="dep-1">
          <mxGeometry x="1532" y="940.0" width="726" height="240" as="geometry" />
        </mxCell>
        <mxCell id="dep-lat" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Why London&lt;/b&gt; (estimates; measure from the instances before go-live)&lt;table style='border-collapse:collapse;font-size:10px;margin-top:4px'&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Concern&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Engine in Melbourne&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Engine in London&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;RTT to broker FX servers&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~250&amp;ndash;280 ms&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~1&amp;ndash;3 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Two broker round trips inside the 2 s stop-loss grace&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;~550 ms (~27 %)&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&amp;lt; 6 ms (&amp;lt; 0.3 %)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Clock discipline for the HLC&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;OS NTP, &amp;plusmn;10&amp;ndash;50 ms&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;chrony + cloud PTP, &amp;lt; 0.1 ms&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;Phase 2 sending (later)&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;slippage from transit time&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;near the liquidity&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;The stop-loss grace runs from effective_stop_missing_since_ms on the local clock, so it is never spent in transit." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="dep-1">
          <mxGeometry x="40" y="1210.0" width="2220" height="140" as="geometry" />
        </mxCell>
