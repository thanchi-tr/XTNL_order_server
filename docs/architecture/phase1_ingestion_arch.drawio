        <mxCell id="pat-smtp" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;SMTP / SES&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F10">
