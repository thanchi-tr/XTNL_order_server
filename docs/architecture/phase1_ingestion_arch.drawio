        <mxCell id="sm-i14" value="operator restore runbook done (Patroni pause, pgBackRest restore to an explicit target on the current timeline, reinit replica, resume)" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#2E7D32;fontColor=#2E7D32;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.8462;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1905;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-i_man" target="sm-i_rec">
