        <mxCell id="dep-pgA" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Patroni primary&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 17&lt;/b&gt; (EBS io2 / gp3)&lt;br&gt;failsafe_mode on &amp;middot; synchronous_mode &amp;middot; primary_start_timeout 0 &amp;middot; ttl 15 s, loop_wait 5 s &amp;middot; wal_sender_timeout 10 s &amp;middot; archive_mode=always &amp;middot; the engine campaign prefers the node hosting the primary; alert if apart &amp;gt; 10 min" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=2;" vertex="1" parent="dep-LON">
          <mxGeometry x="20" y="555" width="430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dep-pgB" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;synchronous standby&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;sync replica; degrades to async with a critical alert if lost &amp;middot; archive_mode=always" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="dep-LON">
