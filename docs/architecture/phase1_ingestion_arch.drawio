        </mxCell>
        <mxCell id="pat-lcm" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;survives a leader change&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;last_clean_marks&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;adapter_id, symbol, bid, ask, ts&lt;br&gt;upsert &amp;le; 10 s; forced at transitions" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F15">
          <mxGeometry x="400" y="266" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pat-n14" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;A closed market mutes only &lt;b&gt;price&lt;/b&gt; staleness, and evidence (a tick or an event) overrides the calendar. The readiness check runs before each open; last clean marks persist, so marks and the start-of-day equity survive a leader change." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="pat-F15">
