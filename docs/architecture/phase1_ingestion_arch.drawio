        <UserObject label="&lt;b&gt;BACKOFF&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / retry_count += 1;&lt;br&gt;next_retry_at_ms = now + backoff&lt;/font&gt;" tooltip="Waits with exponential backoff + jitter before the next check." id="sm-d_bo">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S2">
