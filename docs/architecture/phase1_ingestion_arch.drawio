          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S4">
