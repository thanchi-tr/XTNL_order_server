        <mxCell id="sm-p_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S7">
          <mxGeometry x="20" y="148" width="24" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;OPEN&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;units &amp;gt; 0; stop / take-profit may change&lt;/font&gt;" tooltip="Created only from a PositionDTO. Every sweep checks needs_stop() and effective_stop(); no effective stop starts the durable grace clock effective_stop_missing_since_ms." id="sm-p_open">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S7">
