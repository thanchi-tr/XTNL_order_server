        <UserObject label="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;intentional duplicate&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Redis key layout&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;order:{client_order_id} &amp;rarr; OrderDTO&lt;br&gt;position:{position_id} &amp;rarr; PositionDTO&lt;br&gt;account:{account_id} &amp;rarr; account image&lt;br&gt;halt:state &amp;rarr; (effective_level, halt_event_id)&lt;br&gt;redis:boot_id &amp;rarr; run_id:epoch&lt;br&gt;instrument:{adapter_id}:{symbol} &amp;middot; state:digest&lt;br&gt;conn:{adapter_id}:{stream} &amp;rarr; TTL 30 s&lt;br&gt;&lt;i&gt;light script:&lt;/i&gt; price: / clean_mid:{adapter_id}:{symbol},&lt;br&gt;&amp;nbsp;&amp;nbsp;account_live:{id}, conn: (no feed entries)&lt;br&gt;oversee:feed &amp;rarr; Stream (trimmed MINID, cap ~1 M)&lt;br&gt;&lt;i&gt;no timer keys: Oversee keeps no timers&lt;/i&gt;&lt;hr size='1'&gt;apply_state.lua: SET if version newer&lt;br&gt;&amp;nbsp;&amp;nbsp;(fixed-width strings); XADD only if applied;XOR digest (order-independent)" tooltip="Written only after the PostgreSQL commit; healed in place by integrity Step 1 through the same script." id="pat-rk">
