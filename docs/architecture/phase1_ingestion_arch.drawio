        <mxCell id="sm-n_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Dedupe&lt;/b&gt;: one alert per state episode (when a state activates or rises), then a re-page every escalate_after_ms unless acknowledged, so a flapping rule can't spam. Only the level-raising trip() alert skips dedupe (and goes to every channel).  Delivery is at-least-once (outbox), so a phone may occasionally see a repeat." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S6">
          <mxGeometry x="20" y="440" width="1040" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sm-S7" value="SM7 &amp;middot; PositionDTO lifecycle (open trade after a fill)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#DAE8FC;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="40" y="2170" width="1100" height="520" as="geometry" />
