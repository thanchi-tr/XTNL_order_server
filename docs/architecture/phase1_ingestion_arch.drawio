        </mxCell>
        <UserObject label="&lt;b&gt;UNKNOWN (fail-closed)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / ActionGate denies everything; rehydrate: halt:state &amp;larr; latest halt_events row through the CAS script (no new row, no alert); exits only when SM8 is READY&lt;/font&gt;" tooltip="Start state, and re-entered whenever halt:state is missing or its event id differs from PostgreSQL. Left only once SM8 is READY (redis:boot_id = run_id:epoch). ActionGate denies everything here. Leaving it only restores halt:state: no new halt_events row and no alert, so a restart doesn't re-announce an old halt." id="sm-h_unk">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S5">
            <mxGeometry x="90" y="265" width="990" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;RUNNING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;halt:state = NONE&lt;/font&gt;" tooltip="No halt in force; FLAG verdicts are logged and alerted without blocking anything." id="sm-h_run">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S5">
