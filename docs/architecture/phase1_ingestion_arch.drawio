        <mxCell id="sm-h5" value="FLAG / log + alert" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#AD1457;fontColor=#AD1457;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.1000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-h_run" target="sm-h_run">
