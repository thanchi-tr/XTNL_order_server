        <UserObject label="[credential error, 3rd&lt;br&gt;attempt, or known bad]" tooltip="Bad password, PasswordChangeRequired, invalid_grant, or TokenInvalidated after a fresh token read; or adapter_auth_state already records AUTH_FAILED for the current credential generation, so no LogOn is attempted." id="sm-a17">
          <mxCell style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#CC0000;fontColor=#CC0000;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.0000;exitY=0.8571;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-a_auth" target="sm-a_af">
