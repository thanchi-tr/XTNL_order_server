<mxfile host="app.diagrams.net" agent="generated" version="24.7.0">
  <diagram id="arch" name="1 · Architecture">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2660" pageHeight="3801" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="arch-0" />
        <mxCell id="arch-1" parent="arch-0" />
        <mxCell id="arch-title" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;XTNL Phase 1 &amp;mdash; Read-Only Broker Ingestion, Pub-Sub &amp;amp; Oversee&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px' color='#555555'&gt;Broker &amp;rarr; BrokerAdapter &amp;rarr; Order / Position / Price / Account DTO bus &amp;rarr; Redis &amp;gt; PostgreSQL &amp;gt; Image Backup, watched by &lt;b&gt;Oversee&lt;/b&gt; (risk-rule plugins, soft/hard halt, email + mobile alerts). Runs 24/7 on two London nodes with one fenced leader (page 5, SM9). Coloured tags = element kind (legend at bottom); &lt;font color='#0B6E99'&gt;&lt;i&gt;&amp;laquo;pattern&amp;raquo; Pn&lt;/i&gt;&lt;/font&gt; = design pattern on page 2; hover any box for detail.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="arch-1">
          <mxGeometry x="40" y="16" width="2580" height="60" as="geometry" />
        </mxCell>
        <UserObject label="&amp;#9312; External Broker Layer (read-only)" tooltip="Everything outside our process that we ingest from. Phase 1 only reads." id="arch-L1">
          <mxCell style="swimlane;horizontal=0;startSize=40;html=1;fontSize=15;fontStyle=1;collapsible=0;fillColor=#FFE6CC;strokeColor=#D79B00;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="arch-1">
            <mxGeometry x="40" y="90" width="2580" height="294" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;StoneX API&lt;/b&gt;&lt;/font&gt; &lt;font color='#666666'&gt;(ciapi.cityindex.com)&lt;/font&gt;&lt;br&gt;REST JSON &lt;i&gt;/TradingAPI&lt;/i&gt; + &lt;i&gt;/v2&lt;/i&gt; &amp;middot; Lightstreamer (lightstreamer-4, STREAMINGALL)&lt;br&gt;&lt;b&gt;Sandbox:&lt;/b&gt; ciapipreprod.cityindextest9.co.uk&lt;br&gt;&lt;b&gt;Read-only calls:&lt;/b&gt;&lt;br&gt;&amp;bull; POST /v2/Session (LogOn)&lt;br&gt;&amp;bull; GET /v2/userAccount/ClientAndTradingAccount&lt;br&gt;&amp;bull; GetClientAccountMargin v2 (account image)&lt;br&gt;&amp;bull; GET openpositions &amp;middot; tradehistory&lt;br&gt;&amp;bull; POST activeorders &lt;i&gt;(read-only POST)&lt;/i&gt;&lt;br&gt;&lt;b&gt;Streams:&lt;/b&gt; PRICES &amp;middot; ORDERS (orders &lt;i&gt;and&lt;/i&gt; open trades) &amp;middot; TRADEMARGIN (margin only) &amp;middot; CLIENTACCOUNTMARGIN" tooltip="StoneX (GAIN Capital / City Index) REST + Lightstreamer API, from docs.labs.gaincapital.com.&#10;ClientAccountMargin (stream + REST) feeds the account image used by Oversee rules.&#10;activeorders is a POST that only reads, so the lockout denies by path, not verb." id="arch-stonex">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L1">
            <mxGeometry x="80" y="25" width="380" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;Pepperstone &amp;mdash; cTrader Open API&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Spotware ProtoOA over TLS (demo.ctraderapi.com / live.ctraderapi.com :5035, confirm)&lt;br&gt;OAuth access + refresh token; read-only use requests the &lt;i&gt;accounts&lt;/i&gt; scope&lt;br&gt;&lt;b&gt;Read-only use:&lt;/b&gt; reconcile (orders + positions), execution events, spots, trader / balanceVersion, deposit / withdraw events, symbol schedules&lt;br&gt;&lt;b&gt;Heartbeat:&lt;/b&gt; ProtoHeartbeatEvent every 10 s; honour rate limits" tooltip="The older REST / WebSocket endpoints in broker-endpoints.md predate this design; the adapter targets the cTrader Open API. Hostnames and limits to be confirmed with Spotware / Pepperstone." id="arch-pepper">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L1">
            <mxGeometry x="505" y="25" width="380" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;test double&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;Mock Broker&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Deterministic fixtures (114-trade baseline) incl. account snapshots&lt;br&gt;BROKER_ADAPTER_TYPE=mock &amp;middot; no network I/O&lt;br&gt;Drives &lt;i&gt;verify_execution.py&lt;/i&gt; and rule tests (e.g. 1.2 % risk &amp;rarr; FLAG, 2 % &amp;rarr; SOFT_HALT)" tooltip="Fixtures can include rule-breaking orders so every Oversee rule has a deterministic test." id="arch-mock">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L1">
            <mxGeometry x="930" y="25" width="380" height="180" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&amp;#9940; &lt;b&gt;EXECUTION LOCKOUT&lt;/b&gt;&lt;br&gt;newtradeorder &amp;middot; newstoplimitorder &amp;middot; updatetradeorder &amp;middot; updatestoplimitorder &amp;middot; cancel &amp;rarr; BLOCKED" tooltip="StoneX order-changing endpoints, denied by ReadOnlyTransport (P2)." id="arch-tag_stonex">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingTop=0;dashed=1;" vertex="1" parent="arch-L1">
            <mxGeometry x="80" y="219" width="380" height="50" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-tag_pepper" value="&amp;#9940; &lt;b&gt;EXECUTION LOCKOUT&lt;/b&gt;&lt;br&gt;place_order &amp;middot; modify_order &amp;middot; cancel_order &amp;rarr; BLOCKED&lt;br&gt;ProtoOA allow-list: read / subscribe only" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingTop=0;dashed=1;" vertex="1" parent="arch-L1">
          <mxGeometry x="505" y="219" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arch-tag_mock" value="&amp;#9940; &lt;b&gt;EXECUTION LOCKOUT&lt;/b&gt;&lt;br&gt;place_order &amp;middot; modify_order &amp;middot; cancel_order &amp;rarr; BLOCKED" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1A1A1A;align=center;verticalAlign=middle;spacingTop=0;dashed=1;" vertex="1" parent="arch-L1">
          <mxGeometry x="930" y="219" width="380" height="50" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#B71C1C;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;SECURITY GUARD&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Protection Proxy&amp;raquo; P2&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px' color='#B71C1C'&gt;&lt;b&gt;&amp;#9940; EXECUTION LOCKOUT GUARD&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Live outbound execution is mechanically blocked in Phase 1 by independent layers:&lt;br&gt;&lt;b&gt;1. PreToolUse hook&lt;/b&gt; &amp;mdash; .claude/hooks/pre_tool_guard.py denies place_order / modify_order / cancel_order&lt;br&gt;&lt;b&gt;2. Interface lock&lt;/b&gt; &amp;mdash; BrokerAdapter defines no mutation methods&lt;br&gt;&lt;b&gt;3. Environment gate&lt;/b&gt; &amp;mdash; BROKER_ENV must be &lt;i&gt;sandbox&lt;/i&gt; or &lt;i&gt;live_readonly&lt;/i&gt; (read-only credentials / OAuth scope where the broker offers one); anything else is refused at start-up&lt;br&gt;&lt;b&gt;4. ReadOnlyTransport&lt;/b&gt; &amp;mdash; StoneX REST: path deny-list /newtradeorder, /newstoplimitorder, /updatetradeorder, /updatestoplimitorder, /cancel (by &lt;b&gt;path&lt;/b&gt;, not verb); cTrader ProtoOA: &lt;b&gt;payloadType allow-list&lt;/b&gt; (the one list in adapter-isolation.md &amp;sect;4: auth, token refresh, reconcile, orders, deals, cash flows, symbols, schedule, spots, heartbeat), everything else refused; live_readonly also requires the OAuth scope 'accounts'&lt;br&gt;&lt;b&gt;5. ActionGate&lt;/b&gt; (lane &amp;#9316;) &amp;mdash; when Phase 2 adds sending, every send must also pass the Oversee halt state&lt;br&gt;&lt;b&gt;6. Single writer&lt;/b&gt; &amp;mdash; only the leader node (etcd lease + PostgreSQL epoch) opens broker sessions; a leader that loses its lease is hard-killed" tooltip="Defence in depth. Layers 1-4 make sending impossible in Phase 1; layer 5 is the risk gate Phase 2 must keep." id="arch-guard">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=3;" vertex="1" parent="arch-L1">
            <mxGeometry x="1355" y="25" width="805" height="244" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-cm1" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;What this layer is&lt;/b&gt;&lt;br&gt;The only sources of truth outside our process. Phase 1 &lt;b&gt;reads&lt;/b&gt;; it never writes.&lt;br&gt;&lt;br&gt;&lt;b&gt;New: account image&lt;/b&gt;&lt;br&gt;Each broker also provides balance and margin (equity where available, used only as a cross-check). Rules use the computed equity_mark, e.g. 1R = 1.0 % of equity_mark per trade.&lt;br&gt;&lt;br&gt;&lt;b&gt;Watch out&lt;/b&gt;&lt;br&gt;StoneX &lt;i&gt;activeorders&lt;/i&gt; is a read-only POST; deny order endpoints by path." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L1">
          <mxGeometry x="2240" y="25" width="320" height="244" as="geometry" />
        </mxCell>
        <UserObject label="&amp;#9313; Pluggable Adapter Layer" tooltip="Raw broker payloads in, canonical DTOs out." id="arch-L2">
          <mxCell style="swimlane;horizontal=0;startSize=40;html=1;fontSize=15;fontStyle=1;collapsible=0;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="arch-1">
            <mxGeometry x="40" y="404" width="2580" height="390" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Adapter &amp;middot; Strategy&amp;raquo; P1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;StoneXAdapter&lt;/b&gt;&lt;/font&gt; &lt;i&gt;(new)&lt;/i&gt;&lt;br&gt;&amp;bull; LogOn v2 session token; re-auth on expiry&lt;br&gt;&amp;bull; PRICES &amp;rarr; PriceDTO&lt;br&gt;&amp;bull; ORDERS &amp;rarr; OrderDTO; the first item with filled units &amp;gt; 0 also emits a &lt;b&gt;PositionDTO&lt;/b&gt; (position_id = OrderId, entry price from GET order/{id}); later items update the OrderDTO (remaining_units, status) &lt;b&gt;and&lt;/b&gt; the PositionDTO (units) until the order is terminal, then the PositionDTO only; closing trades and filled reduce-only children reduce or close the linked position instead of opening one. Positions use the item's own timestamp, else the local clock domain&lt;br&gt;&amp;bull; if-done stop / limit children &amp;rarr; separate reduce-only OrderDTOs (linked_position_id)&lt;br&gt;&amp;bull; TRADEMARGIN + CLIENTACCOUNTMARGIN &amp;rarr; AccountDTO only&lt;br&gt;&amp;bull; contracts / stake-per-point &amp;rarr; units (own instrument map)" tooltip="Not in the repo yet. TRADEMARGIN has no stop, entry or status, so it never builds a position. Stops are never folded into the position inside the adapter: Oversee derives the effective stop from the linked reduce-only children." id="arch-a_stonex">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L2">
            <mxGeometry x="80" y="25" width="380" height="200" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-a_pepper" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Adapter &amp;middot; Strategy&amp;raquo; P1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;PepperstoneAdapter&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;bull; cTrader Open API: ProtoOA (protobuf) over TLS; app + account auth (OAuth token pair); ProtoHeartbeatEvent every 10 s, no inbound 30 s &amp;rarr; reconnect (values to confirm)&lt;br&gt;&amp;bull; ORDER_STATUS_ACCEPTED &amp;rarr; WORKING (ORDER_PARTIAL_FILL &amp;rarr; PARTIALLY_FILLED) &amp;middot; ORDER_STATUS_FILLED &amp;rarr; FILLED&lt;br&gt;&amp;bull; execution events &amp;rarr; OrderDTO + &lt;b&gt;PositionDTO&lt;/b&gt; (native stopLoss / takeProfit)&lt;br&gt;&amp;bull; closingOrder or SL/TP order type &amp;rarr; is_reduce_only&lt;br&gt;&amp;bull; trader / balanceVersion &amp;rarr; AccountDTO; DepositWithdraw &amp;rarr; &lt;b&gt;CashFlowDTO&lt;/b&gt;&lt;br&gt;&amp;bull; AccountDisconnect / TokenInvalidated / ClientDisconnect &amp;rarr; re-authenticate&lt;br&gt;&amp;bull; volume / 100 &amp;rarr; units (CENTI_UNITS, to confirm; own instrument map)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L2">
          <mxGeometry x="505" y="25" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="arch-a_mock" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Adapter &amp;middot; Strategy&amp;raquo; P1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;MockBrokerAdapter&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;bull; Fixtures with deterministic broker_seq / broker timestamps (seq_id still stamped by the orchestrator)&lt;br&gt;&amp;bull; Same mapping as live adapters&lt;br&gt;&amp;bull; Emits account, position and cash-flow fixtures too" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L2">
          <mxGeometry x="930" y="25" width="380" height="200" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#B45309;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;VALUE OBJECT&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Canonical Data Model &amp;middot; Value Object&amp;raquo; P3&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;OrderDTO / PositionDTO / PriceDTO / AccountDTO / CashFlowDTO / InstrumentSpec&lt;/b&gt;&lt;/font&gt; (src/dto &amp;middot; frozen=True)&lt;br&gt;&lt;b&gt;Version on every stateful DTO:&lt;/b&gt; broker_updated_at_ms, broker_seq?, source STREAM | REST, seq_id &amp;rarr; key = (broker_seq, broker_ts, observed_seq: the later observation wins a tie); same checksum = no-op; seq_id breaks a tie only when the content differs. broker_seq and broker time are each declared present or absent per (adapter, entity) type; without broker time every row of that type uses local time; an untimed REST row in the broker domain gets the stream watermark, never the local send time&lt;br&gt;&lt;b&gt;OrderDTO:&lt;/b&gt; client_order_id, broker_order_id, account_id, adapter_id, symbol, side, status, entry_price, stop_loss?, take_profit?, &lt;b&gt;ordered_units?, remaining_units?, is_reduce_only, linked_position_id?&lt;/b&gt;, instrument_unknown, raw_qty?, version, checksum &amp;middot; &lt;i&gt;no risk field: Oversee owns risk&lt;/i&gt;&lt;br&gt;&lt;b&gt;PositionDTO&lt;/b&gt; &lt;i&gt;(new)&lt;/i&gt;: position_id, account_id, adapter_id, symbol, side, units?, instrument_unknown, raw_qty?, entry_price, stop_loss?, take_profit?, status OPEN | CLOSED, opened_by_client_order_id?, accrued_swap, commission, version, checksum &amp;middot; &lt;i&gt;no unrealised P&amp;amp;L: marked from its adapter's prices&lt;/i&gt;&lt;br&gt;&lt;b&gt;AccountDTO&lt;/b&gt; (versioned): account_id, adapter_id, currency, balance, realised_pnl_today, version, checksum &amp;middot; live fields equity?, margin_used, free_margin, unrealised_pnl &amp;rarr; unversioned, coalesced &lt;i&gt;account_live:{id}&lt;/i&gt; &amp;middot; &lt;b&gt;CashFlowDTO&lt;/b&gt; &lt;i&gt;(new)&lt;/i&gt;: transaction_id, account_id, kind DEPOSIT | WITHDRAWAL | TRADE_PNL | FINANCING | COMMISSION | ADJUSTMENT, amount, currency, broker_ts, adapter_id, seq_id, checksum&lt;br&gt;&lt;b&gt;PriceDTO:&lt;/b&gt; adapter_id, symbol, bid, ask, spread_pips, timestamp_ms, seq_id &amp;middot; &lt;b&gt;InstrumentSpec:&lt;/b&gt; adapter_id, symbol, base_ccy, quote_ccy, pnl_ccy, contract_size, unit_kind, point_size, min_qty, swap_booked_to_balance&lt;br&gt;&lt;b&gt;seq_id&lt;/b&gt; = orchestrator HLC max(epoch_ms &amp;lt;&amp;lt; 20, last + 1), seeded from PostgreSQL: event-log order and last tie-breaker only" tooltip="Why a version and not seq_id alone: seq_id is stamped on arrival, so a slow REST read could look newer than a later stream update. Comparing the broker's own time (or revision) first stops a stale snapshot overwriting a newer stop-loss. A broker_ts more than 5 s ahead of local receipt is rejected as future_timestamp. ordered_units is the whole trade (per-order 1R check); remaining_units is what is still unfilled (aggregate risk), so a partial fill is never counted twice. is_reduce_only is set only from explicit broker evidence. An unknown symbol triggers fetch_instruments(); if it is still unknown the entity is committed with instrument_unknown = true and its raw broker quantity, so the RiskSweep sees it (UNKNOWN &amp;rarr; capped SOFT_HALT) instead of it looping through the DLQ." id="arch-dto">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L2">
            <mxGeometry x="1355" y="25" width="805" height="200" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#6A3D8F;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ABSTRACT CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Adapter target &amp;middot; Strategy &amp;middot; built by AdapterFactory&amp;raquo; P1&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;b&gt;BrokerAdapter&lt;/b&gt;&lt;/font&gt; (src/adapters) &amp;mdash; read-only interface lock&lt;br&gt;fetch_open_orders() &amp;middot; fetch_order_status(broker_order_id) &amp;middot; &lt;b&gt;fetch_positions() &amp;rarr; list[PositionDTO]&lt;/b&gt; &amp;middot; &lt;b&gt;fetch_position_status(position_id)&lt;/b&gt; &amp;middot; fetch_account_snapshot() &amp;middot; &lt;b&gt;fetch_cash_flows(since_ms)&lt;/b&gt; &amp;middot; fetch_instruments() &amp;middot; stream_ticks(symbols) &amp;middot; ensure_ticks(symbols) &amp;middot; stream_order_updates() &amp;middot; &lt;b&gt;stream_positions()&lt;/b&gt; &amp;middot; stream_account()&lt;br&gt;&lt;b&gt;Instrument map:&lt;/b&gt; fetch_instruments() fills a private read-only &lt;i&gt;self._instruments: dict[str, InstrumentSpec]&lt;/i&gt; in SNAPSHOTTING, before any stream starts; to_notional() reads only that map&lt;br&gt;&lt;b&gt;Forbidden imports:&lt;/b&gt; src.db, src.cache, src.pubsub, src.integrity, src.oversee &amp;middot; never publishes or writes &amp;middot; transport = ReadOnlyTransport (P2) &amp;middot; &lt;font color='#B71C1C'&gt;&lt;b&gt;no mutation methods&lt;/b&gt;&lt;/font&gt;" tooltip="All read-only. fetch_position_status() lets resync and DLQ recovery re-read one position by id (StoneX GET order/{id}; cTrader deal list by position id)." id="arch-abc">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=2;" vertex="1" parent="arch-L2">
            <mxGeometry x="80" y="285" width="2080" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-cm2" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Contract&lt;/b&gt;&lt;br&gt;Adapters are pure translators: no db / cache / pubsub / integrity / oversee imports, no publishing, no writes.&lt;br&gt;&lt;br&gt;&lt;b&gt;New methods&lt;/b&gt;&lt;br&gt;fetch_account_snapshot() and stream_account() turn broker margin data into AccountDTO, so the server always holds a fresh account image. fetch_instruments() supplies InstrumentSpec, used to normalise every quantity to units.&lt;br&gt;&lt;br&gt;&lt;b&gt;Positions&lt;/b&gt;&lt;br&gt;Once an entry fills, the open position is its own entity (PositionDTO), so a stop moved or removed after the fill is still seen.&lt;br&gt;&lt;br&gt;&lt;b&gt;No risk on the DTO&lt;/b&gt;&lt;br&gt;Adapters can't see equity, so they never compute risk.&lt;br&gt;&lt;br&gt;&lt;b&gt;Extending&lt;/b&gt;&lt;br&gt;A new broker is one class registered in AdapterFactory." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L2">
          <mxGeometry x="2240" y="25" width="320" height="340" as="geometry" />
        </mxCell>
        <UserObject label="&amp;#9314; Non-Blocking Pub-Sub Bus" tooltip="Four isolated bounded queues plus the PostgreSQL-backed dead-letter path." id="arch-L3">
          <mxCell style="swimlane;horizontal=0;startSize=40;html=1;fontSize=15;fontStyle=1;collapsible=0;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="arch-1">
            <mxGeometry x="40" y="814" width="2580" height="662" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Publisher&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;Ingestion Orchestrator&lt;/b&gt;&lt;/font&gt; (sole publisher)&lt;br&gt;&lt;b&gt;Runs only on the leader node.&lt;/b&gt; Consumes adapter async iterators &amp;rarr; validates schema + checksum &amp;rarr; &lt;b&gt;stamps seq_id&lt;/b&gt; (HLC, re-seeded after each epoch bump, from PostgreSQL) and labels the version (clock domain, stream watermark for untimed REST rows; broker_ts &amp;gt; receipt + 5 s &amp;rarr; future_timestamp) &amp;rarr; routes by DTO type &amp;middot; put_nowait() only &amp;middot; never awaits subscribers or the database&lt;br&gt;QueueFull / invalid &amp;rarr; DlqSpooler.offer() (memory append, no I/O) &amp;middot; &lt;b&gt;never stops reading a socket&lt;/b&gt;: queue + ring both full &amp;rarr; adapter flag backpressure_overflow drops price frames at the parser and marks a gap, and DELs that stream's health key until resync reconciles; ring &amp;lt; 50 % &amp;rarr; SM4 RESYNCING&lt;br&gt;Per-stream health keys conn:{adapter_id}:{prices | orders (incl. positions) | account} (PEXPIRE 30 s), refreshed on transport heartbeats &lt;b&gt;only while that subscription is SUBSCRIBED&lt;/b&gt; (ack seen, no UNSUBSCRIBED / ERROR frame, socket still open; cTrader: from ProtoOAAccountAuthRes until AccountDisconnect / TokenInvalidated / ClientDisconnect); a lost socket resets every subscription on it, DELs its keys and sets stream_health.conn_lost_at (PostgreSQL; cleared once SUBSCRIBED and reconciled), which Oversee's fence reads; when flat, a REST fetch_account_snapshot() every 60 s proves the account path end to end &amp;middot; subscribes stream_ticks() to traded symbols &lt;b&gt;+ the FX crosses&lt;/b&gt; for every pnl_ccy &amp;rarr; account ccy; ensure_ticks() adds a symbol or cross first needed mid-session (page if no clean mid within 30 s)" tooltip="Only component allowed to publish; DLQ recovery re-submits through it too. One seq_id source means a restart or reconnect can never reset the counter. Keeping the socket drained means heartbeat and control frames are never stuck behind unread ticks. One TTL key per subscription means a live price stream can't hide a dead account stream, and Redis expiry replaces wall-clock comparisons. FX crosses are derived in SNAPSHOTTING from InstrumentSpec.pnl_ccy and AccountDTO.currency, e.g. AUDUSD for EURUSD traded on an AUD account." id="arch-orch">
          <mxCell style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="arch-L3">
            <mxGeometry x="80" y="25" width="1230" height="140" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Spooler &amp;middot; Dead Letter Channel&amp;raquo; P5&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DlqSpooler&lt;/b&gt; &lt;i&gt;(new)&lt;/i&gt;&lt;br&gt;offer() = in-memory append only (no I/O, no fsync)&lt;br&gt;flush() task: batch INSERT events_dlq; PostgreSQL down &amp;rarr; spill file via asyncio.to_thread (fsync off the loop); drained into events_dlq (idempotent on a payload hash) as soon as PostgreSQL accepts writes again, and at start-up; any node drains its own file (append-only, outside the epoch check)&lt;br&gt;ring full &amp;rarr; the adapter keeps reading but drops price frames (backpressure_overflow); order / position / account gap recovered by SM4 RESYNCING" tooltip="Keeps the event loop free of database and disk I/O: offer() is a list append. Only the flush task touches PostgreSQL or the disk, and the disk write runs in a worker thread. The socket is never left unread: pausing it would fill SO_RCVBUF, delay heartbeat frames and drop the connection." id="arch-spool">
          <mxCell style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="arch-L3">
            <mxGeometry x="1355" y="25" width="380" height="140" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;EventBus&lt;/b&gt; &amp;middot; P4" tooltip="All topics. Oversee does NOT subscribe here: it reads the post-commit Redis Stream oversee:feed, so it can never see an event before that event's state is committed." id="arch-bus">
          <mxCell style="rounded=1;arcSize=3;html=1;fillColor=none;strokeColor=#9673A6;dashed=1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#6A3D8F;" vertex="1" parent="arch-L3">
            <mxGeometry x="65" y="217" width="1260" height="240" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-q_price" value="&lt;span style='background-color:#1B6F66;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;OBJECT&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Topic &amp;middot; Bulkhead&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;market.price.dto : Topic[PriceDTO]&lt;/u&gt;&lt;/b&gt;&lt;br&gt;asyncio.Queue(maxsize=N)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D0F0EE;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
          <mxGeometry x="80" y="245" width="294" height="200" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#1B6F66;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;OBJECT&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Topic &amp;middot; Bulkhead&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;account.state.dto : Topic[AccountDTO | CashFlowDTO]&lt;/u&gt;&lt;/b&gt;&lt;br&gt;asyncio.Queue(maxsize=N) &amp;middot; overflow &amp;rarr; DLQ" tooltip="Account image updates; never mixed with orders or prices." id="arch-q_account">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D0F0EE;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
            <mxGeometry x="392" y="245" width="294" height="200" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#1B6F66;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;OBJECT&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Topic &amp;middot; Bulkhead&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;position.state.dto : Topic[PositionDTO]&lt;/u&gt;&lt;/b&gt; &lt;i&gt;(new)&lt;/i&gt;&lt;br&gt;asyncio.Queue(maxsize=N) &amp;middot; overflow &amp;rarr; DLQ" tooltip="Open positions (after a fill) and their stop-loss / take-profit, so Oversee keeps auditing risk after the entry order is FILLED." id="arch-q_position">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D0F0EE;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
            <mxGeometry x="704" y="245" width="294" height="200" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-q_order" value="&lt;span style='background-color:#1B6F66;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;OBJECT&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Topic &amp;middot; Bulkhead&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;&lt;u&gt;orders.internal.dto : Topic[OrderDTO]&lt;/u&gt;&lt;/b&gt;&lt;br&gt;asyncio.Queue(maxsize=N) &amp;middot; overflow &amp;rarr; DLQ" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D0F0EE;strokeColor=#2A9D8F;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
          <mxGeometry x="1016" y="245" width="294" height="200" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Dead Letter Channel&amp;raquo; P5&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;events_dlq&lt;/b&gt; (PostgreSQL)&lt;br&gt;order, position, account and cash-flow events parked when unacked, timed out, invalid, QueueFull or future_timestamp&lt;br&gt;event_type ORDER | POSITION | ACCOUNT | CASH_FLOW &amp;middot; origin_dlq_id (lineage) &amp;middot; retry_count &amp;middot; status &amp;middot; next_retry_at_ms &amp;middot; &lt;i&gt;stale versions are not parked: dropped and logged&lt;/i&gt;" tooltip="Lifecycle SM2 on page 3. Price ticks are never parked: only the latest tick per symbol matters." id="arch-dlq">
          <mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
            <mxGeometry x="1355" y="245" width="380" height="200" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-recovery" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Idempotent Retry&amp;raquo; P5&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;DLQ Recovery Worker&lt;/b&gt;&lt;br&gt;&lt;b&gt;start-up barrier:&lt;/b&gt; leases rows only for adapters in SM4 STREAMING (authenticated, instruments loaded); broker errors while not STREAMING don't count as retries&lt;br&gt;&amp;#9312; ask the broker first:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ORDER &amp;rarr; fetch_order_status(broker_order_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;POSITION &amp;rarr; fetch_position_status(position_id)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ACCOUNT &amp;rarr; fetch_account_snapshot()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;CASH_FLOW &amp;rarr; fetch_cash_flows(): converged only if its transaction_id is found&lt;br&gt;&amp;#9313; re-submit the broker's fresh row through the orchestrator with its lineage (origin_dlq_id); the parked payload is dropped&lt;br&gt;&amp;#9314; 5 failures (counted across re-parks of the same entity and error) or illegal transition &amp;rarr; quarantine" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="arch-L3">
          <mxGeometry x="1780" y="245" width="380" height="200" as="geometry" />
        </mxCell>
        <mxCell id="arch-sub_price" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Subscriber&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PriceSubscriber&lt;/b&gt;&lt;br&gt;latest PriceDTO per (adapter, symbol) &amp;rarr; Redis price:{adapter_id}:{symbol} and, for a tick within max_clean_spread, clean_mid:{adapter_id}:{symbol}, via a light script (no digest, no boot check, no feed entry); the RiskSweep reads both every second" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
          <mxGeometry x="80" y="507" width="294" height="130" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Subscriber &amp;middot; Projector&amp;raquo; P4&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;AccountImageProjector&lt;/b&gt;&lt;br&gt;&amp;#9312; commit account_state (current row; sampled history in account_snapshots) / cash_flows (dedupe on transaction_id)&lt;br&gt;&amp;#9313; then apply_state.lua &amp;rarr; Redis account:{id} + oversee:feed; a cash-flow commit XADDs its own ACCOUNT entry (its seq_id)&lt;br&gt;&amp;#9314; live margin fields &amp;rarr; account_live:{id} (coalesced, light script; no feed entry)" tooltip="Keeps the server-side account image that Oversee rules read. Redis is written only after the PostgreSQL commit, by the same Lua script that appends the oversee:feed entry." id="arch-acct_proj">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
            <mxGeometry x="392" y="507" width="294" height="130" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-pos_cons" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Subscriber &amp;middot; Unit of Work&amp;raquo; P4 P6&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;PositionStateConsumer&lt;/b&gt; &lt;i&gt;(new)&lt;/i&gt;&lt;br&gt;&amp;#9312; one txn: positions_state + outbox + event log&lt;br&gt;&amp;#9313; then apply_state.lua &amp;rarr; Redis position:{id} + oversee:feed" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
          <mxGeometry x="704" y="507" width="294" height="130" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Subscriber &amp;middot; Unit of Work&amp;raquo; P4 P6&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;OrderStateConsumer&lt;/b&gt;&lt;br&gt;&amp;#9312; one txn: orders_state + outbox + event log&lt;br&gt;&amp;#9313; then apply_state.lua &amp;rarr; Redis order:{id} + oversee:feed" tooltip="Keeps draining during a Redis heal: there is no symbol pause anywhere in the pipeline." id="arch-sub_order">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
            <mxGeometry x="1016" y="507" width="294" height="130" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-bp_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Backpressure&lt;/b&gt;&lt;br&gt;Order / position / account QueueFull &amp;rarr; DlqSpooler (never dropped, never awaited); unacked &amp;rarr; DLQ&lt;br&gt;Price QueueFull &amp;rarr; keep latest tick per symbol &lt;i&gt;(proposed)&lt;/i&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L3">
          <mxGeometry x="1355" y="507" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="arch-quarantine" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Poison Message&amp;raquo; P5&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;events_quarantine&lt;/b&gt; (PostgreSQL)&lt;br&gt;after 5 retries; manual review" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L3">
          <mxGeometry x="1780" y="507" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="arch-cm3" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Why four queues&lt;/b&gt;&lt;br&gt;One bounded queue per entity (Bulkhead): a price burst can't starve orders, positions or the account image. Cash flows travel with the account.&lt;br&gt;&lt;br&gt;&lt;b&gt;Never block&lt;/b&gt;&lt;br&gt;put_nowait() only; slow subscribers can't stall ingestion, and an overflow is handed to the DlqSpooler in memory, so a PostgreSQL write never sits on the hot path.&lt;br&gt;&lt;br&gt;&lt;b&gt;Failure path&lt;/b&gt;&lt;br&gt;Undeliverable order, position and account events are parked in events_dlq; recovery asks the broker first (order status, position by id or account snapshot) and re-submits the broker's fresh row through the orchestrator (still the sole publisher).&lt;br&gt;&lt;br&gt;&lt;b&gt;Oversee is not on the bus&lt;/b&gt;&lt;br&gt;It reads the post-commit feed in Redis, so it never sees an event before that event's state is committed." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L3">
          <mxGeometry x="2240" y="25" width="320" height="612" as="geometry" />
        </mxCell>
        <UserObject label="&amp;#9315; Tiered State: Redis &amp;gt; PostgreSQL &amp;gt; Image" tooltip="Redis is a deliberate, disposable copy; PostgreSQL is the source of truth; the image is the disaster copy." id="arch-L4">
          <mxCell style="swimlane;horizontal=0;startSize=40;html=1;fontSize=15;fontStyle=1;collapsible=0;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="arch-1">
            <mxGeometry x="40" y="1496" width="2580" height="555" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Cache-aside + Write-through &amp;middot; intentional duplicate&amp;raquo; P7&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;TIER 1 &amp;mdash; Redis (hot cache)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Deliberate copy of PostgreSQL for sub-millisecond reads (dashboards, hot-path lookups); the RiskSweep reads prices and live fields here and entity state from PostgreSQL&lt;br&gt;&lt;b&gt;Keys:&lt;/b&gt; order:{client_order_id} &amp;middot; &lt;b&gt;position:{position_id}&lt;/b&gt; &amp;middot; price:{adapter_id}:{symbol} &amp;middot; account:{account_id} &amp;middot; instrument:{adapter_id}:{symbol} &amp;middot; conn:{adapter_id}:{stream} (TTL) &amp;middot; state:digest &amp;middot; &lt;b&gt;halt:state&lt;/b&gt; = (effective_level, halt_event_id) &amp;middot; &lt;b&gt;redis:boot_id&lt;/b&gt; &amp;middot; &lt;b&gt;oversee:feed&lt;/b&gt; (Stream); no timer keys&lt;br&gt;&lt;b&gt;Every entity write = apply_state.lua&lt;/b&gt; (atomic): SET only if the incoming &lt;b&gt;version&lt;/b&gt; &amp;gt; stored (fixed-width strings, never tonumber()); same checksum = no-op that only advances the version; XADD oversee:feed only if the SET applied; XOR state:digest; boot_id missing &amp;rarr; NO_BOOT (not applied; SM8 re-applies it before boot_id) unless the caller holds redis:boot_lock&lt;br&gt;FLUSHDB (own database) at every LEADER_INIT; boot_id = run_id:epoch&lt;br&gt;price:{adapter_id}:{symbol}, clean_mid:{adapter_id}:{symbol} (only clean ticks), account_live:{id} and conn: use a separate light script (no digest, no boot check, no feed entries)&lt;br&gt;Feed bounded: trimmed to the oldest un-acked entry, hard cap MAXLEN ~ 1 M &amp;middot; maxmemory-policy noeviction&lt;br&gt;Never the source of truth; healed in place from Tier 2; rebuilt by SM8 after a restart (ActionGate fails closed meanwhile)" tooltip="Intentional duplication: data is written to PostgreSQL first and copied to Redis after commit. Because the copy and the feed entry are one Lua call, Oversee can never read a feed entry whose state is not already in Redis. The version compare stops a late writer, a stale REST read or the healer from overwriting newer state. noeviction means a full Redis rejects writes loudly instead of silently evicting order:/account: keys; a memory alert fires well before that. Losing Redis loses nothing durable (Oversee keeps no timers): halt:state and the feed are rebuilt from PostgreSQL by SM8, and ActionGate denies everything until then." id="arch-tier1">
          <mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=2.5;" vertex="1" parent="arch-L4">
            <mxGeometry x="80" y="50" width="520" height="220" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-tier2" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;CoR handler &amp;middot; Outbox &amp;middot; Event Log&amp;raquo; P7 P6&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;TIER 2 &amp;mdash; PostgreSQL&lt;/b&gt;&lt;/font&gt; (single source of truth)&lt;br&gt;114-trade baseline &amp;middot; orders_state &amp;middot; &lt;b&gt;positions_state&lt;/b&gt; &amp;middot; outbox_events &amp;middot; event log &amp;middot; &lt;b&gt;account_state&lt;/b&gt; + account_snapshots (history) &amp;middot; &lt;b&gt;cash_flows&lt;/b&gt; &amp;middot; &lt;b&gt;sod_marks&lt;/b&gt; &amp;middot; instruments &amp;middot; &lt;b&gt;halt_breaches&lt;/b&gt; (rule states) &amp;middot; oversee_events &amp;middot; halt_events &amp;middot; notification_outbox + dedupe &amp;middot; events_dlq / quarantine &amp;middot; &lt;b&gt;engine_epoch, leader_terms, cluster_state, last_clean_marks&lt;/b&gt;, adapter_auth_state, outbound_intent (Phase 2) &amp;middot; Patroni primary + sync standby" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=2.5;" vertex="1" parent="arch-L4">
          <mxGeometry x="800" y="50" width="660" height="220" as="geometry" />
        </mxCell>
        <mxCell id="arch-tier3" value="&lt;span style='background-color:#7B3F14;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;DATA STORE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Memento&amp;raquo; P7&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;TIER 3 &amp;mdash; Immutable Image Backup&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Snapshot + WAL archive from both Patroni members &amp;middot; for region DR and operator-run restores only; never restored automatically" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=9;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#EFE3D6;strokeColor=#A0522D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L4">
          <mxGeometry x="1660" y="50" width="500" height="220" as="geometry" />
        </mxCell>
        <mxCell id="arch-worker" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;State &amp;middot; Supervisor&amp;raquo; P8&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;&lt;b&gt;Integrity Reconciliation Worker&lt;/b&gt;&lt;/font&gt; (SM3, page 3)&lt;br&gt;Every INTEGRITY_CHECK_INTERVAL_SEC (5.0 s)&lt;br&gt;&lt;b&gt;Step 1&lt;/b&gt; Redis vs DB: rows committed in [last &amp;minus; MAX_TXN_MS, now &amp;minus; 500 ms] &amp;rarr; version + checksum vs Redis + rotating sweep of K keys; full XOR digest only when quiet; 2 ticks &amp;rarr; Redis behind: heal in place; Redis &lt;b&gt;ahead&lt;/b&gt;: alert, DEL, re-apply; halt:state id behind &amp;rarr; re-apply, ahead &amp;rarr; alert, DEL, re-apply; boot_id &amp;ne; run_id:epoch &amp;rarr; SM8&lt;br&gt;&lt;b&gt;Step 2&lt;/b&gt; PostgreSQL checksums + seq_id monotonicity (timeline / epoch aware) &amp;rarr; halt + page; primary-only damage &amp;rarr; Patroni switchover to the checked standby, else operator restore; then reconcile with the broker (prices resume first), then FLUSHDB &amp;rarr; SM8; resume after READY&lt;br&gt;&lt;b&gt;Owns SM8&lt;/b&gt; (single-flight, redis:boot_lock)" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="arch-L4">
          <mxGeometry x="800" y="360" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="arch-cm4" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Why duplicate into Redis?&lt;/b&gt;&lt;br&gt;Dashboards and hot-path lookups need the account image, positions and latest prices instantly, without loading PostgreSQL on every event.&lt;br&gt;&lt;br&gt;&lt;b&gt;Safe duplication&lt;/b&gt;&lt;br&gt;Write PostgreSQL first, copy to Redis after commit. If they disagree, PostgreSQL wins and Step 1 heals Redis in place.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why no pause&lt;/b&gt;&lt;br&gt;Pausing a symbol while the orchestrator keeps calling put_nowait() would fill the bounded queue and push valid events into the DLQ. The version compare in apply_state.lua lets the healer and live writers run at the same time: the newer version always wins.&lt;br&gt;&lt;br&gt;&lt;b&gt;If Redis restarts&lt;/b&gt;&lt;br&gt;Risk state is not lost: ActionGate denies everything until SM8 writes redis:boot_id, and SM8 rebuilds halt:state and the feed from PostgreSQL. The RiskSweep never depended on Redis entity keys, so oversight continues meanwhile.&lt;br&gt;&lt;br&gt;&lt;b&gt;Leader change&lt;/b&gt;&lt;br&gt;The new leader flushes its Redis and rebuilds it (SM8); nothing in a Redis from an earlier term is trusted.&lt;br&gt;&lt;br&gt;&lt;b&gt;Disaster copy&lt;/b&gt;&lt;br&gt;Tier 3 is only read during an operator-run restore." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L4">
          <mxGeometry x="2240" y="50" width="320" height="480" as="geometry" />
        </mxCell>
        <UserObject label="&amp;#9316; Oversee &amp;mdash; Risk Rules, Halt &amp;amp; Alerts" tooltip="Queue observer that evaluates pluggable risk rules against the account image." id="arch-L5">
          <mxCell style="swimlane;horizontal=0;startSize=40;html=1;fontSize=15;fontStyle=1;collapsible=0;fillColor=#FCE4EC;strokeColor=#C2185B;swimlaneFillColor=#FCFCFC;strokeWidth=2;fontColor=#1A1A1A;" vertex="1" parent="arch-1">
            <mxGeometry x="40" y="2071" width="2580" height="1530" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Observer &amp;middot; Level-triggered sweep&amp;raquo; P9&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:13px'&gt;&lt;b&gt;Oversee&lt;/b&gt;&lt;/font&gt; (observer of &lt;b&gt;committed&lt;/b&gt; state)&lt;br&gt;&amp;bull; &lt;b&gt;feed observer&lt;/b&gt;: reads Redis Stream &lt;b&gt;oversee:feed&lt;/b&gt; (XREADGROUP), &lt;b&gt;not&lt;/b&gt; the in-memory bus, and wakes the RiskSweep for that account at once; it decides nothing itself&lt;br&gt;&amp;bull; &lt;b&gt;RiskSweep&lt;/b&gt; (every 1 s and on wake-up), per account: a READ ONLY REPEATABLE READ snapshot from PostgreSQL + Redis price: / clean_mid: / account_live: &amp;rarr; every Rule plugin on every live entity; &lt;b&gt;most severe level wins&lt;/b&gt;&lt;br&gt;&amp;bull; writes, in a separate epoch-checked transaction: rule states (halt_breaches), oversee_events, the halt level, and the day's sod_marks row at the 17:00 roll&lt;br&gt;&amp;bull; deadlines are durable timestamps: &lt;b&gt;no timers&lt;/b&gt; to lose, push forward or race&lt;br&gt;&amp;bull; asks the orchestrator (never an adapter) for a cash-flow refresh on an unexplained balance drop&lt;br&gt;&amp;bull; rules share one set of pure risk functions (note at the bottom of this lane)" tooltip="Supervised asyncio tasks (feed observer, RiskSweep, claim / trim), each stamping its liveness; they never block ingestion. The sweep reads entity state from PostgreSQL, so it keeps running while SM8 rebuilds Redis; only the feed observer waits for READY." id="arch-oversee">
          <mxCell style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;strokeWidth=2;" vertex="1" parent="arch-L5">
            <mxGeometry x="80" y="25" width="805" height="480" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-rules" value="&lt;b&gt;Rule plugins&lt;/b&gt; &amp;middot; Strategy (P9) &amp;middot; loaded by RuleRegistry from config" style="rounded=1;arcSize=3;html=1;fillColor=none;strokeColor=#0B6E99;dashed=1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fontColor=#0B6E99;" vertex="1" parent="arch-L5">
          <mxGeometry x="930" y="25" width="1230" height="480" as="geometry" />
        </mxCell>
        <mxCell id="arch-rule_if" value="&lt;span style='background-color:#2B5797;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;INTERFACE&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Strategy&amp;raquo; P9&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Rule&lt;/b&gt; &amp;mdash; evaluate(snapshot, subject) &amp;rarr; Result{level PASS | FLAG | SOFT_HALT | HARD_HALT, cap (none, or SOFT when an input is stale), reason, risk_pct?} or UNKNOWN &amp;middot; each rule has its own confirm_ms &amp;middot; subject = the account, or an order / position" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="1210" y="55" width="700" height="50" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Rule plugin&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MaxPositionRiskRule&lt;/b&gt; (1R = 1.0 % equity)&lt;br&gt;risk() of each order (ordered_units; for a reduce-only order only its opening_units) and each OPEN position, as % of equity_mark:&lt;br&gt;&amp;bull; &amp;le; 1.0 % &amp;rarr; PASS&lt;br&gt;&amp;bull; 1.0&amp;ndash;1.5 % &amp;rarr; &lt;b&gt;FLAG&lt;/b&gt; (slippage, spread, SL move: audit)&lt;br&gt;&amp;bull; &amp;gt; 1.5 % &amp;rarr; &lt;b&gt;SOFT_HALT&lt;/b&gt;&lt;br&gt;&amp;bull; UNKNOWN (no spec / no mid) &amp;rarr; capped &lt;b&gt;SOFT_HALT&lt;/b&gt; after 30 s" tooltip="Banded: the 1R cap (1.0 %) is the SOP limit; up to 1.5 % is tolerated variance and logged; above 1.5 % is a breach. Re-evaluated by every sweep, so a widened stop or a falling equity_mark is caught without any new event. Only the opening part of an order is checked (reducing units carry no risk). The computed risk % is stored with the verdict; it is never on the DTO." id="arch-r_size">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=2;" vertex="1" parent="arch-L5">
            <mxGeometry x="945" y="160" width="232" height="330" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Rule plugin&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MaxAggregateOpenRiskRule&lt;/b&gt;&lt;br&gt;&amp;Sigma; risk() over the &lt;b&gt;opening&lt;/b&gt; units only: remaining &amp;minus; reducing units of WORKING / PARTIALLY_FILLED orders + OPEN positions; no netting; active once the sweep has seen it for confirm_ms (1 s), released after 5 s below the band by a 10 % margin:&lt;br&gt;&amp;bull; &amp;gt; 2.0 % &amp;rarr; &lt;b&gt;FLAG&lt;/b&gt;&lt;br&gt;&amp;bull; &amp;gt; 3.0 % &amp;rarr; &lt;b&gt;SOFT_HALT&lt;/b&gt; &lt;i&gt;(example)&lt;/i&gt;" tooltip="Catches split or duplicated orders: three 0.9 % orders each pass MaxPositionRiskRule but sum to 2.7 %. remaining_units (not ordered_units) avoids counting a partial fill twice, and the 1 s confirm absorbs the moment when a fill is committed as both an order and a position." id="arch-r_agg">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;strokeWidth=2;" vertex="1" parent="arch-L5">
            <mxGeometry x="1189" y="160" width="232" height="330" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Rule plugin&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MissingStopLossRule&lt;/b&gt;&lt;br&gt;for every entity where needs_stop() and effective_stop() is None (opening orders &lt;b&gt;and&lt;/b&gt; OPEN positions):&lt;br&gt;&amp;bull; the RiskSweep writes effective_stop_missing_since_ms in PostgreSQL the first time it sees it, and clears it when a stop appears&lt;br&gt;&amp;bull; now &amp;minus; since &amp;ge; grace (2 s) &amp;rarr; &lt;b&gt;SOFT_HALT&lt;/b&gt;; released once an effective stop has been seen for 5 s (at once if the entity is terminal or CLOSED)&lt;br&gt;&amp;bull; a linked child change wakes the sweep for the whole account, so the parent is re-checked at once" tooltip="The grace window covers brokers that attach the stop-loss in a second message. The deadline is a durable PostgreSQL timestamp checked every second, so a restart or leader change can't lose or postpone it, and no further event is needed for it to fire." id="arch-r_sl">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
            <mxGeometry x="1433" y="160" width="232" height="330" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Rule plugin&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MaxDailyLossRule&lt;/b&gt;&lt;br&gt;(equity_mark &amp;minus; sod_equity &amp;minus; net_transfers_today) / sod_equity &amp;lt; &amp;minus;3 % &amp;rarr; HARD_HALT &lt;i&gt;(example)&lt;/i&gt; once seen for confirm_ms (1 s) with clean, uncapped inputs; a stale mark or partial_session caps it at SOFT; the subject is (account, trading_day)&lt;br&gt;&amp;bull; re-run by every sweep against current prices; capped at SOFT while a position change is newer than the balance (cross-stream skew)&lt;br&gt;&amp;bull; one marking function all day (clean mid); broker equity is only a cross-check (FLAG equity_divergence)&lt;br&gt;&amp;bull; day roll 17:00 America/New_York: the first sweep pass after it writes the sod row (inputs + the unexplained increase excluded at the roll); an unexplained decrease triggers fetch_cash_flows&lt;br&gt;&amp;bull; transfers = DEPOSIT / WITHDRAWAL whose effect is not in sod_equity; TRADE_PNL / FINANCING / COMMISSION / ADJUSTMENT are P&amp;amp;L; an unexplained decrease is a loss, an unexplained increase is ignored until explained (FLAG); no transfer source &amp;rarr; transfers_unverified" tooltip="A clean mid ignores the 17:00 rollover spread blow-out, and swaps / commissions are part of the mark, so neither can masquerade as a transfer or a loss. A deposit explained only after the roll counts as today's transfer, so it can't hide a loss. With no transfer source a real withdrawal trips HARD_HALT: that fails safe." id="arch-r_loss">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
            <mxGeometry x="1677" y="160" width="232" height="330" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-r_margin" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Rule plugin&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MarginUsageRule&lt;/b&gt;&lt;br&gt;margin_used / equity_mark &amp;gt; 80 % &amp;rarr; FLAG; &amp;gt; 95 % &amp;rarr; SOFT_HALT &lt;i&gt;(example)&lt;/i&gt;&lt;br&gt;evaluated by every sweep from account_live:{id}; a missing or sampled field is UNKNOWN" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="1921" y="160" width="232" height="330" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Circuit Breaker &amp;middot; kill switch&amp;raquo; P11&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;HaltSwitch&lt;/b&gt;&lt;br&gt;level NONE | SOFT | HARD &amp;middot; PostgreSQL halt_events is the truth&lt;br&gt;Redis halt:state = (effective_level, halt_event_id), written only by a CAS script (newer event id wins)&lt;br&gt;set only by the RiskSweep after each complete pass: HARD if a state is HARD or the HARD latch is set; a SOFT state whose accumulated uncapped time reaches T &amp;rarr; HARD (capped spells pause it); SOFT &amp;rarr; NONE after cool_down with none active&lt;br&gt;operator clear() releases the latch; refused while the latest pass shows an active HARD state" tooltip="Lifecycle SM5 on page 3. One advisory lock serialises trip() and clear(). Every integrity tick compares halt_event_id with MAX(halt_events.id): behind is re-applied through the CAS; ahead (only after a restore) is alerted, DELeted and re-applied, so a lost or stale value can't open the gate." id="arch-halt">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
            <mxGeometry x="80" y="575" width="380" height="150" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-gate" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Gatekeeper&amp;raquo; P11&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ActionGate&lt;/b&gt;&lt;br&gt;allow(action) before every outbound action&lt;br&gt;SOFT: deny risk-increasing, allow risk-reducing&lt;br&gt;HARD: deny all until operator reset&lt;br&gt;&lt;b&gt;fail-closed:&lt;/b&gt; deny unless redis:boot_id = run_id:epoch, halt:state is present and its event id = MAX(halt_events.id), this node's epoch = engine_epoch and its lease is valid; any Redis / PostgreSQL error &amp;rarr; deny. Risk-increasing also needs the takeover settle window passed, the account reconciled after the latest open, no stale_mark symbol, no UNKNOWN result, and a RiskSweep pass over the account less than 3 s old (canonical list: oversee-rules.md &amp;sect;8)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="505" y="575" width="380" height="150" as="geometry" />
        </mxCell>
        <UserObject label="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Phase 2 &amp;middot; LOCKED&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;ExecutionGateway&lt;/b&gt; &lt;i&gt;(future)&lt;/i&gt;&lt;br&gt;does not exist in Phase 1. Contract: ActionGate.allow() &amp;rarr; commit outbound_intent (epoch) &amp;rarr; lease check with no await &amp;rarr; socket write; after a takeover the gate stays shut for TTL + TCP_USER_TIMEOUT + ack timeout and earlier-epoch SENDING intents become UNKNOWN (never re-sent)" tooltip="Shown only to fix the contract for Phase 2. Blocked today by the Execution Lockout Guard." id="arch-execgw">
          <mxCell style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;dashed=1;opacity=70;fillColor=#F2F2F2;strokeColor=#B71C1C;" vertex="1" parent="arch-L5">
            <mxGeometry x="930" y="575" width="380" height="150" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="arch-disp" value="&lt;span style='background-color:#AD1457;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;ACTIVE CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;Strategy channels &amp;middot; Outbox&amp;raquo; P10&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;NotificationDispatcher&lt;/b&gt;&lt;br&gt;alert = verdict + rule + account image excerpt&lt;br&gt;one alert per state episode (activate / rise), re-page every T unless acknowledged; state kept in PostgreSQL so a new leader doesn't re-send; only the level-raising trip() alert bypasses it&lt;br&gt;routing: FLAG &amp;rarr; email &amp;middot; SOFT/HARD &amp;rarr; email + mobile push&lt;br&gt;reliable via notification_outbox (SM6, page 3); channel credentials from Secrets Manager, re-read on an auth error" style="shape=process;fixedSize=1;size=7;backgroundOutline=1;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FCE4EC;strokeColor=#C2185B;strokeWidth=1.5;fontColor=#1A1A1A;spacingLeft=14;" vertex="1" parent="arch-L5">
          <mxGeometry x="1355" y="575" width="805" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arch-ch_email" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;NotificationChannel&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;EmailChannel&lt;/b&gt;&lt;br&gt;SMTP / SES" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="1355" y="775" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arch-ch_push" value="&lt;span style='background-color:#2E7D32;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;CLASS&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;NotificationChannel&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;MobilePushChannel&lt;/b&gt;&lt;br&gt;FCM / APNs / Telegram bot" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="1780" y="775" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arch-x_smtp" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Email provider&lt;/b&gt; (operator, risk manager)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="1355" y="875" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="arch-x_push" value="&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt; &lt;font color='#0B6E99' style='font-size:9px'&gt;&lt;i&gt;&amp;laquo;external system&amp;raquo;&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;b&gt;Mobile push provider&lt;/b&gt; (on-call phone)" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="arch-L5">
          <mxGeometry x="1780" y="875" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="arch-verdicts" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Halt level &amp;rarr; effect on actions&lt;/b&gt;&lt;table style='border-collapse:collapse;font-size:10px;margin-top:3px'&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Level&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Log&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Notify&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;New order to API&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;Risk-reducing&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;PASS&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&amp;ndash;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&amp;ndash;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;allowed&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;allowed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;FLAG&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;halt_breaches + oversee_events&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;email&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;allowed&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;allowed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;SOFT_HALT&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;+ halt_breaches&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;email + push&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;blocked&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;allowed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;HARD_HALT&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;+ halt_breaches&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;email + push (high)&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;blocked&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #D6B656;padding:2px 4px'&gt;&lt;b&gt;blocked&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;FLAG examples: risk 1.0&amp;ndash;1.5 % of equity, stale account image, equity_divergence, unexplained_balance_delta. halt_events gets a row only when trip() raises the level or clear() lowers it. Phase 1 sends nothing, so halts are logged, alerted and held in halt:state for Phase 2." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L5">
          <mxGeometry x="80" y="775" width="805" height="380" as="geometry" />
        </mxCell>
        <mxCell id="arch-rule_cfg" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Example rule config&lt;/b&gt;&lt;br&gt;&lt;font face='monospace' style='font-size:9px'&gt;rules:&lt;br&gt;&amp;nbsp;&amp;nbsp;max_position_risk:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;flag_above_pct_equity: 1.0 &amp;nbsp;# 1R&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;halt_above_pct_equity: 1.5&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on_breach: SOFT_HALT&lt;br&gt;&amp;nbsp;&amp;nbsp;max_aggregate_open_risk:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;flag_above_pct_equity: 2.0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;halt_above_pct_equity: 3.0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;confirm_ms: 1000&lt;br&gt;&amp;nbsp;&amp;nbsp;missing_stop_loss:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;grace_ms: 2000&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on_breach: SOFT_HALT&lt;br&gt;&amp;nbsp;&amp;nbsp;max_daily_loss:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;limit_pct_of_sod_equity: 3.0&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;confirm_ms: 1000&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;on_breach: HARD_HALT&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;day_roll: &quot;17:00 America/New_York&quot;&lt;br&gt;&amp;nbsp;&amp;nbsp;soft_halt:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;escalate_after_ms: 900000&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;cool_down_ms: 300000&lt;br&gt;marks:&lt;br&gt;&amp;nbsp;&amp;nbsp;max_clean_spread_pips: {EURUSD: 3.0}&lt;br&gt;&amp;nbsp;&amp;nbsp;stale_mark_ms: 5000&lt;br&gt;sweep:&lt;br&gt;&amp;nbsp;&amp;nbsp;interval_ms: 1000&lt;br&gt;&amp;nbsp;&amp;nbsp;release_ms: 5000 &amp;nbsp;# margin 10 %&lt;br&gt;&amp;nbsp;&amp;nbsp;unknown_grace_ms: 30000&lt;br&gt;&amp;nbsp;&amp;nbsp;account_fence_timeout_ms: 10000&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L5">
          <mxGeometry x="930" y="775" width="380" height="380" as="geometry" />
        </mxCell>
        <mxCell id="arch-ov_rt" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Oversee runtime guarantees&lt;/b&gt; (P9)&lt;br&gt;&lt;b&gt;&amp;#9312; Level-triggered, no timers.&lt;/b&gt; The RiskSweep re-evaluates every account every second (and at once when the feed observer wakes it) from one PostgreSQL REPEATABLE READ snapshot plus Redis prices and live fields read with their timestamps. Rule states (halt_breaches) and the halt level are recomputed, not accumulated: a state is &lt;b&gt;active&lt;/b&gt; once seen for its rule's confirm_ms, takes the latest level within its cap (a stale or estimated input caps at SOFT; HARD needs uncapped inputs), and lowers or resolves only after staying below its level by a 10 % release margin for 5 s (no flapping). UNKNOWN inputs change nothing for 30 s (unknown_since), then give a capped SOFT state. Escalation uses each state's accumulated uncapped_ms, which capped spells and FLAG lowerings pause but never reset. Every deadline is a durable PostgreSQL value (stop_watch, halt_breaches, stream_health), so nothing can be lost, pushed forward or raced. The snapshot is READ ONLY; writes go in a separate epoch-checked transaction. Passes are per account: one that fails changes nothing for that account, and 10 s without a good pass gives a capped SOFT evaluation_failed state.&lt;br&gt;&lt;b&gt;&amp;#9313; Crash recovery.&lt;/b&gt; The sweep keeps no state outside PostgreSQL, so a restart or leader change resumes at the next pass. Feed: on start-up and every 30 s XAUTOCLAIM entries idle &amp;gt; 30 s; an entry delivered 5 times is quarantined with an alert (it only loses its wake-up; the next pass still runs).&lt;br&gt;&lt;b&gt;&amp;#9314; Bounded feed.&lt;/b&gt; Every 10 s: XTRIM oversee:feed MINID = oldest un-acked entry. XADD also carries a hard cap MAXLEN ~ 1 000 000; group lag &amp;gt; 50 % of the cap raises an alert.&lt;br&gt;&lt;b&gt;&amp;#9315; Fence by account-stream health, not image age.&lt;/b&gt; The account image counts as current while every stream of its adapter is SUBSCRIBED and reconciled in this term; stream_health.conn_lost_at records when one left, and every takeover starts with it set (durable). conn:{adapter_id}:account is refreshed by transport heartbeats only while the account subscription is SUBSCRIBED (cTrader: from ProtoOAAccountAuthRes until AccountDisconnect / TokenInvalidated / ClientDisconnect); Redis expires it otherwise, and the 60 s REST poll on a flat account never refreshes it. Lost for longer than ACCOUNT_FENCE_TIMEOUT_MS (10 s) &amp;rarr; FLAG stale_account_image, and that account's results are capped at SOFT (also during an SM3 incident).&lt;br&gt;&lt;b&gt;&amp;#9316; Idempotent by construction.&lt;/b&gt; Each transition writes one oversee_events row keyed (rule_id, subject, transition, sweep_id); replays, heals and re-feeds produce no transition, so they can't double-alert. One alert per state episode, re-paged every T unless acknowledged. A ruleset reload wakes every account and resolves the states of removed rules.&lt;br&gt;&lt;b&gt;&amp;#9317; Redis restart.&lt;/b&gt; redis:boot_id holds Redis's run_id:epoch and is written &lt;b&gt;last&lt;/b&gt; by SM8, after the queued NO_BOOT writes. Until then ActionGate denies everything and the feed observer waits; the RiskSweep keeps running from PostgreSQL." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L5">
          <mxGeometry x="80" y="1195" width="2080" height="150" as="geometry" />
        </mxCell>
        <mxCell id="arch-risk_defs" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Shared risk definitions&lt;/b&gt; (pure functions every rule uses)&lt;br&gt;&lt;b&gt;risk(e)&lt;/b&gt; is directional and floored at 0: BUY (entry &amp;minus; stop) &amp;times; units, SELL (stop &amp;minus; entry) &amp;times; units, then &amp;times; FX(pnl_ccy &amp;rarr; account currency) at a clean mid. A stop at or past breakeven counts 0. UNKNOWN only for a missing InstrumentSpec, a WORKING order whose stop is on the wrong side, or no mid ever seen. Prices are per (adapter, symbol).&lt;br&gt;&lt;b&gt;effective_stop(e)&lt;/b&gt; = e's own stop_loss (cTrader native), else the non-terminal linked reduce-only stop children, counted only when their remaining units cover e's units, else None.&lt;br&gt;&lt;b&gt;needs_stop(e)&lt;/b&gt; = an OPEN position, or a PENDING / WORKING / PARTIALLY_FILLED order with opening units (remaining &amp;minus; reducing &amp;gt; 0). Terminal orders and CLOSED positions never need a stop, and their breaches resolve.&lt;br&gt;&lt;b&gt;reducing_units(order)&lt;/b&gt; = 0 unless is_reduce_only (explicit broker evidence only); then min(remaining_units, units of its linked entity: the OPEN position on the same symbol and opposite side, or the still-pending parent entry). That part carries 0 risk and needs no stop; any excess is opening.&lt;br&gt;&lt;b&gt;clean mid&lt;/b&gt; = last mid with spread &amp;le; max_clean_spread (rule config, pips). While the symbol is closed or in its roll break (SM10), the last clean mid before the break is used with FLAG stale_mark (never UNKNOWN). While OPEN and ticking but without a clean quote for longer than stale_mark_ms, positions are marked at the liquidation side of the latest raw quote (bid for longs, ask for shorts); with no quote at all for that long, the last mid is used with FLAG stale_mark (a frozen feed is never clean). Every stale case caps results at SOFT; HARD needs a clean mid. Last clean mids persist in PostgreSQL last_clean_marks, so a new leader is never blind. &lt;b&gt;equity_mark&lt;/b&gt; = balance + &amp;Sigma; OPEN positions (P&amp;amp;L at clean mid + swap and commission not yet booked to the balance), converted at clean cross mids, minus unexplained balance increases. &lt;b&gt;sod_equity&lt;/b&gt; = equity_mark from the last clean mids before the 17:00 New York roll (mids and times stored in sod_marks). No mid ever &amp;rarr; UNKNOWN (mark_unknown), never HARD_HALT." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L5">
          <mxGeometry x="80" y="1375" width="2080" height="130" as="geometry" />
        </mxCell>
        <mxCell id="arch-cm5" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;What Oversee is&lt;/b&gt;&lt;br&gt;A queue observer of &lt;b&gt;committed&lt;/b&gt; state plus a level-triggered &lt;b&gt;RiskSweep&lt;/b&gt;. The observer reads oversee:feed (appended in the same atomic step that copies state into Redis) and wakes the sweep for that account; the sweep re-evaluates every account every second from one PostgreSQL snapshot plus current prices.&lt;br&gt;&lt;br&gt;&lt;b&gt;Rules are plugins&lt;/b&gt;&lt;br&gt;Each rule is a Strategy class with its own thresholds and confirm_ms; adding one never touches Oversee.&lt;br&gt;&lt;br&gt;&lt;b&gt;Soft vs hard&lt;/b&gt;&lt;br&gt;SOFT blocks risk-increasing actions while a SOFT state is active, plus cool-down; a SOFT state whose accumulated uncapped time reaches T escalates to HARD (capped spells pause the clock). HARD blocks everything until an operator clear(), which is refused while the condition is still HARD.&lt;br&gt;&lt;br&gt;&lt;b&gt;Alerts&lt;/b&gt;&lt;br&gt;Email for flags; email + mobile push for halts.&lt;br&gt;&lt;br&gt;&lt;b&gt;No timers&lt;/b&gt;&lt;br&gt;Every deadline is a durable timestamp checked each second, so nothing is lost on a restart or a leader change, and a replay can't double-alert.&lt;br&gt;&lt;br&gt;&lt;b&gt;Testing&lt;/b&gt;&lt;br&gt;Mock broker fixtures: risk 1.2 % &amp;rarr; FLAG; 2 % &amp;rarr; SOFT_HALT; EUR/USD on an AUD account uses the AUD/USD cross; no stop-loss after the grace window &amp;rarr; SOFT_HALT, also across a restart; dead account stream &amp;rarr; FLAG; aggregate 3.2 % &amp;rarr; SOFT, then 1.2 % &amp;rarr; resolved, no escalation." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="arch-L5">
          <mxGeometry x="2240" y="25" width="320" height="1480" as="geometry" />
        </mxCell>
