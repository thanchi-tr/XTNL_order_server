        </UserObject>
        <mxCell id="sm-n_del" value="&lt;b&gt;DELIVERED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;provider accepted&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#2E7D32;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S6">
