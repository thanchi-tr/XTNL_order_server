              <mxPoint x="1910" y="326" />
              <mxPoint x="1910" y="386.0" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="pat-F4" value="P4 &amp;middot; Publish&amp;ndash;Subscribe (Observer) + Bulkhead" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#E6F2F8;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;dashed=1;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="pat-1">
