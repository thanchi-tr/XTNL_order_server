        <mxCell id="sm-p4" value="SL / TP moved, partial close [version &amp;gt; last]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.2308;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.7692;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-p_open" target="sm-p_open">
