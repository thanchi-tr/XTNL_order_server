          <mxCell style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#B46504;fontColor=#B46504;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.2174;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2174;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-a_str" target="sm-a_rsy">
