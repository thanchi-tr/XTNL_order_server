        <mxCell id="pat-fcm" value="&lt;div style='text-align:center'&gt;&lt;span style='background-color:#4D4D4D;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;EXTERNAL SYSTEM&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;FCM / APNs&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#F2F2F2;strokeColor=#7A7A7A;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingTop=2;" vertex="1" parent="pat-F10">
          <mxGeometry x="560" y="376" width="140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pat-n10" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Strategy&lt;/b&gt;: each channel is a plugin behind NotificationChannel. &lt;b&gt;Outbox&lt;/b&gt;: alerts are written first and sent by a worker, so a crash can't lose a halt alert. &lt;b&gt;Dedupe&lt;/b&gt; per state episode (plus the rules' release hysteresis) stops a flapping rule from spamming; only the level-raising trip() alert bypasses dedupe." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="pat-F10">
          <mxGeometry x="20" y="496" width="680" height="70" as="geometry" />
        </mxCell>
