        <mxCell id="sm-d4" value="[STREAMING, not converged&lt;br&gt;or error, retry_count &amp;lt; 5]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7B4F96;fontColor=#7B4F96;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.3043;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3043;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-d_chk" target="sm-d_bo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-d5" value="/ re-queue" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7B4F96;fontColor=#7B4F96;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-d_bo" target="sm-d_q">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1330" y="505" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm-d9" value="[lease expired or adapter left STREAMING] / no retry++" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7B4F96;fontColor=#7B4F96;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.2174;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-d_chk" target="sm-d_q">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1600" y="195" />
              <mxPoint x="1330" y="195" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm-d6" value="[converged and illegal, or&lt;br&gt;failed and retry_count &amp;ge; 5]" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#7B4F96;fontColor=#7B4F96;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=0.8261;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-d_chk" target="sm-d_quar">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1740" y="400" />
              <mxPoint x="1990" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sm-d7" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-d_rep" target="sm-d_f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-d8" value="" style="html=1;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333333;fontColor=#333333;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="sm-1" source="sm-d_quar" target="sm-d_f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sm-d_note" value="&lt;span style='background-color:#8A6D00;color:#FFFFFF;font-size:8px;font-weight:bold;padding:1px 4px;border-radius:3px;'&gt;&amp;nbsp;COMMENT&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;b&gt;Entry:&lt;/b&gt; an order, position, account or cash-flow event is parked when unacked, timed out, schema/checksum-invalid, QueueFull or future_timestamp (event_type ORDER | POSITION | ACCOUNT | CASH_FLOW); a stale (lower) version is never parked. QueueFull and invalid events arrive through the DlqSpooler, so the publisher never waits. &lt;b&gt;[due]&lt;/b&gt; = now &amp;ge; next_retry_at_ms. &lt;b&gt;Start-up barrier&lt;/b&gt;: a row is leased only while its adapter is STREAMING (SM4), so spill-file rows drained after an outage or at start-up can't burn retries on an unauthenticated session. &lt;b&gt;[converged]&lt;/b&gt; = the broker's row for that id (order status, position by id, a fresh account snapshot, or the cash flow found by transaction_id) was read. That fresh row is re-submitted with its own version (the higher version wins) and its lineage (origin_dlq_id), and the parked payload is dropped; if it is parked again with the same deterministic error (schema, checksum, future_timestamp, illegal transition), retry_count keeps counting, so a row that is invalid every time is quarantined after 5; transient errors (QueueFull, timeout) start a fresh count and page after 15 min. A converged row whose error was an illegal transition is quarantined at once. Re-submission goes through the orchestrator, which stays the sole publisher. State names are proposed values for &lt;i&gt;events_dlq.status&lt;/i&gt;." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;fillColor=#FFF9DB;strokeColor=#D6B656;strokeWidth=1.5;fontColor=#1A1A1A;spacingRight=14;" vertex="1" parent="sm-S2">
          <mxGeometry x="20" y="540" width="1040" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sm-S3" value="SM3 &amp;middot; Integrity Reconciliation Worker (Supervisor)" style="swimlane;startSize=30;html=1;fontSize=13;fontStyle=1;collapsible=0;rounded=1;arcSize=2;fillColor=#D5E8D4;strokeColor=#0B6E99;swimlaneFillColor=#FFFFFF;strokeWidth=1.5;fontColor=#1A1A1A;align=left;spacingLeft=10;" vertex="1" parent="sm-1">
          <mxGeometry x="40" y="800" width="1100" height="780" as="geometry" />
        </mxCell>
        <mxCell id="sm-i_init" value="" style="ellipse;html=1;fillColor=#1A1A1A;strokeColor=#1A1A1A;" vertex="1" parent="sm-S3">
          <mxGeometry x="20" y="153" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sm-i_idle" value="&lt;b&gt;IDLE&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
          <mxGeometry x="90" y="135" width="170" height="60" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;CHECK_REDIS_VS_DB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;Step 1 &amp;middot; commit window + sweep;&lt;br&gt;halt id, boot_id&lt;/font&gt;" tooltip="Rows committed in [last check - MAX_TXN_MS, now - 500 ms] (commit time, so a long transaction that commits late is still seen) are compared with Redis on version + checksum; Redis behind OR ahead of PostgreSQL's current row is a mismatch. A rotating sweep of K keys per tick covers keys that rarely change. The commutative XOR digest is compared only when no entity write (apply_state.lua) happened for 500 ms, so a live write can't make it differ. Each tick also checks halt:state's event id against MAX(halt_events.id) and redis:boot_id against INFO run_id + epoch (a mismatch starts SM8)." id="sm-i_ccd">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
            <mxGeometry x="360" y="130" width="210" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-i_cdi" value="&lt;b&gt;CHECK_DB_INTEGRITY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;Step 2 &amp;middot; checksums + seq_id monotonic&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#4D4D4D;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
          <mxGeometry x="680" y="130" width="210" height="70" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HEALING_REDIS&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;do / re-apply drifted keys via&lt;br&gt;apply_state.lua (version CAS);&lt;br&gt;&lt;b&gt;no pause&lt;/b&gt;, ingestion continues&lt;/font&gt;" tooltip="Drifted keys are re-applied from PostgreSQL through apply_state.lua, the same script live writers use: SET only if the stored version is lower (Redis ahead is resolved by DEL + re-apply). Ingestion and consumers keep running; no symbol is paused, so the bounded queues can't fill and spill valid events into the DLQ." id="sm-i_hyd">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
            <mxGeometry x="360" y="300" width="210" height="90" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HALTED&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;entry / halt ingestion; critical alert&lt;/font&gt;" tooltip="All ingestion stops and a critical alert is raised. Primary-only damage leads to a switchover; damage on both members leads to MANUAL_INTERVENTION." id="sm-i_halt">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
            <mxGeometry x="680" y="310" width="210" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;SWITCHING_OVER&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;do / Patroni switchover to the&lt;br&gt;checked sync standby; reinit bad member&lt;/font&gt;" tooltip="Only for damage confined to the primary: the sync standby is checked the same way first, then Patroni switches over and the bad member is re-initialised. The engine never restores PostgreSQL itself." id="sm-i_rest">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#F8CECC;strokeColor=#B71C1C;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
            <mxGeometry x="680" y="470" width="210" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;RECONCILING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;do / prices resume; reconcile orders,&lt;br&gt;positions, account, cash flows&lt;br&gt;(absent &amp;rarr; by id); then FLUSHDB &amp;rarr; SM8&lt;/font&gt;" tooltip="Restored state is compared with the broker: open orders, positions and a fresh account snapshot. Anything still open locally but absent from the broker lists is re-read by id, never closed on absence. Prices resume first (sockets stay drained); after the broker reconcile is committed, Redis is flushed and SM8 rebuilds it; ingestion resumes only after SM8 READY. Until the reconcile commits, the RiskSweep caps every result at SOFT (FLAG stale_account_image), so the restored, possibly stale image can't latch a HARD or clear a real state." id="sm-i_rec">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#B58B00;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
            <mxGeometry x="360" y="465" width="210" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="sm-i_man" value="&lt;b&gt;MANUAL_&lt;br&gt;INTERVENTION&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px' color='#555555'&gt;page; operator Tier 3&lt;br&gt;restore runbook&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=#EEEEEE;strokeColor=#666666;strokeWidth=1.5;fontColor=#1A1A1A;" vertex="1" parent="sm-S3">
          <mxGeometry x="950" y="470" width="130" height="70" as="geometry" />
        </mxCell>
