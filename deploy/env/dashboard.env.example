# XTNL read-only dashboard (Melbourne host; src/dashboard, deploy/systemd/xtnl-dashboard.service):
# /etc/xtnl/dashboard.env, 0640 root:xtnl. Replace every CHANGE_ME from Secrets Manager (ap-southeast-4).
# Read-only everywhere: PostgreSQL role xtnl_dashboard (every session default_transaction_read_only = on, a
# writable role is refused at connect), Redis ACL user xtnl_dashboard (GET / HGETALL only). Never put the
# engine's credentials here. Install: docs/runbooks/install-node.md "Melbourne dashboard host".

# PostgreSQL over the VPN (pg_hba: hostssl xtnl xtnl_dashboard ${VPN_CIDR}); both members, the primary or the
# standby answers (reads only).
XTNL_DASHBOARD_DSN=postgresql://xtnl_dashboard:CHANGE_ME@10.0.1.10:5432,10.0.2.10:5432/xtnl?sslmode=verify-full&sslrootcert=/etc/xtnl/dashboard/ca.crt

# Both nodes' Redis through each node's TLS proxy (deploy/redis/redis-tls-proxy.conf: ${NODE_IP}:6380, mutual
# TLS -> the node's loopback Redis), as the read-only ACL user. Comma-separated name=URL; the certificate files
# are 0640 root:xtnl in /etc/xtnl/dashboard/. Live values come only from the Redis whose redis:boot_id epoch is
# the current leader's; any other is shown as stale.
XTNL_DASHBOARD_REDIS_URLS=node-a=rediss://xtnl_dashboard:CHANGE_ME@10.0.1.10:6380/0?ssl_ca_certs=/etc/xtnl/dashboard/ca.crt&ssl_certfile=/etc/xtnl/dashboard/redis-client.crt&ssl_keyfile=/etc/xtnl/dashboard/redis-client.key&ssl_check_hostname=true,node-b=rediss://xtnl_dashboard:CHANGE_ME@10.0.2.10:6380/0?ssl_ca_certs=/etc/xtnl/dashboard/ca.crt&ssl_certfile=/etc/xtnl/dashboard/redis-client.crt&ssl_keyfile=/etc/xtnl/dashboard/redis-client.key&ssl_check_hostname=true

# Loopback only: operators reach it through the VPN host's reverse proxy / SSH tunnel.
XTNL_DASHBOARD_ADDR=127.0.0.1:8088
# Live values older than this (ms) are hidden.
XTNL_DASHBOARD_FRESH_MS=30000

XTNL_LOG_LEVEL=INFO
XTNL_LOG_FORMAT=json

# Secrets source (operations.md s13 "rotation without restart"; K10): env (default) = the values above, fixed until a
# restart. aws-sm: one secret (JSON object of these variable names, e.g. {"XTNL_DASHBOARD_DSN": "...",
# "XTNL_DASHBOARD_REDIS_URLS": "..."}) laid over this file, read with the host's instance role, refreshed every
# 5 min; the dashboard re-reads it every minute and swaps its read-only pool / Redis clients in place when a
# password changed (the replaced pool closes after 10 s). A secret unreadable at start is exit 75 (restarted).
# XTNL_SECRETS_SOURCE=aws-sm
# XTNL_SECRETS_ID=xtnl/dashboard
# XTNL_SECRETS_REGION=ap-southeast-4

# Leader heartbeat listener: NOT an environment variable. Its settings are the JSON file
# /etc/xtnl/dashboard/heartbeat.json (0640 root:xtnl; deploy/env/dashboard-heartbeat.json.example): https on
# ${DASHBOARD_VPN_IP}:8444, token = the engine's XTNL_HEARTBEAT_COPY_TOKEN, certificate / key
# /etc/xtnl/dashboard/heartbeat.crt / .key (0640 root:xtnl). Without the file every Redis live value is stale.
# K10: the file is re-read every 30 s: "token_next" (optional) is accepted beside "token", a replaced token stays
# accepted for "token_overlap_s" (default 1800), and a renewed heartbeat.crt / .key is loaded in place, so the
# engine's XTNL_HEARTBEAT_COPY_TOKEN rotates without a restart or a refused copy (deadman-alert.md "Token rotation").
