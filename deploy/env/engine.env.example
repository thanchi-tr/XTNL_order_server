# XTNL engine environment (systemd EnvironmentFile=/etc/xtnl/engine.env, mode 0640 root:xtnl).
#
# PLACEHOLDERS ONLY. Never commit real values. In production every secret below comes from AWS Secrets
# Manager (operations.md s13): set XTNL_SECRETS_SOURCE=aws-sm and the engine reads the secret itself and
# lays it over this file, so the secret values here can stay CHANGE_ME. The engine never reads .env files
# and never prints or logs a credential. Every variable the code reads is listed here (tests/deploy enforces it).
#
# Phase 1 is read-only: no credential here is ever used to send, modify or cancel an order.

# --- broker environment gate (adapter-isolation.md s5) -------------------------------------------------
# sandbox | live_readonly. Anything else is refused at start-up (exit 78). live_readonly uses read-only
# credentials on the real accounts.
BROKER_ENV=sandbox

# --- node / cluster (src/runtime/config.py) ----------------------------------------------------------------
XTNL_NODE_ID=node-a
# All three etcd members (both engine nodes + witness); fewer than three is refused at start-up.
XTNL_ETCD_ENDPOINTS=https://10.0.1.10:2379,https://10.0.2.10:2379,https://10.0.3.10:2379
# Melbourne dead-man receiver (push heartbeat every 15 s): src/deadman_receiver on the Melbourne host,
# XTNL_RECEIVER_LISTEN port + XTNL_RECEIVER_PATH; the token below equals its XTNL_RECEIVER_TOKEN.
XTNL_DEADMAN_URL=https://deadman.example.invalid:8443/xtnl/heartbeat
# DLQ spill file; the systemd unit pins it to /var/lib/xtnl (StateDirectory).
XTNL_SPILL_PATH=/var/lib/xtnl/dlq_spill.jsonl
# Partition archive (src/db/lifecycle.py PartitionExporter): partitions past 90 days are exported here as
# gzip JSONL + .sha256 before they are detached; copy the directory to S3 (runbook partition-archive.md).
# Unset = no export (the partitions are only paged as awaiting export).
XTNL_ARCHIVE_DIR=/var/lib/xtnl/archive
XTNL_LOG_LEVEL=INFO
# Log format: json (one JSON object per line: ts, level, logger, msg, epoch, node, and client_order_id /
# position_id / seq_id / account_id when known; shipped off-node) or text. Unset = json on Linux.
XTNL_LOG_FORMAT=json

# --- metrics exporter (src/observability/exporter.py; deploy/observability/metrics.md) ------------------------
# Prometheus text on http://<addr>/metrics in every role. Bind this node's VPC address on the contract port
# 9464 (VPC only, no inbound internet). Unset = 127.0.0.1:9464; "off" disables the exporter.
XTNL_METRICS_ADDR=10.0.1.10:9464
# Certificates whose notAfter is exported as xtnl_cert_expires_in_seconds{cert} (name=path, comma-separated).
# Unset = the etcd client certificate and CA above.
XTNL_METRICS_CERTS=etcd-client=/etc/xtnl/pki/etcd-client.crt,etcd-peer=/etc/xtnl/pki/etcd-peer.crt,pg-server=/etc/xtnl/pki/pg-server.crt,patroni-rest=/etc/xtnl/pki/patroni-rest.crt,ca=/etc/xtnl/pki/etcd-ca.crt
# Comma-separated adapters to run on this cluster: stonex, pepperstone (empty = none).
XTNL_ADAPTERS=stonex

# --- storage (src/db/settings.py) ----------------------------------------------------------------------------
# Multi-host DSN: asyncpg picks the writable Patroni primary.
ORDER_SERVER_DSN=postgresql://xtnl_engine:CHANGE_ME@10.0.1.10:5432,10.0.2.10:5432/xtnl?target_session_attrs=read-write&sslmode=verify-full
# This node's own Redis (used only while this node is leader).
REDIS_URL=redis://xtnl_engine:CHANGE_ME@127.0.0.1:6379/0

# --- secrets source (src/secrets/source.py) -------------------------------------------------------------
# env | aws-sm. aws-sm: one Secrets Manager secret whose SecretString is a JSON object keyed by the variable
# names in this file ({"STONE_X_PASS": "...", "XTNL_SMTP_PASSWORD": "...", ...}); it overrides the values
# here, is re-read every 5 min (rotation without restart) and is read with the instance role (IMDSv2).
# BROKER_ENV, XTNL_USE_MOCK_BROKER, XTNL_NODE_ID, XTNL_ADAPTERS and the XTNL_SECRETS_* keys are never taken
# from the secret.
XTNL_SECRETS_SOURCE=env
# The secret's name or ARN, and its region (aws-sm only).
XTNL_SECRETS_ID=xtnl/engine
XTNL_SECRETS_REGION=eu-west-2

# --- Patroni REST API credentials (src/runtime/patroni.py; patroni.yml restapi.authentication) --------------
# Used only for the SM3 switchover / reinit requests. Keep the password in the secret.
XTNL_PATRONI_USER=patroni_api
XTNL_PATRONI_PASSWORD=CHANGE_ME

# --- etcd client TLS (src/runtime/etcd.py) -----------------------------------------------------------------
# CA bundle that signed the etcd server certificates, and this node's client certificate + key for etcd
# client-cert-auth (deploy/etcd/etcd.conf.yml). Paths only; the key file stays mode 0640 root:xtnl.
XTNL_ETCD_CA=/etc/xtnl/pki/etcd-ca.crt
XTNL_ETCD_CERT=/etc/xtnl/pki/etcd-client.crt
XTNL_ETCD_KEY=/etc/xtnl/pki/etcd-client.key

# --- StoneX (src/config.py StoneXSettings; names shared with the XTNL project) --------------------------------
STONE_X_USERNAME=CHANGE_ME
STONE_X_PASS=CHANGE_ME
STONE_X_APP_KEY=CHANGE_ME
# Optional endpoint overrides; leave unset to use the BROKER_ENV defaults.
# STONE_X_BASE_URL=https://ciapi.cityindex.com/v2
# STONE_X_BASE_URL_DEPRECATED=https://ciapi.cityindex.com/TradingAPI
# STONE_X_STREAM_URL=https://push.cityindex.com
# Shared REST token bucket (operations.md §15; src/config.py _rest_limits): one per adapter for the whole
# process, priority reconcile > cash flows > DLQ > poll. Defaults until StoneX confirms its limits: 5 requests/s,
# burst 10. Both must be finite and > 0.
# STONE_X_REST_RATE_PER_S=5
# STONE_X_REST_BURST=10

# --- Pepperstone via the cTrader Open API -------------------------------------------------------------------
# The token pair is STATE after first use: the leader refreshes it and saves it (KMS-encrypted, with
# token_generation) in PostgreSQL; these seed values are read only when no row exists.
CTRADER_CLIENT_ID=CHANGE_ME
CTRADER_CLIENT_SECRET=CHANGE_ME
CTRADER_ACCESS_TOKEN=CHANGE_ME
CTRADER_REFRESH_TOKEN=CHANGE_ME
CTRADER_ACCOUNT_ID=CHANGE_ME
# demo.ctraderapi.com for sandbox, live.ctraderapi.com for live_readonly.
CTRADER_HOST=demo.ctraderapi.com
# Shared ProtoOA request bucket (as above). Defaults until confirmed with Pepperstone: 20 requests/s, burst 40.
# CTRADER_REST_RATE_PER_S=20
# CTRADER_REST_BURST=40
# KMS key that encrypts the saved token pair (src/secrets/kms.py, src/db/token_store.py). With both set, the
# leader refreshes the pair and saves it before use; unset = refresh disabled (an expired pair ends in
# AUTH_FAILED). Key id, key ARN or alias ARN; the instance role needs kms:Encrypt + kms:Decrypt on it.
XTNL_TOKEN_KMS_KEY_ID=arn:aws:kms:eu-west-2:000000000000:alias/xtnl-ctrader-tokens
XTNL_KMS_REGION=eu-west-2

# --- declared broker maintenance windows (operations.md §10 BROKER_MAINTENANCE; src/runtime/maintenance.py) ---
# A reviewed JSON file, deployed identically to BOTH engine nodes, re-read by the leader every 30 s:
#   {"stonex": [{"start": "2026-11-14T22:00:00+00:00", "end": "2026-11-15T02:00:00+00:00", "reason": "..."}]}
# (instants need an offset; or {"start_ms": ..., "end_ms": ...}). A missing file declares no window; an unreadable
# or invalid one keeps the windows read before and pages. During a window the adapter's liveness / FENCE alerts are
# held back and one info notice is sent.
XTNL_MAINTENANCE_FILE=/etc/xtnl/maintenance.json

# --- uptime + downtime catch-up (migration 0012; src/runtime/uptime.py, src/runtime/catchup.py) -------------
# Light engine_runs heartbeat (and the leader's adapter_coverage) every N seconds, 60..1800 (default 900).
XTNL_UPTIME_PING_S=900
# Each start-up / wake-from-sleep catch-up re-reads from the last recorded coverage minus this many seconds
# (default 900; at least XTNL_UPTIME_PING_S and 300, so the heartbeat's interval of uncertainty and a short
# undetected sleep are always covered).
XTNL_CATCHUP_OVERLAP_S=900
# First run (no coverage recorded yet): read the broker history of this many days back (1..365, default 7), or
# further when an order / position stored as still working is older.
XTNL_CATCHUP_FIRST_RUN_DAYS=7
# StoneX history reads for the catch-up, confirmed by a live read-only probe (2026-11-14): on. Set 0 to fall back
# to fail closed (every StoneX catch-up then reported incomplete, ActionGate keeps StoneX risk-increasing actions
# denied).
STONE_X_STOP_LIMIT_HISTORY=1
STONE_X_HISTORY_PAGING_CONFIRMED=1

# --- notifications: email + mobile push (src/notifications/settings.py) ------------------------------------
# A channel with no settings is disabled and reported at start-up; the engine still runs.
XTNL_ALERT_EMAIL_TO=oncall@example.invalid
# Email backend: SES when XTNL_SES_REGION is set, otherwise SMTP when XTNL_SMTP_HOST is set.
XTNL_SMTP_HOST=smtp.example.invalid
XTNL_SMTP_PORT=587
# starttls | ssl | none
XTNL_SMTP_SECURITY=starttls
XTNL_SMTP_USERNAME=CHANGE_ME
XTNL_SMTP_PASSWORD=CHANGE_ME
XTNL_SMTP_FROM=xtnl-alerts@example.invalid
XTNL_SMTP_TIMEOUT_S=10
# ... or Amazon SES v2 (SigV4; explicit keys, no instance-role lookup yet).
# XTNL_SES_REGION=eu-west-2
# XTNL_SES_FROM=xtnl-alerts@example.invalid
# XTNL_SES_ACCESS_KEY_ID=CHANGE_ME
# XTNL_SES_SECRET_ACCESS_KEY=CHANGE_ME
# XTNL_SES_SESSION_TOKEN=
# XTNL_SES_ENDPOINT=
# XTNL_SES_CONFIGURATION_SET=
XTNL_SES_TIMEOUT_S=10
# Mobile push: ntfy | pushover
XTNL_PUSH_PROVIDER=ntfy
XTNL_PUSH_URL=https://push.example.invalid/xtnl
XTNL_PUSH_TOKEN=CHANGE_ME
# Pushover user key (pushover only)
# XTNL_PUSH_USER=CHANGE_ME
XTNL_PUSH_TIMEOUT_S=10
# Dead-man receiver bearer token (URL is XTNL_DEADMAN_URL above). With XTNL_SECRETS_SOURCE=aws-sm it is re-read
# from the cached secret for every heartbeat, and a 401 / 403 re-reads the secret: rotate it without restarting
# either side, receiver first (its XTNL_RECEIVER_TOKEN_NEXT), then this secret, then promote the receiver's next
# token (docs/runbooks/deadman-alert.md "Token rotation"; the receiver also accepts a replaced token for its
# overlap window, so no heartbeat is refused).
XTNL_DEADMAN_TOKEN=CHANGE_ME

# --- Melbourne dashboard -----------------------------------------------------------------------------------------
# Not on the engine nodes: its own host and env file, deploy/env/dashboard.env.example (/etc/xtnl/dashboard.env).
# The leader POSTs a copy of every dead-man heartbeat to the dashboard's heartbeat listener (src/dashboard/heartbeat.py,
# over the VPN, https), which shows Redis live values only when their redis:boot_id epoch is the latest leader
# heartbeat's (operations.md §9). Unset: the dashboard marks every live value stale. The token equals the dashboard's
# heartbeat token and follows the secrets source like XTNL_DEADMAN_TOKEN.
XTNL_HEARTBEAT_COPY_URL=https://dashboard.example.invalid:8444/xtnl/heartbeat
XTNL_HEARTBEAT_COPY_TOKEN=CHANGE_ME

# --- development only -------------------------------------------------------------------------------------
# 1 = add MockBrokerAdapter (honoured only with BROKER_ENV=sandbox). Never set on production nodes.
XTNL_USE_MOCK_BROKER=0
# 1 = bypass the chrony hard check on a machine without chrony (honoured only with BROKER_ENV=sandbox).
# Never set on an engine node.
XTNL_DEV_SKIP_CLOCK_CHECK=0

# --- TLS trust for etcd / internal endpoints (read by httpx) ---------------------------------------------
# Required when the Melbourne dead-man receiver's certificate (XTNL_DEADMAN_URL) or the dashboard heartbeat
# listener's certificate (XTNL_HEARTBEAT_COPY_URL) comes from the internal CA: httpx otherwise trusts only
# certifi's public roots and every heartbeat POST (or copy) fails. The bundle must also hold
# the public roots every other httpx peer needs (broker REST, SES / SMTP / push endpoints), e.g. certifi + the CA.
# SSL_CERT_FILE=/etc/xtnl/pki/ca-bundle.crt   (etcd uses XTNL_ETCD_CA above when set)

# --- set by systemd, never here -------------------------------------------------------------------------------
# NOTIFY_SOCKET  (Type=notify; src/runtime/sdnotify.py)
