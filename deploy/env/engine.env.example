# XTNL engine environment (systemd EnvironmentFile=/etc/xtnl/engine.env, mode 0640 root:xtnl).
#
# PLACEHOLDERS ONLY. Never commit real values. In production every secret below comes from AWS Secrets
# Manager (operations.md s13): set XTNL_SECRETS_SOURCE=aws-sm and the engine reads the secret itself and
# lays it over this file, so the secret values here can stay CHANGE_ME. The engine never reads .env files
# and never prints or logs a credential. Every variable the code reads is listed here (tests/deploy enforces it).
#
# Phase 1 is read-only: no credential here is ever used to send, modify or cancel an order.

# --- broker environment gate (adapter-isolation.md s5) -------------------------------------------------
# sandbox | live_readonly. Anything else is refused at start-up (exit 78). live_readonly uses read-only
# credentials on the real accounts.
BROKER_ENV=sandbox

# --- node / cluster (src/runtime/config.py) ----------------------------------------------------------------
XTNL_NODE_ID=node-a
# All three etcd members (both engine nodes + witness); fewer than three is refused at start-up.
XTNL_ETCD_ENDPOINTS=https://10.0.1.10:2379,https://10.0.2.10:2379,https://10.0.3.10:2379
# Melbourne dead-man receiver (push heartbeat every 15 s): src/deadman_receiver on the Melbourne host,
# XTNL_RECEIVER_LISTEN port + XTNL_RECEIVER_PATH; the token below equals its XTNL_RECEIVER_TOKEN.
XTNL_DEADMAN_URL=https://deadman.example.invalid:8443/xtnl/heartbeat
# DLQ spill file; the systemd unit pins it to /var/lib/xtnl (StateDirectory).
XTNL_SPILL_PATH=/var/lib/xtnl/dlq_spill.jsonl
# Partition archive (src/db/lifecycle.py PartitionExporter): partitions past 90 days are exported here as
# gzip JSONL + .sha256 before they are detached; copy the directory to S3 (runbook partition-archive.md).
# Unset = no export (the partitions are only paged as awaiting export).
XTNL_ARCHIVE_DIR=/var/lib/xtnl/archive
XTNL_LOG_LEVEL=INFO
# Log format: json (one JSON object per line: ts, level, logger, msg, epoch, node, and client_order_id /
# position_id / seq_id / account_id when known; shipped off-node) or text. Unset = json on Linux.
XTNL_LOG_FORMAT=json

# --- metrics exporter (src/observability/exporter.py; deploy/observability/metrics.md) ------------------------
# Prometheus text on http://<addr>/metrics in every role. Bind this node's VPC address on the contract port
# 9464 (VPC only, no inbound internet). Unset = 127.0.0.1:9464; "off" disables the exporter.
XTNL_METRICS_ADDR=10.0.1.10:9464
# Certificates whose notAfter is exported as xtnl_cert_expires_in_seconds{cert} and whose readability as
# xtnl_cert_readable{cert} (name=path, comma-separated; K5, operations.md s13). List EVERY certificate this node
# serves or presents, at the path its service actually loads (so a renewed certificate is the one watched): the
# off-node XtnlCertUnreadable alert also fires for a name of deploy/observability/gen_alerts.py FILE_CERTS left out
# here. The paths are node-specific: node A shown (ETCD_NAME=etcd-a, PG_MEMBER_NAME=pg-a); node B uses etcd-b / pg-b
# (deploy/etcd/etcd.conf.yml, deploy/patroni/patroni.yml). Certificates are public: each file 0644 and its
# directory traversable, so the xtnl user can read it; private keys stay 0600 (install-node.md step 3b).
# Unset = the etcd client certificate and CA above.
XTNL_METRICS_CERTS=etcd-client=/etc/xtnl/pki/etcd-client.crt,etcd-server=/etc/etcd/pki/etcd-a.crt,etcd-peer=/etc/etcd/pki/etcd-a-peer.crt,patroni-rest=/etc/patroni/pki/pg-a.crt,pg-server=/etc/patroni/pki/pg-a-pg.crt,patroni-etcd-client=/etc/patroni/pki/pg-a-etcd-client.crt,patroni-ca=/etc/patroni/pki/ca.crt,redis-proxy=/etc/xtnl/redis-tls-proxy/tls.crt,redis-proxy-client-ca=/etc/xtnl/redis-tls-proxy/client-ca.crt,ca=/etc/xtnl/pki/etcd-ca.crt
# Certificates served on hosts that export no metrics, read from this node every 300 s by a verifying TLS
# handshake (name=host:port, or name=host:port;ca=/path to trust only that CA). Trust: an entry's own ca=; else
# XTNL_ETCD_CA for the etcd-* names (the witness's etcd certificates come from the etcd CA); else SSL_CERT_FILE
# below or the system store (the engine logs a start-up warning for an endpoint that only the system store
# covers). The etcd client certificate XTNL_ETCD_CERT / _KEY is presented, so the witness's mutual-TLS etcd peer
# port answers. An expired, untrusted or misnamed certificate reads as unreadable (XtnlCertUnreadable).
XTNL_METRICS_CERT_ENDPOINTS=etcd-witness-server=10.0.3.10:2379,etcd-witness-peer=10.0.3.10:2380,deadman-receiver=deadman.example.invalid:8443,dashboard-heartbeat=dashboard.example.invalid:8444
# Comma-separated adapters to run on this cluster: stonex, pepperstone (empty = none).
XTNL_ADAPTERS=stonex

# --- storage (src/db/settings.py) ----------------------------------------------------------------------------
# Multi-host DSN: asyncpg picks the writable Patroni primary.
ORDER_SERVER_DSN=postgresql://xtnl_engine:CHANGE_ME@10.0.1.10:5432,10.0.2.10:5432/xtnl?target_session_attrs=read-write&sslmode=verify-full
# This node's own Redis (used only while this node is leader).
REDIS_URL=redis://xtnl_engine:CHANGE_ME@127.0.0.1:6379/0

# --- secrets source (src/secrets/source.py) -------------------------------------------------------------
# env | aws-sm. aws-sm: one Secrets Manager secret whose SecretString is a JSON object keyed by the variable
# names in this file ({"STONE_X_PASS": "...", "XTNL_SMTP_PASSWORD": "...", ...}); it overrides the values
# here, is re-read every 5 min (rotation without restart) and is read with the instance role (IMDSv2).
# BROKER_ENV, XTNL_USE_MOCK_BROKER, XTNL_NODE_ID, XTNL_ADAPTERS and the XTNL_SECRETS_* keys are never taken
# from the secret.
XTNL_SECRETS_SOURCE=env
# The secret's name or ARN, and its region (aws-sm only).
XTNL_SECRETS_ID=xtnl/engine
XTNL_SECRETS_REGION=eu-west-2

# --- Patroni REST API credentials (src/runtime/patroni.py; patroni.yml restapi.authentication) --------------
# Used only for the SM3 switchover / reinit requests. Keep the password in the secret.
XTNL_PATRONI_USER=patroni_api
XTNL_PATRONI_PASSWORD=CHANGE_ME

# --- etcd client TLS (src/runtime/etcd.py) -----------------------------------------------------------------
# CA bundle that signed the etcd server certificates, and this node's client certificate + key for etcd
# client-cert-auth (deploy/etcd/etcd.conf.yml). Paths only; the key file stays mode 0640 root:xtnl.
XTNL_ETCD_CA=/etc/xtnl/pki/etcd-ca.crt
XTNL_ETCD_CERT=/etc/xtnl/pki/etcd-client.crt
XTNL_ETCD_KEY=/etc/xtnl/pki/etcd-client.key

# --- StoneX (src/config.py StoneXSettings; names shared with the XTNL project) --------------------------------
STONE_X_USERNAME=CHANGE_ME
STONE_X_PASS=CHANGE_ME
STONE_X_APP_KEY=CHANGE_ME
# Optional endpoint overrides; leave unset to use the BROKER_ENV defaults.
# STONE_X_BASE_URL=https://ciapi.cityindex.com/v2
# STONE_X_BASE_URL_DEPRECATED=https://ciapi.cityindex.com/TradingAPI
# STONE_X_STREAM_URL=https://push.cityindex.com
# Shared REST token bucket (operations.md §15; src/config.py _rest_limits): one per adapter for the whole
# process, priority reconcile > cash flows > DLQ > poll. Defaults until StoneX confirms its limits: 5 requests/s,
# burst 10. Both must be finite and > 0.
# STONE_X_REST_RATE_PER_S=5
# STONE_X_REST_BURST=10
# Cap on the market-data layer's bar reads (BARS priority, design PR11) per minute; unset = a quarter of the rate,
# at most half of it. Read only by the optional market-data services; a bad value logs and the default applies.
# STONE_X_REST_BARS_PER_MIN=

# --- Pepperstone via the cTrader Open API -------------------------------------------------------------------
# The token pair is STATE after first use: the leader refreshes it and saves it (KMS-encrypted, with
# token_generation) in PostgreSQL; these seed values are read only when no row exists.
CTRADER_CLIENT_ID=CHANGE_ME
CTRADER_CLIENT_SECRET=CHANGE_ME
CTRADER_ACCESS_TOKEN=CHANGE_ME
CTRADER_REFRESH_TOKEN=CHANGE_ME
CTRADER_ACCOUNT_ID=CHANGE_ME
# demo.ctraderapi.com for sandbox, live.ctraderapi.com for live_readonly.
CTRADER_HOST=demo.ctraderapi.com
# Shared ProtoOA request bucket (as above). Defaults until confirmed with Pepperstone: 20 requests/s, burst 40.
# CTRADER_REST_RATE_PER_S=20
# CTRADER_REST_BURST=40
# CTRADER_REST_BARS_PER_MIN=   (as STONE_X_REST_BARS_PER_MIN above)
# KMS key that encrypts the saved token pair (src/secrets/kms.py, src/db/token_store.py). With both set, the
# leader refreshes the pair and saves it before use; unset = refresh disabled (an expired pair ends in
# AUTH_FAILED). Key id, key ARN or alias ARN; the instance role needs kms:Encrypt + kms:Decrypt on it.
XTNL_TOKEN_KMS_KEY_ID=arn:aws:kms:eu-west-2:000000000000:alias/xtnl-ctrader-tokens
XTNL_KMS_REGION=eu-west-2

# --- declared broker maintenance windows (operations.md §10 BROKER_MAINTENANCE; src/runtime/maintenance.py) ---
# A reviewed JSON file, deployed identically to BOTH engine nodes, re-read by the leader every 30 s:
#   {"stonex": [{"start": "2026-11-14T22:00:00+00:00", "end": "2026-11-15T02:00:00+00:00", "reason": "..."}]}
# (instants need an offset; or {"start_ms": ..., "end_ms": ...}). A missing file declares no window; an unreadable
# or invalid one keeps the windows read before and pages. During a window the adapter's liveness / FENCE alerts are
# held back and one info notice is sent.
XTNL_MAINTENANCE_FILE=/etc/xtnl/maintenance.json

# --- uptime + downtime catch-up (migration 0012; src/runtime/uptime.py, src/runtime/catchup.py) -------------
# Light engine_runs heartbeat (and the leader's adapter_coverage) every N seconds, 60..1800 (default 900).
XTNL_UPTIME_PING_S=900
# Each start-up / wake-from-sleep catch-up re-reads from the last recorded coverage minus this many seconds
# (default 900; at least XTNL_UPTIME_PING_S and 300, so the heartbeat's interval of uncertainty and a short
# undetected sleep are always covered).
XTNL_CATCHUP_OVERLAP_S=900
# First run (no coverage recorded yet): read the broker history of this many days back (1..365, default 7), or
# further when an order / position stored as still working is older.
XTNL_CATCHUP_FIRST_RUN_DAYS=7
# StoneX history reads for the catch-up, confirmed by a live read-only probe (2026-11-14): on. Set 0 to fall back
# to fail closed (every StoneX catch-up then reported incomplete, ActionGate keeps StoneX risk-increasing actions
# denied).
STONE_X_STOP_LIMIT_HISTORY=1
STONE_X_HISTORY_PAGING_CONFIRMED=1

# --- single-PC mode only (operations.md §4 / §17; src/runtime/single_pc.py) -------------------------------------
# NEVER 1 on the AWS nodes: here SAFE_HOLD stays operator-only (two-person `safe-hold resume`). Only the single
# Windows PC runs with 1 (deploy/local/start-xtnl.ps1 and run-local.ps1 set it): a SAFE_HOLD is resumed by the
# engine itself once its hard checks pass, after a cool-down of XTNL_SINGLE_PC_RESUME_FIRST_S (1..86400, default
# 300) doubling per earlier auto-resume within XTNL_SINGLE_PC_RESUME_WINDOW_S (3600..604800, default 86400), capped
# at XTNL_SINGLE_PC_RESUME_MAX_S (1..86400, default 3600); after XTNL_SINGLE_PC_RESUME_LIMIT (1..100, default 6)
# auto-resumes within the window it stays held and pages critical. With 1, no leader term for
# XTNL_SINGLE_PC_IDLE_PAGE_S (60..86400, default 600) pages critical ("engine not recording"). Only exactly 1 is on;
# a bad number falls back to its default (logged, never fatal).
XTNL_SINGLE_PC=0
XTNL_SINGLE_PC_RESUME_FIRST_S=300
XTNL_SINGLE_PC_RESUME_MAX_S=3600
XTNL_SINGLE_PC_RESUME_LIMIT=6
XTNL_SINGLE_PC_RESUME_WINDOW_S=86400
XTNL_SINGLE_PC_IDLE_PAGE_S=600

# --- notifications: email + mobile push (src/notifications/settings.py) ------------------------------------
# A channel with no settings is disabled and reported at start-up; the engine still runs.
XTNL_ALERT_EMAIL_TO=oncall@example.invalid
# Email backend: SES when XTNL_SES_REGION is set, otherwise SMTP when XTNL_SMTP_HOST is set.
XTNL_SMTP_HOST=smtp.example.invalid
XTNL_SMTP_PORT=587
# starttls | ssl | none
XTNL_SMTP_SECURITY=starttls
XTNL_SMTP_USERNAME=CHANGE_ME
XTNL_SMTP_PASSWORD=CHANGE_ME
XTNL_SMTP_FROM=xtnl-alerts@example.invalid
XTNL_SMTP_TIMEOUT_S=10
# ... or Amazon SES v2 (SigV4; explicit keys, no instance-role lookup yet).
# XTNL_SES_REGION=eu-west-2
# XTNL_SES_FROM=xtnl-alerts@example.invalid
# XTNL_SES_ACCESS_KEY_ID=CHANGE_ME
# XTNL_SES_SECRET_ACCESS_KEY=CHANGE_ME
# XTNL_SES_SESSION_TOKEN=
# XTNL_SES_ENDPOINT=
# XTNL_SES_CONFIGURATION_SET=
XTNL_SES_TIMEOUT_S=10
# Mobile push: ntfy | pushover
XTNL_PUSH_PROVIDER=ntfy
XTNL_PUSH_URL=https://push.example.invalid/xtnl
XTNL_PUSH_TOKEN=CHANGE_ME
# Pushover user key (pushover only)
# XTNL_PUSH_USER=CHANGE_ME
XTNL_PUSH_TIMEOUT_S=10
# Dead-man receiver bearer token (URL is XTNL_DEADMAN_URL above). With XTNL_SECRETS_SOURCE=aws-sm it is re-read
# from the cached secret for every heartbeat, and a 401 / 403 re-reads the secret: rotate it without restarting
# either side, receiver first (its XTNL_RECEIVER_TOKEN_NEXT), then this secret, then promote the receiver's next
# token (docs/runbooks/deadman-alert.md "Token rotation"; the receiver also accepts a replaced token for its
# overlap window, so no heartbeat is refused).
XTNL_DEADMAN_TOKEN=CHANGE_ME

# --- Melbourne dashboard -----------------------------------------------------------------------------------------
# Not on the engine nodes: its own host and env file, deploy/env/dashboard.env.example (/etc/xtnl/dashboard.env).
# The leader POSTs a copy of every dead-man heartbeat to the dashboard's heartbeat listener (src/dashboard/heartbeat.py,
# over the VPN, https), which shows Redis live values only when their redis:boot_id epoch is the latest leader
# heartbeat's (operations.md §9). Unset: the dashboard marks every live value stale. The token equals the dashboard's
# heartbeat token and follows the secrets source like XTNL_DEADMAN_TOKEN.
XTNL_HEARTBEAT_COPY_URL=https://dashboard.example.invalid:8444/xtnl/heartbeat
XTNL_HEARTBEAT_COPY_TOKEN=CHANGE_ME

# --- order-server API (python -m src.api; docs/runbooks/order-server-api.md) ----------------------------------
# Read-only HTTPS API for the XTNL thesis website (single-PC mode): GET /v1/health, POST /v1/pinescript/compile,
# GET /v1/pinescript/latest. HMAC-signed requests only; Phase 1 never sends orders. The only network-facing
# listener: everything else stays on 127.0.0.1.
# XTNL_API_SECRET (the shared HMAC secret, hex / base64 of >= 32 random bytes) is set in the Windows User
# environment by deploy/local/new-api-credentials.ps1, never here (start-xtnl.ps1 refuses an env file that sets it).
XTNL_API_PORT=47443
XTNL_API_BIND=0.0.0.0
XTNL_API_TLS_CERT=var/api-tls/server.crt
XTNL_API_TLS_KEY=var/api-tls/server.key
# The API's OWN Redis (service redis-api of deploy/local/docker-compose.local.yml), never the engine's REDIS_URL,
# and the database of the Pine Script cache in it (pinescript:week:<YYYY-Www>, TTL 8 days).
XTNL_API_REDIS_URL=redis://127.0.0.1:56381/2
XTNL_API_REDIS_DB=2
# XTNL_API_DSN (PostgreSQL as the read-only role xtnl_api, migration 0014) carries a password, so like the secret
# it is set in the Windows User environment only (new-api-credentials.ps1 -DbRole), never here. Least privilege:
# start-xtnl.ps1 starts the API without the broker credentials (STONE_X_*), ORDER_SERVER_DSN or REDIS_URL, and
# the API refuses to start if it sees any of them.
XTNL_API_RATE_PER_MIN=30

# --- reviewed-change switches (plan S38f; design §0b "What turns each on") ----------------------------------
# A start applies only the schema migrations up to XTNL_MIGRATIONS_ACCEPTED_UPTO (default 14): later ones
# (0015-0020, the market-data / ARM schema) are held back, named in one log line, and the start carries on. Raise
# it only once those migrations are reviewed (20 applies all of them), BEFORE turning on anything below.
XTNL_MIGRATIONS_ACCEPTED_UPTO=14
# XTNL_OVERSEE_STOP_AT_ENTRY=1 turns on the S07 Oversee stop rule (a STOP child counts at any price, also at or
# beyond entry; a LIMIT child never counts; the stop_kind caveats). 0 / unset keeps the exact pre-S07 rule. Set it
# only after confirming design §0 C4; the ARM may run only with it on (go-live gate oversee_c4).
XTNL_OVERSEE_STOP_AT_ENTRY=0

# --- optional market-data layer and ARM (docs/design/automated-risk-manager.md §C2 Local flags) -------------
# Local only, never Supabase; both off by default. 1 = after LEADER, the engine adds the optional-bootstrap task
# (market data; ARM needs XTNL_MD_ENABLED=1 too). Read trimmed from the process environment (a value inherited
# from the Windows User environment counts too): only 1 is on; unset or 0 is off; any other value (true, yes, on
# included) is treated as 0 and paged. Turning them on never affects ingestion or Oversee.
XTNL_MD_ENABLED=0
XTNL_ARM_ENABLED=0
# XTNL_ARM_GOLIVE_ACCEPT: go-live gate ids (comma-separated) the user explicitly accepts while they are still open;
# with XTNL_ARM_ENABLED=1 the ARM stays idle (one page) while any gate is open and not listed here. Empty by
# default; `python -m src.ops arm gates` lists the gates and the verdict (design §0b, plan S38e).
XTNL_ARM_GOLIVE_ACCEPT=
# XTNL_TICK_SYMBOLS: PR5 tick-only symbols as adapter:SYMBOL items, comma-separated, at most 8 per adapter
# (checked against the instrument list; read by the optional bootstrap only while XTNL_MD_ENABLED=1). The other
# XTNL_MD_* / XTNL_ARM_* settings below are read only inside the optional bootstrap; a bad value pages and parks
# the optional services, never the engine. The values below are the design defaults.
XTNL_TICK_SYMBOLS=
# StoneX price subscriptions at setRequestedMaxFrequency("unfiltered"); stays 0: the PR3 probe (2026-11-17)
# measured filtered delivery with broker-timed ticks (design §A11 PR3).
XTNL_STONEX_PRICE_UNFILTERED=0
#
# Market-data secrets, never assigned here (start-xtnl.ps1 refuses an env file that sets them). On the PC they are
# set by deploy/local/new-md-credentials.ps1; on AWS they come from the secrets source.
# XTNL_MD_REDIS_URL: the md_writer URL (engine only); Windows User environment on the PC.
# XTNL_MD_REDIS_READER_URL: the md_reader URL (read-only; the ops CLI); Windows User environment on the PC.
# XTNL_MD_HMAC_KEY: the content-hash key, 64 hex digits (§A13); Windows User environment on the PC.
# XTNL_MD_HMAC_KEY_PREV: the previous key, kept only during a rotation; Windows User environment on the PC.
# The current key's id (1-255; a new key always takes a higher id) and, while XTNL_MD_HMAC_KEY_PREV is kept, the
# retained key's id (below the current one; empty otherwise).
XTNL_MD_HMAC_KEY_ID=1
XTNL_MD_HMAC_KEY_PREV_ID=
# Cross-check tolerance in median clean spreads, (0, 10] (§A4).
XTNL_MD_CROSSCHECK_K=1.0
# Consecutive mismatches / invalid buckets that block a series, 2-10 (§A4; D6: one mismatch only flags, so 1 is
# refused); also the series K of §B14.
XTNL_MD_MISMATCH_K=3
# Rollback-set size per series, 2-64 (§A13).
XTNL_MD_ROLLBACK_N=8
# Decision-grade symbols per adapter, 1-32 (BARS budget, §A6).
XTNL_MD_DECISION_SYMBOLS=8
# Two agreeing broker-bar reads this many seconds apart make a bar final, 1-120 (§A4).
XTNL_MD_BROKER_BAR_SETTLE_S=10
# PR3 p99 broker-bar finality lag in ms, 0-300000 (StoneX measured 5 s by PR3): starts the re-read back-off
# only (§A4).
XTNL_MD_BROKER_BAR_LAG_MS=5000
#
# ARM (advice only; design §B6.7, §B11, §B14). Envelope gap floor in R, 0-0.5.
XTNL_ARM_MIN_GAP_R=0.0
# PRE fires at local T + p50 - this many seconds, 30-45 (the 15m timing row, §B5.2; valid for 10 s).
XTNL_ARM_PRE_OFFSET_S=40
# The single Phase 1 edge code, ^[a-z0-9_]{1,32}$ (§B11).
XTNL_ARM_EDGE=default
# PR9 stop-handle reads, 0 / 1: stays 0 until the stop children are confirmed in activestoplimitorders
# (python -m src.adapters.stonex.probe_bars --check-stops; go-live gate pr3_stop_children).
XTNL_ARM_STOP_READS=0
# Error budget (§B14): unfinished OPEN bars at their cap before SERIES FAILED (1-4); series of one adapter FAILED
# together before ADAPTER FAILED (2-8); redis-md unusable (300-3600 s) or the ARM pool failing (300-3600 s) this
# long before ARM FAILED; re-ping cadence while FAILED in hours (1-24); positions stuck together before a stuck
# replay frontier is ARM-global (1-8; fewer: each fails only its own POSITION scope).
XTNL_ARM_FAIL_UNRESOLVED_N=2
XTNL_ARM_FAIL_GLOBAL_SERIES_N=3
XTNL_ARM_FAIL_MD_DOWN_S=900
XTNL_ARM_FAIL_POOL_DOWN_S=900
XTNL_ARM_FAIL_REPING_H=4
XTNL_ARM_FAIL_FRONTIER_POSITIONS_N=2
# Unclean engine restarts / takeovers (terms ended lost or init_failed) within the window while positions are
# armed before ARM FAILED (2-10 in 300-7200 s; plan S38f): a fault that keeps crashing the engine fails the ARM.
XTNL_ARM_FAIL_RESTARTS_N=3
XTNL_ARM_FAIL_RESTART_WINDOW_S=1800
# ARM configuration (Supabase, §B9): XTNL_ARM_CONFIG_DSN (role xtnl_arm_reader) is a secret, never assigned here:
# the Windows User environment on the PC, the secrets source on AWS. Unset: the ARM config is idle (one page).
# The pinned CA file of that database (a path, required with the DSN):
XTNL_ARM_CONFIG_CA_FILE=
# ARM channels (PR4; both required before the ARM starts): the alert channel settings above under the prefix
# XTNL_ARM_ instead of XTNL_ (a separate SMTP or SES account, ntfy with a token, or Pushover), for example
# XTNL_ARM_ALERT_EMAIL_TO, XTNL_ARM_SMTP_HOST, XTNL_ARM_SMTP_PORT, XTNL_ARM_SMTP_FROM, XTNL_ARM_SES_REGION,
# XTNL_ARM_SES_FROM, XTNL_ARM_PUSH_PROVIDER, XTNL_ARM_PUSH_URL. Their credentials are never assigned here (the
# secrets source on AWS; start-xtnl.ps1 refuses an env file that sets them on the PC):
# XTNL_ARM_SMTP_USERNAME, XTNL_ARM_SMTP_PASSWORD, XTNL_ARM_SES_ACCESS_KEY_ID, XTNL_ARM_SES_SECRET_ACCESS_KEY,
# XTNL_ARM_SES_SESSION_TOKEN, XTNL_ARM_PUSH_TOKEN, XTNL_ARM_PUSH_USER: Windows User environment on the PC.
# XTNL_ARM_ALERT_EMAIL_TO=arm-advice@example.invalid
# XTNL_ARM_SMTP_HOST=smtp.example.invalid
# XTNL_ARM_PUSH_PROVIDER=ntfy
# XTNL_ARM_PUSH_URL=https://push.example.invalid/xtnl-arm

# --- development only -------------------------------------------------------------------------------------
# 1 = add MockBrokerAdapter (honoured only with BROKER_ENV=sandbox). Never set on production nodes.
XTNL_USE_MOCK_BROKER=0
# 1 = bypass the chrony hard check on a machine without chrony (honoured only with BROKER_ENV=sandbox).
# Never set on an engine node.
XTNL_DEV_SKIP_CLOCK_CHECK=0

# --- TLS trust for etcd / internal endpoints (read by httpx) ---------------------------------------------
# Required when the Melbourne dead-man receiver's certificate (XTNL_DEADMAN_URL) or the dashboard heartbeat
# listener's certificate (XTNL_HEARTBEAT_COPY_URL) comes from the internal CA: httpx otherwise trusts only
# certifi's public roots and every heartbeat POST (or copy) fails. The bundle must also hold
# the public roots every other httpx peer needs (broker REST, SES / SMTP / push endpoints), e.g. certifi + the CA.
# It is also the trust of the XTNL_METRICS_CERT_ENDPOINTS handshakes without their own ca= (the receiver and
# dashboard listeners, K5). etcd and the etcd-* endpoints use XTNL_ETCD_CA above when set.
SSL_CERT_FILE=/etc/xtnl/pki/ca-bundle.crt

# --- set by systemd, never here -------------------------------------------------------------------------------
# NOTIFY_SOCKET  (Type=notify; src/runtime/sdnotify.py)
