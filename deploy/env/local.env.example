# Local single-machine development run (Stage 0). NOT for staging or production: use engine.env.example there.
#
# Copy to deploy/env/local.env (git-ignored), then:
#     docker compose -f deploy/docker-compose.dev.yml up -d --wait
#     powershell -ExecutionPolicy Bypass -File deploy/local/run-local.ps1 -Migrate
#
# Uses the throwaway containers from deploy/docker-compose.dev.yml. The engine gets its own database
# (xtnl_dev) and Redis database 0; the integration tests use xtnl_test and Redis database 15 and wipe them.
# 'xtnl_dev_only' is the container's throwaway password, not a credential for anything else.

XTNL_NODE_ID=dev1
# The engine insists on three etcd endpoints (operations.md s1); locally the one container is listed three times.
XTNL_ETCD_ENDPOINTS=http://127.0.0.1:52379,http://127.0.0.1:52379,http://127.0.0.1:52379
ORDER_SERVER_DSN=postgresql://xtnl:xtnl_dev_only@127.0.0.1:55432/xtnl_dev
REDIS_URL=redis://127.0.0.1:56379/0
XTNL_SPILL_PATH=var/dlq_spill.jsonl
XTNL_LOG_LEVEL=INFO
XTNL_LOG_FORMAT=text
XTNL_METRICS_ADDR=127.0.0.1:9464
# No chrony on Windows: treat the clock as synced (refused unless BROKER_ENV=sandbox; never on an engine node).
XTNL_DEV_SKIP_CLOCK_CHECK=1

# Dead-man receiver. Required by the engine. Locally either run `python -m src.deadman_receiver` on this port
# or leave it unanswered (heartbeats then fail and are logged; nothing else is affected).
XTNL_DEADMAN_URL=http://127.0.0.1:9999/beat

# Broker. sandbox = StoneX preprod / cTrader demo. Phase 1 never sends orders.
BROKER_ENV=sandbox
# 1 = scripted in-memory broker (sandbox only). Set 0 and fill the STONE_X_* / CTRADER_* variables below
# (in your own shell or local.env, never committed) to read a real sandbox account.
XTNL_USE_MOCK_BROKER=1
# STONE_X_USERNAME=
# STONE_X_PASS=
# STONE_X_APP_KEY=
# Downtime catch-up reads of StoneX history (docs/runbooks/downtime-catchup.md), confirmed by a live read-only
# probe on 2026-11-14, so on. Set 0 to fall back to fail closed (every StoneX catch-up reported INCOMPLETE).
#   STONE_X_STOP_LIMIT_HISTORY=1      also read order/stoplimitorderhistory (stop / limit orders finished while off)
#   STONE_X_HISTORY_PAGING_CONFIRMED=1  trust order/tradehistory paging (its 'from' filter is by last change)
STONE_X_STOP_LIMIT_HISTORY=1
STONE_X_HISTORY_PAGING_CONFIRMED=1

# Alerts: leave unset locally (channels are reported as disabled; pages are logged).

# Single-PC self-healing (XTNL_SINGLE_PC, operations.md s4 / s17): run-local.ps1 sets XTNL_SINGLE_PC=1 when it is
# not set, so a SAFE_HOLD is resumed by the engine itself after a cool-down (settings and bounds:
# deploy/env/engine.env.example, local-live.env.example). Set XTNL_SINGLE_PC=0 here to keep it operator-only.

# --- uptime + downtime catch-up (migration 0012; src/runtime/uptime.py, src/runtime/catchup.py) -------------
# Single-PC mode (.claude/rules/operations.md s17): the engine records when it is on and, at each start-up, wake from
# sleep or broker reconnect, reads back from the broker what changed while it was off. Runbook:
# docs/runbooks/downtime-catchup.md. run-local.ps1 restarts the engine after a hard exit (e.g. a sleep longer than
# the lease); -NoRestart runs it once.
# Light engine_runs heartbeat (and the leader's adapter_coverage) every N seconds, 60..1800 (default 900).
XTNL_UPTIME_PING_S=900
# Each start-up / wake-from-sleep catch-up re-reads from the last recorded coverage minus this many seconds
# (default 900; at least XTNL_UPTIME_PING_S and 300, so the heartbeat's interval of uncertainty and a short
# undetected sleep are always covered).
XTNL_CATCHUP_OVERLAP_S=900
# First run (no coverage recorded yet): read the broker history of this many days back (1..365, default 7), or
# further when an order / position stored as still working is older.
XTNL_CATCHUP_FIRST_RUN_DAYS=7

# Reviewed-change switches (plan S38f, design §0b): migrations above this level are held back (a dev database may
# take every migration: raise it to 20); the S07 Oversee stop rule only with XTNL_OVERSEE_STOP_AT_ENTRY=1.
XTNL_MIGRATIONS_ACCEPTED_UPTO=14
XTNL_OVERSEE_STOP_AT_ENTRY=0
