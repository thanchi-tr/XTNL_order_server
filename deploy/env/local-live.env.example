# XTNL single-PC LIVE settings (single-PC mode, .claude/rules/operations.md s17). Read-only broker access:
# Phase 1 never sends orders. Runbooks: docs/runbooks/single-pc-autostart.md, docs/runbooks/downtime-catchup.md.
#
# Copy to deploy/env/local.env (git-ignored), then deploy/local/start-xtnl.ps1 (what the 'XTNL engine'
# scheduled task runs) starts deploy/local/docker-compose.local.yml, applies the migrations, waits for the clock
# and runs deploy/local/run-local.ps1 -EnvFile deploy/env/local.env.
#
# CREDENTIALS: STONE_X_USERNAME, STONE_X_PASS, STONE_X_APP_KEY (and STONE_X_BASE_URL, STONE_X_BASE_URL_DEPRECATED,
# STONE_X_STREAM_URL) come ONLY from the Windows User environment; start-xtnl.ps1 copies them into the engine
# process without printing them. NEVER write them here or into local.env: start-xtnl.ps1 refuses to start when
# this file assigns STONE_X_USERNAME, STONE_X_PASS or STONE_X_APP_KEY. The same holds for XTNL_API_SECRET (the
# order-server API's shared secret, below), the alert channel credentials (XTNL_SMTP_USERNAME / _PASSWORD,
# XTNL_SES_ACCESS_KEY_ID / _SECRET_ACCESS_KEY / _SESSION_TOKEN, XTNL_PUSH_TOKEN / _USER), XTNL_DEADMAN_TOKEN and the
# market-data / ARM secrets (below): Windows User environment only.
#
# 'xtnl_local_only' is the local-only password of the loopback-bound PostgreSQL container in
# deploy/local/docker-compose.local.yml, not a credential for anything else.

XTNL_NODE_ID=pc1
# The engine insists on three etcd endpoints (operations.md s1); on this PC the one member is listed three times.
XTNL_ETCD_ENDPOINTS=http://127.0.0.1:52380,http://127.0.0.1:52380,http://127.0.0.1:52380
ORDER_SERVER_DSN=postgresql://xtnl:xtnl_local_only@127.0.0.1:55433/xtnl
REDIS_URL=redis://127.0.0.1:56380/0
XTNL_SPILL_PATH=var/dlq_spill.jsonl
XTNL_LOG_LEVEL=INFO
XTNL_LOG_FORMAT=json
XTNL_METRICS_ADDR=127.0.0.1:9464
# K5: the read-only API certificate (below) exported as xtnl_cert_expires_in_seconds / xtnl_cert_readable{cert="api-server"}
# (no off-node alert on the single PC; read it on http://127.0.0.1:9464/metrics).
XTNL_METRICS_CERTS=api-server=var/api-tls/server.crt
# The clock is measured (w32tm against time.windows.com on Windows) and must be within 50 ms. Never 1 here:
# the bypass is refused outside BROKER_ENV=sandbox anyway.
XTNL_DEV_SKIP_CLOCK_CHECK=0

# Dead-man receiver (operations.md s9). Not required in single-PC mode. Point it at the real receiver (the home
# VPS, docs/runbooks/deadman-receiver-home.md: https://<name>.<tailnet>.ts.net/xtnl/heartbeat) to be paged when
# this PC goes silent. The loopback placeholder below has NO listener, and since W1 a set URL is not free: every
# beat fails (an error line every 15 s), every start logs the ERROR "XTNL_DEADMAN_URL is set but
# XTNL_DEADMAN_TOKEN is empty" unless the token is set, and after XTNL_DEADMAN_ALERT_AFTER_S (default 300 s) the
# leader sends a PAGE[high] "dead-man receiver not acknowledging". It is not a one-off: a new term within 6 h of
# that page does not page again, but every engine start more than 6 h after the last one (a weekly Windows Update
# restart, a power cut) sends one more PAGE[high]. The episode is kept per receiver host, so moving the URL to
# the real receiver later sends no "acknowledging again" PAGE[info] for the placeholder's episode. Leave
# XTNL_DEADMAN_URL empty (or remove the line) for no beat, no page and no heartbeat copy (xtnl_deadman_configured
# 0). Keep the placeholder only as the plan s3.1 stop-gap, for the heartbeat copy (check A), accepting one page
# per engine start that comes more than 6 h after the previous page.
XTNL_DEADMAN_URL=http://127.0.0.1:9999/beat
# With a real receiver: XTNL_DEADMAN_TOKEN (its XTNL_RECEIVER_TOKEN) in the Windows User environment. A URL without
# the token logs the start-up ERROR "XTNL_DEADMAN_URL is set but XTNL_DEADMAN_TOKEN is empty" (every beat is refused
# with 401). The healthchecks.io silence backstop XTNL_HEARTBEAT_COPY_URL (home-server plan s3.1) also belongs in the
# Windows User environment only: its URL is a secret (anyone holding it can keep the check green), and start-xtnl.ps1
# refuses (exit 78) an env file that assigns XTNL_HEARTBEAT_COPY_URL or XTNL_HEARTBEAT_COPY_TOKEN. Leave
# XTNL_HEARTBEAT_COPY_TOKEN unset for healthchecks.io.
# W1: after this many seconds of failed beats (60..3600, default 300; anything else stops start-up with exit 78)
# the engine pages PAGE[high] "dead-man receiver not acknowledging" (docs/runbooks/deadman-alert.md):
# XTNL_DEADMAN_ALERT_AFTER_S=300

# Broker: read-only credentials on the real accounts. Phase 1 never sends orders.
BROKER_ENV=live_readonly
XTNL_USE_MOCK_BROKER=0
# StoneX downtime catch-up history switches (docs/runbooks/downtime-catchup.md), confirmed by a live read-only
# probe on 2026-11-14. Set 0 to fall back to fail closed (every StoneX catch-up reported INCOMPLETE).
STONE_X_STOP_LIMIT_HISTORY=1
STONE_X_HISTORY_PAGING_CONFIRMED=1

# Alerts: unset here (channels are reported as disabled; pages are logged).

# --- single-PC self-healing (operations.md s4 / s17; src/runtime/single_pc.py) --------------------------------
# 1 = a SAFE_HOLD (anti-flap brake) is resumed by the engine itself once its hard checks pass, after a cool-down of
# 5 min doubling per earlier auto-resume within 24 h (10, 20, 40, capped at 60 min), audited in operator_audit
# (operator system.single-pc-auto-resume); after 6 within 24 h it stays held and pages critical (a restart loop
# needs a human: docs/runbooks/safe-hold.md). Also pages "engine not recording" after 10 min without a leader term.
# start-xtnl.ps1 / run-local.ps1 set 1 when this file does not; 0 here makes SAFE_HOLD operator-only again.
# Timings (defaults; bounds in deploy/env/engine.env.example): XTNL_SINGLE_PC_RESUME_FIRST_S=300,
# XTNL_SINGLE_PC_RESUME_MAX_S=3600, XTNL_SINGLE_PC_RESUME_LIMIT=6, XTNL_SINGLE_PC_RESUME_WINDOW_S=86400,
# XTNL_SINGLE_PC_IDLE_PAGE_S=600.
XTNL_SINGLE_PC=1

# --- uptime + downtime catch-up (migration 0012; src/runtime/uptime.py, src/runtime/catchup.py) -------------
# engine_runs heartbeat (and the leader's adapter_coverage) every N seconds, 60..1800.
XTNL_UPTIME_PING_S=900
# Each start-up / wake-from-sleep catch-up re-reads from the last coverage minus this many seconds (>= ping, >= 300).
XTNL_CATCHUP_OVERLAP_S=900
# First run (no coverage yet): read this many days of broker history back (1..365).
XTNL_CATCHUP_FIRST_RUN_DAYS=7

# --- partition archive (home-server plan W10; operations.md s11; src/db/lifecycle.py) -------------------------
# Runbooks: docs/runbooks/partition-archive.md, docs/runbooks/home-backup-restore.md.
# The leader's lifecycle task (right after it becomes leader, then every 6 h) exports each event_log,
# account_snapshots, events_dlq_history and notification_outbox partition whose month ended more than 90 days ago
# to <XTNL_ARCHIVE_DIR>\<table>\<partition>.jsonl.gz plus a .sha256 sidecar, reads the file back, records it in
# partition_archive, and only then detaches the partition (dropping it stays an operator step). Unset or empty:
# nothing is exported or detached, the partitions stay in PostgreSQL, and an info page "lifecycle: partitions past
# 90 days await export" starts once a month is past 90 days (around 2027-02-12 for a database created 2026-11-14).
# An absolute folder OUTSIDE OneDrive and outside the repository (a relative path would resolve against the
# repository root, the task's working folder). The engine creates the folder and its <table> subfolders itself at
# the first export, but create it beforehand with the rights in home-backup-restore.md: the backup job
# (deploy/local/backup-pg.ps1, W3) mounts it read-only and refuses to run while it is missing.
# The files are PLAIN gzip JSONL of account data: never copy them anywhere as they are. The nightly backup
# age-encrypts each file before it uploads it to the B2 bucket's archive/ prefix. The backup account's own
# settings (XTNL_BACKUP_*) never go in this file: start-xtnl.ps1 refuses an env file that assigns them.
XTNL_ARCHIVE_DIR=C:\xtnl\archive

# --- order-server API (python -m src.api; docs/runbooks/order-server-api.md) ----------------------------------
# Read-only HTTPS API for the XTNL thesis website (single-PC mode): GET /v1/health, POST /v1/pinescript/compile,
# GET /v1/pinescript/latest. HMAC-signed requests only; Phase 1 never sends orders. The only network-facing
# listener: everything else stays on 127.0.0.1.
# XTNL_API_SECRET (the shared HMAC secret, hex / base64 of >= 32 random bytes) is set in the Windows User
# environment by deploy/local/new-api-credentials.ps1, never here (start-xtnl.ps1 refuses an env file that sets it).
XTNL_API_PORT=47443
XTNL_API_BIND=0.0.0.0
XTNL_API_TLS_CERT=var/api-tls/server.crt
XTNL_API_TLS_KEY=var/api-tls/server.key
# The API's OWN Redis (service redis-api of deploy/local/docker-compose.local.yml), never the engine's REDIS_URL,
# and the database of the Pine Script cache in it (pinescript:week:<YYYY-Www>, TTL 8 days).
XTNL_API_REDIS_URL=redis://127.0.0.1:56381/2
XTNL_API_REDIS_DB=2
# XTNL_API_DSN (PostgreSQL as the read-only role xtnl_api, migration 0014) carries a password, so like the secret
# it is set in the Windows User environment only (new-api-credentials.ps1 -DbRole), never here. Least privilege:
# start-xtnl.ps1 starts the API without the broker credentials (STONE_X_*), ORDER_SERVER_DSN or REDIS_URL, and
# the API refuses to start if it sees any of them.
XTNL_API_RATE_PER_MIN=30

# --- live view (python -m src.liveview; docs/runbooks/live-view.md) -----------------------------------------
# Local read-only page, http://127.0.0.1:8090/ and /edge: it never sends orders and has no write path. Needs
# migration 0021 (raise XTNL_MIGRATIONS_ACCEPTED_UPTO below to 21 in your local.env; this example keeps 14) and
# the read-only login of deploy/local/new-liveview-credentials.ps1, whose DSN lives in the Windows User
# environment only, never here.
# Bounds: deploy/env/engine.env.example. start-xtnl.ps1 -NoLiveView keeps it off.
XTNL_LIVEVIEW_ADDR=127.0.0.1:8090
XTNL_LIVEVIEW_POLL_MS=1000
XTNL_LIVEVIEW_HISTORY=2000
XTNL_LIVEVIEW_BACKFILL_H=24
XTNL_LIVEVIEW_MAX_CLIENTS=4
XTNL_LIVEVIEW_ENGINE_METRICS=127.0.0.1:9464

# --- reviewed-change switches (plan S38f; design §0b "What turns each on") ----------------------------------
# A start applies only the schema migrations up to XTNL_MIGRATIONS_ACCEPTED_UPTO (default 14): later ones
# (0015-0020, the market-data / ARM schema) are held back, named in one log line, and the start carries on. Raise
# it only once those migrations are reviewed (20 applies all of them), BEFORE turning on anything below.
XTNL_MIGRATIONS_ACCEPTED_UPTO=14
# XTNL_OVERSEE_STOP_AT_ENTRY=1 turns on the S07 Oversee stop rule (a STOP child counts at any price, also at or
# beyond entry; a LIMIT child never counts; the stop_kind caveats). 0 / unset keeps the exact pre-S07 rule. Set it
# only after confirming design §0 C4; the ARM may run only with it on (go-live gate oversee_c4).
XTNL_OVERSEE_STOP_AT_ENTRY=0

# --- optional market-data layer and ARM (docs/design/automated-risk-manager.md C2 Local flags) ---------------
# Both OFF by default: with 0 no market-data or ARM task runs and start-xtnl.ps1 does not start redis-md (the
# S07 Oversee stop rule, design §0 C4, has its own switch above: XTNL_OVERSEE_STOP_AT_ENTRY).
# Turning them on never affects ingestion or Oversee. Enabling order: run deploy/local/new-md-credentials.ps1, set
# XTNL_MD_ENABLED=1 (the next start-xtnl.ps1 run starts redis-md, compose profile md) and let it soak; the ARM
# (XTNL_ARM_ENABLED=1, needs XTNL_MD_ENABLED=1, both ARM channels and an accepted config) only after that.
# Only 1 is on; unset or 0 is off; any other value (true, yes, on included) counts as 0 and is paged. The engine and
# start-xtnl.ps1 read the process value, so one set in the Windows User environment counts too.
XTNL_MD_ENABLED=0
XTNL_ARM_ENABLED=0
# Go-live gates the user accepts while open (comma-separated ids; `python -m src.ops arm gates`); empty by default.
XTNL_ARM_GOLIVE_ACCEPT=
# PR5 tick-only symbols, adapter:SYMBOL items, comma-separated (empty: none).
XTNL_TICK_SYMBOLS=
# StoneX unfiltered price delivery and the PR9 stop reads: both stay 0 after the PR3 probe (2026-11-17); stop
# reads wait for probe_bars --check-stops (go-live gate pr3_stop_children).
XTNL_STONEX_PRICE_UNFILTERED=0
XTNL_ARM_STOP_READS=0
# Secrets, never here (start-xtnl.ps1 refuses this file if it sets them): XTNL_MD_REDIS_URL,
# XTNL_MD_REDIS_READER_URL, XTNL_MD_HMAC_KEY, XTNL_MD_HMAC_KEY_PREV (deploy/local/new-md-credentials.ps1),
# XTNL_ARM_CONFIG_DSN and the ARM channel credentials (XTNL_ARM_SMTP_USERNAME, XTNL_ARM_SMTP_PASSWORD,
# XTNL_ARM_SES_ACCESS_KEY_ID, XTNL_ARM_SES_SECRET_ACCESS_KEY, XTNL_ARM_SES_SESSION_TOKEN, XTNL_ARM_PUSH_TOKEN,
# XTNL_ARM_PUSH_USER): Windows User environment only. The settings below are not secret; their bounds are
# documented in deploy/env/engine.env.example.
XTNL_MD_HMAC_KEY_ID=1
XTNL_MD_HMAC_KEY_PREV_ID=
XTNL_MD_CROSSCHECK_K=1.0
XTNL_MD_MISMATCH_K=3
XTNL_MD_ROLLBACK_N=8
XTNL_MD_DECISION_SYMBOLS=8
XTNL_MD_BROKER_BAR_SETTLE_S=10
XTNL_MD_BROKER_BAR_LAG_MS=5000
XTNL_ARM_MIN_GAP_R=0.0
XTNL_ARM_PRE_OFFSET_S=40
XTNL_ARM_EDGE=default
XTNL_ARM_FAIL_UNRESOLVED_N=2
XTNL_ARM_FAIL_GLOBAL_SERIES_N=3
XTNL_ARM_FAIL_MD_DOWN_S=900
XTNL_ARM_FAIL_POOL_DOWN_S=900
XTNL_ARM_FAIL_REPING_H=4
# The pinned CA file of the ARM configuration database (required once XTNL_ARM_CONFIG_DSN is set).
XTNL_ARM_CONFIG_CA_FILE=
# ARM channels (both required before the ARM starts): the alert channel settings under XTNL_ARM_, e.g.
# XTNL_ARM_ALERT_EMAIL_TO, XTNL_ARM_SMTP_HOST, XTNL_ARM_SMTP_PORT, XTNL_ARM_SMTP_FROM, XTNL_ARM_PUSH_PROVIDER,
# XTNL_ARM_PUSH_URL (credentials in the Windows User environment, above).
