# XTNL dead-man receiver (Melbourne host): /etc/xtnl/deadman-receiver.env, 0600 root:root (systemd reads it as
# root; the service runs as a dynamic user). Replace every CHANGE_ME from Secrets Manager in ap-southeast-4.
# Never copy the London engine's channel settings: the receiver pages through a channel OUTSIDE eu-west-2.
#
# Home VPS (home-server-plan §3.1, W6; runbook docs/runbooks/deadman-receiver-home.md; unit
# deploy/systemd/xtnl-deadman-receiver.home.service): the same file, 0600 root:root, with these differences:
#   XTNL_RECEIVER_LISTEN=127.0.0.1:8443      plain loopback; `tailscale serve` terminates HTTPS on 443 in front
#   XTNL_RECEIVER_TLS_CERT= / _TLS_KEY=      empty or absent (blank counts as unset; the home unit sets neither)
#   XTNL_RECEIVER_CERTS=                     empty (no Melbourne dashboard certificate on the VPS)
#   XTNL_SECRETS_SOURCE=env                  the tokens are read at start only: a rotation takes restarts
#   paging: Pushover (XTNL_RECEIVER_PUSH_*) plus an SMTP relay (XTNL_RECEIVER_SMTP_*); leave XTNL_RECEIVER_SES_*
#   unset (SES wins over SMTP when its region is set). Both are sent from the VPS, so they work while the house is
#   dark. Avoid public ntfy.sh topics.

# --- service ---------------------------------------------------------------------------------------------
# The VPN address the London engine nodes reach (XTNL_DEADMAN_URL on the engine = https://<host>:8443/xtnl/heartbeat).
XTNL_RECEIVER_LISTEN=10.8.0.5:8443
XTNL_RECEIVER_PATH=/xtnl/heartbeat
# The engine's XTNL_DEADMAN_TOKEN (at least 16 characters). Rotation without restart: keep the tokens in the
# receiver's own Secrets Manager secret (below) and follow docs/runbooks/deadman-alert.md "Token rotation".
XTNL_RECEIVER_TOKEN=CHANGE_ME
# Optional next token, accepted beside the current one (rotation step 1); unset when not rotating.
# XTNL_RECEIVER_TOKEN_NEXT=
# How long a replaced token stays accepted after the receiver sees the rotation (s, 600..86400).
# XTNL_RECEIVER_TOKEN_OVERLAP_S=1800

# --- secrets source (operations.md s13 "rotation without restart") ----------------------------------------
# env (default): the values above, fixed until a restart. aws-sm: one secret (JSON object of these variable
# names, e.g. {"XTNL_RECEIVER_TOKEN": "...", "XTNL_RECEIVER_TOKEN_NEXT": "...", "XTNL_RECEIVER_PUSH_TOKEN": "..."})
# laid over this file, read with the host's instance role (IMDSv2), refreshed every 5 min; the tokens are re-read
# from it every second and the paging channel credentials (XTNL_RECEIVER_SES_* / _SMTP_* / _PUSH_*) every minute
# (K10: a rotated channel credential needs no restart; a secret with no usable channel keeps the current ones and
# pages `channel_source`). Its region must be outside eu-west-2 (refused at start-up, exit 78). A secret that cannot
# be read at start is exit 75 (systemd restarts the receiver).
# XTNL_SECRETS_SOURCE=aws-sm
# XTNL_SECRETS_ID=xtnl/deadman-receiver
# XTNL_SECRETS_REGION=ap-southeast-4
# TLS: set by the unit from LoadCredential= (/etc/xtnl/deadman-receiver/tls.crt, tls.key); only for a manual run.
# The receiver re-loads a changed certificate / key in place (K10), but LoadCredential copies the files at start,
# so under the unit a renewed certificate takes `systemctl restart xtnl-deadman-receiver` (5 s; the engine's beats
# retry, Melbourne pages only after 60 s of silence):
# XTNL_RECEIVER_TLS_CERT=/etc/xtnl/deadman-receiver/tls.crt
# XTNL_RECEIVER_TLS_KEY=/etc/xtnl/deadman-receiver/tls.key
# Daily test page (UTC; 22:00 UTC is 08:00 / 09:00 in Melbourne) and the re-page interval of an active condition.
XTNL_RECEIVER_TEST_PAGE_UTC=22:00
XTNL_RECEIVER_REPAGE_S=900
# W19: two engine sources (node, epoch) whose beats interleave within this window page `two_engines` (critical);
# a change of the beating node pages the `node_changed` notice (high). Seconds, 45..600 (deadman-alert.md).
# The interleave test looks back over at least 90 s whatever this is, and the page is held one window after it
# was last seen, so it pages once per incident.
XTNL_RECEIVER_TWO_ENGINES_WINDOW_S=60
# K5 (operations.md s13): certificates on this Melbourne host the receiver watches (name=path, comma-separated):
# each pages `cert:<name>` from Melbourne when unreadable or within 30 days of expiry. Its own TLS certificate is
# always watched. The dashboard's Redis client certificate is presented only from here, so no London exporter
# can see it (install it 0644, install-node.md "Melbourne dashboard host").
XTNL_RECEIVER_CERTS=dashboard-redis-client=/etc/xtnl/dashboard/redis-client.crt
XTNL_LOG_LEVEL=INFO
XTNL_LOG_FORMAT=json

# --- paging channel (outside eu-west-2; at least one of email / push) -------------------------------------
XTNL_RECEIVER_ALERT_EMAIL_TO=oncall@example.invalid
# Amazon SES in ap-southeast-4 (an SES region of eu-west-2 is refused at start-up).
XTNL_RECEIVER_SES_REGION=ap-southeast-4
XTNL_RECEIVER_SES_FROM=xtnl-deadman@example.invalid
XTNL_RECEIVER_SES_ACCESS_KEY_ID=CHANGE_ME
XTNL_RECEIVER_SES_SECRET_ACCESS_KEY=CHANGE_ME
# XTNL_RECEIVER_SES_SESSION_TOKEN=
# XTNL_RECEIVER_SES_ENDPOINT=
# XTNL_RECEIVER_SES_CONFIGURATION_SET=
# XTNL_RECEIVER_SES_TIMEOUT_S=10
# Or an SMTP relay outside eu-west-2 (used only when XTNL_RECEIVER_SES_REGION is unset):
# XTNL_RECEIVER_SMTP_HOST=smtp.example.invalid
# XTNL_RECEIVER_SMTP_PORT=587
# XTNL_RECEIVER_SMTP_FROM=xtnl-deadman@example.invalid
# XTNL_RECEIVER_SMTP_SECURITY=starttls
# XTNL_RECEIVER_SMTP_USERNAME=
# XTNL_RECEIVER_SMTP_PASSWORD=
# XTNL_RECEIVER_SMTP_TIMEOUT_S=10
# Third-party mobile push (Pushover: critical pages repeat until acknowledged in the app).
XTNL_RECEIVER_PUSH_PROVIDER=pushover
XTNL_RECEIVER_PUSH_TOKEN=CHANGE_ME
XTNL_RECEIVER_PUSH_USER=CHANGE_ME
# XTNL_RECEIVER_PUSH_URL=
# XTNL_RECEIVER_PUSH_TIMEOUT_S=10
