{
 "agent": {
  "run_as_user": "cwagent",
  "omit_hostname": true,
  "metrics_collection_interval": 60
 },
 "metrics": {
  "namespace": "CWAgent",
  "metrics_collected": {
   "disk": {
    "measurement": [
     "used_percent"
    ],
    "resources": [
     "/",
     "/var/lib/etcd"
    ],
    "drop_device": true,
    "ignore_file_system_types": [
     "tmpfs",
     "devtmpfs",
     "overlay",
     "squashfs"
    ],
    "append_dimensions": {
     "host": "witness"
    }
   }
  },
  "aggregation_dimensions": [
   [
    "host",
    "path"
   ]
  ]
 },
 "logs": {
  "logs_collected": {
   "files": {
    "collect_list": [
     {
      "file_path": "/var/log/xtnl/xtnl-etcd-defrag.log",
      "log_group_name": "/xtnl/ops",
      "log_stream_name": "{hostname}/xtnl-etcd-defrag",
      "retention_in_days": 90,
      "timezone": "UTC"
     }
    ]
   }
  },
  "force_flush_interval": 5
 },
 "_comment": "GENERATED by deploy/observability/gen_alerts.py; witness only (no engine, no exporter): disk_used_percent of /, /var/lib/etcd for xtnl-witness-disk-*; logs from /var/log/xtnl"
}
