{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(python3 .claude/skills/live-trading-server/scripts/verify_execution.py*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Write(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/pre_tool_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/post_tool_verify.py"
          }
        ]
      }
    ]
  }
}